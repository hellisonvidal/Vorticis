# Copie este arquivo para .env e preencha (o .env NÃO vai para o Git).

# Domínio do site do Vorticis (download e atualizações). O DNS dele precisa apontar para este servidor.
DOMINIO=www.seudominio.com.br
# E-mail para o certificado HTTPS gratuito (Let's Encrypt) e avisos de vencimento.
EMAIL_CERTIFICADO=ti@seudominio.com.br

# Banco de dados (PostgreSQL) usado pelos computadores do escritório. Nome do servidor que eles vão usar na tela de conexão:
DOMINIO_BANCO=db.seudominio.com.br
POSTGRES_DB=vorticis
POSTGRES_USER=vorticis
# Senha forte (gere com: openssl rand -base64 24). Não use a do exemplo.
POSTGRES_PASSWORD=troque-esta-senha

# Backup diário do banco no servidor: quantos dias guardar.
BACKUP_DIAS=30
