<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vorticis.Escritorio.Desktop.App"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Escritorio.Desktop.Views"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <c:TemplatesComuns />
    <DataTemplate DataType="vm:CarteiraViewModel"><v:CarteiraView /></DataTemplate>
    <DataTemplate DataType="vm:TarefasViewModel"><v:TarefasView /></DataTemplate>
    <DataTemplate DataType="vm:ProtocolosViewModel"><v:ProtocolosView /></DataTemplate>
    <DataTemplate DataType="vm:HonorariosViewModel"><v:HonorariosView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <StyleInclude Source="avares://Vorticis.Desktop.Comum/Estilos.axaml" />
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridCell.numerica">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </Application.Styles>
</Application>
