<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executável do módulo Escritório: usa o casco comum (login, empresas, usuários, backup...) e acrescenta as telas do módulo. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VorticisEscritorio</AssemblyName>
    <Product>Vorticis Escritório</Product>
    <Title>Vorticis Escritório</Title>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Ícone do módulo (gerado por instalador/icone/gerar_icone.py) -->
    <ApplicationIcon>..\..\instalador\icone\VorticisEscritorio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vorticis.Desktop.Comum\Vorticis.Desktop.Comum.csproj" />
    <ProjectReference Include="..\Vorticis.Escritorio\Vorticis.Escritorio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Vorticis.Desktop.Comum" />
    <Using Include="Vorticis.Desktop.Comum.ViewModels" />
    <Using Include="Vorticis.Desktop.Comum.Views" />
  </ItemGroup>
</Project>
