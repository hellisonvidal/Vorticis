<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.LancamentoCobrancaView" x:DataType="vm:LancamentoCobrancaViewModel">
  <!-- Janela Novo honorário / Cobrança avulsa / Alterar cobrança: corpo rolável separado do rodapé fixo (sem sobreposição dos botões) -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
      <StackPanel Spacing="8" Margin="20,14,20,10">
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock.rot"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,3,8,3" /></Style>
          </Grid.Styles>
          <TextBlock Classes="rot" Text="Cliente" />
          <ComboBox Grid.Column="1" Name="ClienteCobranca" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Cliente}" IsEnabled="False"
                    ToolTip.Tip="O cliente escolhido no topo da tela (Cliente:). Para outro cliente, troque no topo."
                    HorizontalAlignment="Stretch" Margin="0,3" />
          <TextBlock Grid.Row="1" Classes="rot" Text="Descrição" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="DescricaoCobranca" Text="{Binding Descricao}" Margin="0,3" MaxLength="200"
                   Watermark="{Binding DicaDescricao}" />
          <TextBlock Grid.Row="2" Classes="rot" Text="Competência (mês/ano)" />
          <TextBox Grid.Row="2" Grid.Column="1" Name="CompetenciaCobranca" c:Mascara.Tipo="Competencia" Text="{Binding CompetenciaTexto}" Watermark="mm/aaaa"
                   Width="110" HorizontalAlignment="Left" Margin="0,3" />
          <TextBlock Grid.Row="3" Classes="rot" Text="Valor" />
          <TextBox Grid.Row="3" Grid.Column="1" Name="ValorCobranca" c:Mascara.Tipo="Valor" Text="{Binding Valor}" Width="140" HorizontalAlignment="Left"
                   Watermark="R$ 0,00" Margin="0,3" />
          <TextBlock Grid.Row="4" Classes="rot" Text="Vencimento" IsVisible="{Binding MostraVencimento}" />
          <TextBox Grid.Row="4" Grid.Column="1" Name="VencimentoCobranca" c:Mascara.Tipo="Data" Text="{Binding VencimentoTexto}" Watermark="dd/mm/aaaa"
                   Width="130" HorizontalAlignment="Left" Margin="0,3" IsVisible="{Binding MostraVencimento}" />
          <TextBlock Grid.Row="5" Classes="rot" Text="Pagamento" IsVisible="{Binding EhNovo}" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3" IsVisible="{Binding EhNovo}">
            <CheckBox Name="AVista" Content="À vista, pago em" IsChecked="{Binding AVista}"
                      ToolTip.Tip="A cobrança entra já recebida; a data do pagamento passa a ser o vencimento." />
            <TextBox Name="DataPagamento" c:Mascara.Tipo="Data" Text="{Binding DataPagamentoTexto}" Watermark="dd/mm/aaaa" Width="130" IsEnabled="{Binding AVista}" />
          </StackPanel>
          <TextBlock Grid.Row="6" Classes="rot" Text="Dia do vencimento" IsVisible="{Binding MostraDia}" />
          <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Dia}" Minimum="1" Maximum="31" FormatString="0" Width="110" HorizontalAlignment="Left" Margin="0,3"
                         IsVisible="{Binding MostraDia}" />
          <TextBlock Grid.Row="7" Classes="rot" Text="Vencimento no" IsVisible="{Binding MostraRegime}" />
          <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,3" IsVisible="{Binding MostraRegime}">
            <CheckBox Name="RegimeCompetencia" Content="Competência (mês seguinte)" IsChecked="{Binding RegimeCompetencia}"
                      ToolTip.Tip="O vencimento fica no mês seguinte ao da competência (ex.: honorário de 03/2027 vence em abril)." />
            <CheckBox Name="RegimeCaixa" Content="Regime de caixa (mesmo mês)" IsChecked="{Binding RegimeCaixa}"
                      ToolTip.Tip="O vencimento fica no próprio mês da competência (ex.: honorário de 03/2027 vence em março)." />
          </StackPanel>
          <TextBlock Grid.Row="8" Classes="rot" Text="Periodicidade" IsVisible="{Binding MostraParcelamento}" />
          <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3" IsVisible="{Binding MostraParcelamento}">
            <ComboBox ItemsSource="{x:Static vm:LancamentoCobrancaViewModel.Frequencias}" SelectedItem="{Binding Frequencia}" Width="140" />
            <TextBlock Text="parcelas" VerticalAlignment="Center" IsVisible="{Binding MostraQuantidade}" />
            <NumericUpDown Value="{Binding Quantidade}" Minimum="1" Maximum="120" FormatString="0" Width="100" IsVisible="{Binding MostraQuantidade}" />
          </StackPanel>
          <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding Resumo}" FontSize="12" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>
        <DataGrid Name="GradePrevia" ItemsSource="{Binding Previa}" IsReadOnly="True" AutoGenerateColumns="False" Height="165">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Parcela" Binding="{ReflectionBinding Parcela}" Width="95" />
            <DataGridTextColumn Header="Competência" Binding="{ReflectionBinding Competencia}" Width="*" />
            <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="*" />
            <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="*" CellStyleClasses="num numerica" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource FundoJanela}" BorderBrush="{DynamicResource Linha}" BorderThickness="0,1,0,0" Padding="20,10">
      <StackPanel Spacing="8">
        <c:MensagensView />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="CancelarLancamento" Content="Cancelar" Command="{Binding FecharFichaCommand}" MinWidth="96" HorizontalContentAlignment="Center" />
          <Button Name="Lancar" Content="{Binding TextoBotao}" Classes="accent" Command="{Binding LancarCommand}" MinWidth="96" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
