<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.ProtocolosView" x:DataType="vm:ProtocolosViewModel">
  <!-- Organização › Protocolos de documentos: a tela mostra os protocolos; Registrar protocolo abre a ficha em janela -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Protocolo de documentos" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button Name="NovoProtocolo" Content="Registrar protocolo" Classes="accent" Command="{Binding NovoCommand}" IsEnabled="{Binding PodeEditar}" />
      <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeEditar}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaProtocolos" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="60" />
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="100" />
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="220" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="150" />
        <DataGridTextColumn Header="Documento" Binding="{ReflectionBinding Documento}" Width="*" />
        <DataGridTextColumn Header="Pessoa" Binding="{ReflectionBinding Pessoa}" Width="180" />
        <DataGridTextColumn Header="Registrado por" Binding="{ReflectionBinding Usuario}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
