<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.TarefasView" x:DataType="vm:TarefasViewModel">
  <!-- Organização › Tarefas e prazos: a tela mostra as tarefas; a ficha da tarefa abre em janela -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Tarefas e prazos" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding FiltroClientes}" SelectedItem="{Binding FiltroCliente}" MinWidth="240" IsEnabled="False" ToolTip.Tip="O cliente escolhido no topo da tela (Cliente:). Para outro cliente, troque no topo." />
      <CheckBox Content="Só as em aberto" IsChecked="{Binding SomenteAbertas}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <Button Name="NovaTarefa" Content="Nova tarefa" Classes="accent" Command="{Binding NovaCommand}" IsEnabled="{Binding PodeEditar}" />
      <Button Name="AbrirTarefa" Content="Abrir" Command="{Binding AbrirCommand}" ToolTip.Tip="Abre a tarefa selecionada (ou dê duplo clique / Enter na lista)" />
      <Button Content="Concluir" Command="{Binding ConcluirCommand}" IsEnabled="{Binding PodeEditar}" />
      <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeEditar}" />
      <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
      <c:MensagensView />
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Os clientes são os do cadastro próprio do escritório. Sem cliente, a tarefa é interna do escritório. Ao concluir uma tarefa que se repete, a próxima é criada sozinha." />
    </StackPanel>
    <DataGrid Name="ListaTarefas" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="100" />
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="220" />
        <DataGridTextColumn Header="Tarefa" Binding="{ReflectionBinding Titulo}" Width="*" />
        <DataGridTextColumn Header="Responsável" Binding="{ReflectionBinding Responsavel}" Width="150" />
        <DataGridTextColumn Header="Prioridade" Binding="{ReflectionBinding Prioridade}" Width="90" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="110" />
        <DataGridTextColumn Header="Repete" Binding="{ReflectionBinding Repete}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
