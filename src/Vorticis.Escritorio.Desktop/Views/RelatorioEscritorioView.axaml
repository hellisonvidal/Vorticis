<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.RelatorioEscritorioView" x:DataType="vm:RelatorioEscritorioViewModel">
  <!-- Relatórios › Honorários (relatório de contratos e relatório de honorários) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="{Binding Titulo}" VerticalAlignment="Center" />
      <TextBlock Text="Competências de" VerticalAlignment="Center" Name="RotuloPeriodo" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" Width="120" Name="Inicio" />
      <TextBlock Text="a" VerticalAlignment="Center" Name="RotuloA" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" Width="120" Name="Fim" />
      <CheckBox Content="Só os ativos" IsChecked="{Binding SomenteAtivos}" Name="Ativos" />
      <Button Content="Gerar" Command="{ReflectionBinding GerarCommand}" Classes="accent" />
      <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
      <c:BarraExportacaoView />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" Margin="0,6,0,0" />
    <DataGrid Name="Grade" ItemsSource="{Binding Linhas}" IsReadOnly="True" AutoGenerateColumns="False" />
  </DockPanel>
</UserControl>
