<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Escritorio.Desktop.Views"
             x:Class="Vorticis.Escritorio.Desktop.Views.HonorariosView" x:DataType="vm:HonorariosViewModel">
  <!-- Financeiro › Honorários: lista das cobranças (honorários e avulsas) por competência; Novo honorário, Cobrança avulsa e Baixar abrem janelas -->
  <DockPanel Margin="8">
    <v:LancamentoCobrancaHost DataContext="{Binding Lancamento}" DockPanel.Dock="Top" />
    <v:BaixaCobrancaHost DataContext="{Binding Baixa}" DockPanel.Dock="Top" />
    <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Honorários" Margin="0,0,0,6" />
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="0" LineSpacing="6" Margin="0,0,0,6">
      <TextBlock Text="Competência de" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox Name="CompetenciaDe" c:Mascara.Tipo="Competencia" Text="{Binding CompetenciaDeTexto}" Watermark="mm/aaaa" Width="100" Margin="0,0,6,0" />
      <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox Name="CompetenciaAte" c:Mascara.Tipo="Competencia" Text="{Binding CompetenciaAteTexto}" Watermark="mm/aaaa" Width="100" Margin="0,0,14,0" />
      <TextBlock Text="Situação" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{x:Static vm:HonorariosViewModel.Situacoes}" SelectedItem="{Binding Situacao}" Width="130" Margin="0,0,14,0" />
      <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{x:Static vm:HonorariosViewModel.Tipos}" SelectedItem="{Binding Tipo}" Width="130" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding ClienteDoFiltro}" FontSize="12" Foreground="{DynamicResource TxSutil}" Margin="0,0,0,6" />
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,8" IsEnabled="{Binding PodeEditar}">
      <Button Name="NovoHonorario" Content="Novo honorário" Classes="accent" Command="{Binding NovoHonorarioCommand}"
              ToolTip.Tip="Lança o honorário de um cliente: competência, valor, dia do vencimento e as parcelas seguintes (mensal, trimestral, anual...)." />
      <Button Name="CobrancaAvulsa" Content="Cobrança avulsa" Command="{Binding CobrancaAvulsaCommand}"
              ToolTip.Tip="Cobra um serviço extra (abertura de empresa, IRPF, consultoria...), em uma ou mais parcelas." />
      <Button Name="AlterarCobranca" Content="Alterar" Command="{Binding AlterarCommand}" IsEnabled="{Binding TemSelecionada}"
              ToolTip.Tip="Altera a competência, o vencimento, o valor e a descrição da cobrança selecionada (só as em aberto)." />
      <Button Content="Gerar do contrato" Command="{Binding GerarDoContratoCommand}"
              ToolTip.Tip="Gera, na competência 'de', a cobrança do honorário informado na aba Contrato de cada cliente (mensal; anual no mês do início)." />
      <Button Name="BaixarCobranca" Content="Baixar" Command="{Binding BaixarCommand}" IsEnabled="{Binding TemSelecionada}"
              ToolTip.Tip="Registra o recebimento da cobrança selecionada (data, valor e observação)." />
      <Button Content="Estornar baixa" Command="{Binding EstornarCommand}" IsEnabled="{Binding TemSelecionada}" />
      <Button Content="Cancelar cobrança" Command="{Binding CancelarCommand}" IsEnabled="{Binding TemSelecionada}" />
      <Button Name="ExcluirCobrancas" Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding TemSelecionada}"
              ToolTip.Tip="Exclui as cobranças marcadas na lista (Ctrl ou Shift + clique marcam várias), depois de confirmar." />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
      <TextBlock Text="{Binding Totais}" FontSize="12" />
      <c:MensagensView />
    </StackPanel>
    <DataGrid Name="ListaCobrancas" ItemsSource="{Binding Cobrancas}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False"
              SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="*" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="90" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Parcela" Binding="{ReflectionBinding Parcela}" Width="85" />
        <DataGridTextColumn Header="Competência" Binding="{ReflectionBinding Competencia}" Width="115" />
        <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="115" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="110" />
        <DataGridTextColumn Header="Baixa" Binding="{ReflectionBinding Recebido}" Width="200" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
