<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.HonorariosView" x:DataType="vm:HonorariosViewModel">
  <DockPanel Margin="8">
    <Border DockPanel.Dock="Top" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" IsEnabled="{Binding PodeEditar}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="titulo" Text="Honorário do cliente" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding Cliente}" MinWidth="280" />
        </StackPanel>
        <TextBlock Text="{Binding SituacaoContrato}" FontSize="12" />
        <WrapPanel>
          <TextBlock Text="Valor mensal" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Text="{Binding Valor}" Width="120" Margin="0,0,12,0" />
          <TextBlock Text="Dia do vencimento" VerticalAlignment="Center" Margin="0,0,6,0" />
          <NumericUpDown Value="{Binding Dia}" Minimum="1" Maximum="31" FormatString="0" Width="110" Margin="0,0,12,0" />
          <TextBlock Text="Início" VerticalAlignment="Center" Margin="0,0,6,0" />
          <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" Margin="0,0,12,0" />
          <TextBlock Text="Fim" VerticalAlignment="Center" Margin="0,0,6,0" />
          <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" Margin="0,0,12,0" />
          <TextBlock Text="Reajuste" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{x:Static vm:HonorariosViewModel.Indices}" SelectedItem="{Binding Indice}" Width="110" Margin="0,0,12,0" />
          <Button Content="Gravar honorário" Classes="accent" Command="{Binding GravarContratoCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Classes="titulo" Text="Cobranças" VerticalAlignment="Center" />
      <TextBlock Text="Competência" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Competencia}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" Width="120" />
      <CheckBox Content="Todas em aberto" IsChecked="{Binding SomenteAbertas}" />
      <Button Content="Gerar cobranças do mês" Command="{Binding GerarCommand}" IsEnabled="{Binding PodeEditar}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding PodeEditar}">
        <TextBlock Text="Recebido em" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding DataRecebimento}" Width="130" />
        <TextBlock Text="Valor" VerticalAlignment="Center" />
        <TextBox Text="{Binding ValorRecebido}" Width="110" />
        <Button Content="Receber" Classes="accent" Command="{Binding ReceberCommand}" />
        <Button Content="Reabrir" Command="{Binding ReabrirCommand}" />
        <Button Content="Cancelar cobrança" Command="{Binding CancelarCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Totais}" FontSize="12" />
      <c:MensagensView />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Cobrancas}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Cliente" Binding="{ReflectionBinding Cliente}" Width="*" />
        <DataGridTextColumn Header="Competência" Binding="{ReflectionBinding Competencia}" Width="100" />
        <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="100" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="100" />
        <DataGridTextColumn Header="Recebimento" Binding="{ReflectionBinding Recebido}" Width="190" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
