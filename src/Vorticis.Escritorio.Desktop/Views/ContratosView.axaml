<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.ContratosView" x:DataType="vm:ContratosViewModel">
  <!-- Relatórios › Gerador de contratos: a tela mostra os contratos; Novo contrato, Abrir ficha ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Gerador de contratos" VerticalAlignment="Center" />
      <Button Content="Novo contrato" Command="{Binding NovoCommand}" IsEnabled="{Binding PodeEditar}" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do contrato selecionado (ou dê duplo clique / Enter na lista)" />
      <Button Content="Exportar PDF" Command="{Binding PdfCommand}" />
      <CheckBox Content="Assinar digitalmente" IsChecked="{Binding AssinarDigitalmente}"
                ToolTip.Tip="Assina o PDF com o certificado digital padrão do contador (Configurações › Certificados digitais)." />
      <Button Content="Exportar Word" Command="{Binding WordCommand}" />
      <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeEditar}" />
    </WrapPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaContratos" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="55" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="90" />
        <DataGridTextColumn Header="Cliente / fornecedor" Binding="{ReflectionBinding Parte}" Width="*" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Periodicidade" Binding="{ReflectionBinding Periodicidade}" Width="100" />
        <DataGridTextColumn Header="Vigência" Binding="{ReflectionBinding Vigencia}" Width="170" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="85" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
