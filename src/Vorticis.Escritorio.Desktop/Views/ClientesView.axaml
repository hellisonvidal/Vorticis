<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Escritorio.Desktop.ViewModels"
             x:Class="Vorticis.Escritorio.Desktop.Views.ClientesView" x:DataType="vm:ClientesEscritorioViewModel">
  <!-- Cadastros › Clientes: a tela mostra os clientes cadastrados; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="{Binding Titulo}" VerticalAlignment="Center" />
      <TextBox Text="{Binding Filtro}" Watermark="Filtrar por código, nome ou documento" Width="280" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do cliente selecionado (ou dê duplo clique / Enter na lista)" />
      <TextBlock Text="{Binding Lista.Count, StringFormat='{}{0} cliente(s)'}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TxSutil}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaClientes" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="70" />
        <DataGridTextColumn Header="Razão social / nome" Binding="{ReflectionBinding Nome}" Width="2*" />
        <DataGridTextColumn Header="Nome fantasia" Binding="{ReflectionBinding Fantasia}" Width="*" />
        <DataGridTextColumn Header="CNPJ/CPF" Binding="{ReflectionBinding Documento}" Width="150" />
        <DataGridTextColumn Header="Regime" Binding="{ReflectionBinding Regime}" Width="130" />
        <DataGridTextColumn Header="Município/UF" Binding="{ReflectionBinding Cidade}" Width="150" />
        <DataGridTextColumn Header="Contato" Binding="{ReflectionBinding Contato}" Width="*" />
        <DataGridTextColumn Header="Módulos" Binding="{ReflectionBinding Modulos}" Width="*" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
