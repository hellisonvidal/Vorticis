<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Vorticis.Licencas.Desktop"
        x:Class="Vorticis.Licencas.Desktop.JanelaPrincipal" x:DataType="l:GerenciadorViewModel"
        Title="Vorticis — Gerenciador de licenças" Width="980" Height="640" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="#14305A" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
      <StackPanel Spacing="4">
        <TextBlock Text="Gerenciador de licenças" FontSize="20" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="{Binding SituacaoChave}" Foreground="#E3E8F2" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Content="Importar chave privada..." Click="AoImportarChave" />
          <Button Content="Criar novo par de chaves" Command="{Binding CriarChavesCommand}" />
          <Button Content="Exportar chave pública..." Click="AoExportarPublica" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="#1F3A5F" Margin="0,8,0,0" />
    <Grid ColumnDefinitions="360,16,*">
      <StackPanel Spacing="8">
        <TextBlock Text="Nova licença" FontWeight="SemiBold" FontSize="15" />
        <TextBlock Text="Cliente" />
        <TextBox Text="{Binding Cliente}" />
        <TextBlock Text="CNPJ/CPF" />
        <TextBox Text="{Binding Documento}" />
        <TextBlock Text="Módulos liberados" />
        <ItemsControl ItemsSource="{Binding Modulos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="l:ModuloOpcao">
              <CheckBox Content="{Binding Nome}" IsChecked="{Binding Marcado}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Válida até" />
        <CalendarDatePicker SelectedDate="{Binding ValidaAte}" Width="160" />
        <TextBlock Text="Número de usuários" />
        <NumericUpDown Value="{Binding Usuarios}" Minimum="1" Maximum="999" FormatString="0" Width="160" HorizontalAlignment="Left" />
        <Button Content="Emitir licença" Command="{Binding EmitirCommand}" IsEnabled="{Binding TemChave}" Background="#1B7F5A" Foreground="White" Margin="0,6,0,0" />
      </StackPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Licenças emitidas" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Emitidas}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="l:LicencaEmitida">
              <StackPanel>
                <TextBlock FontWeight="SemiBold"><Run Text="{Binding Cliente}" /><Run Text="  ·  " /><Run Text="{Binding Id}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="Módulos: " /><Run Text="{Binding Modulos}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="Emitida em " /><Run Text="{Binding Emissao}" /><Run Text=" · válida até " /><Run Text="{Binding Validade}" />
                  <Run Text=" · usuários: " /><Run Text="{Binding Usuarios}" /></TextBlock>
                <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Arquivo}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
