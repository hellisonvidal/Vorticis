<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gerenciador de licenças: programa do FORNECEDOR (não vai no instalador do cliente). Emite os arquivos licenca.vlic,
       assinados com a chave privada, que liberam os módulos da suíte no computador do cliente. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VorticisLicencas</AssemblyName>
    <Product>Vorticis Gerenciador de Licenças</Product>
    <Title>Vorticis Gerenciador de Licenças</Title>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\instalador\icone\VorticisInstalador.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vorticis.Domain\Vorticis.Domain.csproj" />
  </ItemGroup>
</Project>
