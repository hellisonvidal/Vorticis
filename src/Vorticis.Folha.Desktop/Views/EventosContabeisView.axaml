<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             x:Class="Vorticis.Folha.Desktop.Views.EventosContabeisView"
             x:DataType="vm:EventosContabeisViewModel">
  <!-- A tela mostra os eventos contábeis; Novo, Abrir ficha ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Eventos contábeis" VerticalAlignment="Center" />
      <Button Content="Novo" Command="{Binding NovoCommand}" IsEnabled="{Binding PodeEditar}" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do evento selecionado (ou dê duplo clique / Enter na lista)" />
      <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeEditar}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Disponiveis}" FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" Margin="0,6,0,0" />
    <DataGrid Name="ListaEventos" ItemsSource="{Binding Eventos}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="110" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="220" />
        <DataGridTextColumn Header="Rubricas que somam" Binding="{ReflectionBinding Rubricas}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
