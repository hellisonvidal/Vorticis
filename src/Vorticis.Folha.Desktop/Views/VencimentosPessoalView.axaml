<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Folha.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Folha.Desktop.Views"
             x:Class="Vorticis.Folha.Desktop.Views.VencimentosPessoalView"
             x:DataType="vm:VencimentosPessoalViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Classes="titulo" Text="Vencimentos de contratos e férias" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="Próximos" VerticalAlignment="Center" Margin="0,0,6,0" />
        <NumericUpDown Value="{Binding Dias}" Minimum="0" Maximum="730" Increment="15" FormatString="0" Width="110" Margin="0,0,6,0" />
        <TextBlock Text="dias" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button Content="Mostrar" Command="{Binding GerarCommand}" Classes="accent" Margin="0,0,10,0" />
        <c:BarraExportacaoView />
      </WrapPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Contratos de experiência e a termo perto do fim e férias cujo gozo precisa começar para terminar dentro do período concessivo (depois disso, pagamento em dobro). Os vencidos aparecem em destaque." />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <v:TabelaRelatorioGrid Tabela="{Binding Tabela}" />
  </DockPanel>
</UserControl>
