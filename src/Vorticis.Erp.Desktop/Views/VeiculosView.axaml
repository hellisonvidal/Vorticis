<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Erp.Desktop.ViewModels"
             x:Class="Vorticis.Erp.Desktop.Views.VeiculosView" x:DataType="vm:VeiculosViewModel">
  <!-- Veículos à esquerda e motoristas à direita; as fichas abrem numa janela por cima -->
  <Grid ColumnDefinitions="*,16,*" Margin="8">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Veículos" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Button Content="Novo veículo" Command="{Binding NovoVeiculoCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Name="AbrirFichaVeiculo" Content="Abrir ficha" Command="{Binding AbrirVeiculoCommand}" ToolTip.Tip="Mostra a ficha do veículo selecionado (ou dê duplo clique na lista)" />
      </StackPanel>
      <DataGrid Name="ListaVeiculos" ItemsSource="{Binding Veiculos}" SelectedItem="{Binding VeiculoSelecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Placa" Binding="{ReflectionBinding Placa}" Width="90" />
          <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="*" />
          <DataGridTextColumn Header="UF" Binding="{ReflectionBinding Uf}" Width="50" />
          <DataGridTextColumn Header="Capacidade (kg)" Binding="{ReflectionBinding CapacidadeKg}" Width="120" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Motoristas" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Button Content="Novo motorista" Command="{Binding NovoMotoristaCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Name="AbrirFichaMotorista" Content="Abrir ficha" Command="{Binding AbrirMotoristaCommand}" ToolTip.Tip="Mostra a ficha do motorista selecionado (ou dê duplo clique na lista)" />
      </StackPanel>
      <c:MensagensView DockPanel.Dock="Bottom" />
      <DataGrid Name="ListaMotoristas" ItemsSource="{Binding Motoristas}" SelectedItem="{Binding MotoristaSelecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nome" Binding="{ReflectionBinding Nome}" Width="*" />
          <DataGridTextColumn Header="CPF" Binding="{ReflectionBinding Cpf}" Width="120" />
          <DataGridTextColumn Header="CNH" Binding="{ReflectionBinding Cnh}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
