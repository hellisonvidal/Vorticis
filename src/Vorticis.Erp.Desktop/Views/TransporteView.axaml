<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Erp.Desktop.ViewModels"
             x:Class="Vorticis.Erp.Desktop.Views.TransporteView" x:DataType="vm:TransporteViewModel">
  <!-- A tela mostra a lista; a ficha abre numa janela por cima (botões Nova/Novo, Abrir ficha, duplo clique ou Enter) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <TextBlock Classes="titulo" Text="Conhecimentos (CT-e) e manifestos (MDF-e)" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="130" />
        <TextBlock Text="a" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Fim}" Width="130" />
      </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Novo" Command="{Binding NovoCommand}" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaTransporte" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="70" />
        <DataGridTextColumn Header="Nº/série" Binding="{ReflectionBinding Numero}" Width="80" />
        <DataGridTextColumn Header="Emissão" Binding="{ReflectionBinding Emissao}" Width="95" />
        <DataGridTextColumn Header="Percurso" Binding="{ReflectionBinding Percurso}" Width="80" />
        <DataGridTextColumn Header="Remetente → destinatário / motorista" Binding="{ReflectionBinding Partes}" Width="*" />
        <DataGridTextColumn Header="Veículo" Binding="{ReflectionBinding Veiculo}" Width="85" />
        <DataGridTextColumn Header="Frete" Binding="{ReflectionBinding Frete}" Width="100" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
