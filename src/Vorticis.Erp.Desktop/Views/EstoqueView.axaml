<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Erp.Desktop.ViewModels"
             x:Class="Vorticis.Erp.Desktop.Views.EstoqueView" x:DataType="vm:EstoqueViewModel">
  <!-- A tela mostra a posição do estoque; Abrir ficha ou duplo clique abrem a ficha do produto (preço, mínimo e ajuste) em janela -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <TextBlock Classes="titulo" Text="Estoque: posição e movimentos" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Totais}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="AbrirFicha" Content="Preço, mínimo e ajuste" Command="{Binding AbrirFichaCommand}" IsEnabled="{Binding PodeEditar}" ToolTip.Tip="Abre a ficha do produto selecionado (ou dê duplo clique / Enter na lista)" />
      </StackPanel>
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid DockPanel.Dock="Bottom" Height="200" ItemsSource="{Binding Movimentos}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="100" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="90" />
        <DataGridTextColumn Header="Quantidade" Binding="{ReflectionBinding Quantidade}" Width="110" />
        <DataGridTextColumn Header="Custo" Binding="{ReflectionBinding Custo}" Width="110" />
        <DataGridTextColumn Header="Origem" Binding="{ReflectionBinding Origem}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock DockPanel.Dock="Bottom" Text="Movimentos do produto selecionado" FontWeight="SemiBold" Margin="0,8,0,4" />
    <DataGrid Name="ListaEstoque" ItemsSource="{Binding Posicao}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="70" />
        <DataGridTextColumn Header="Produto" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Un." Binding="{ReflectionBinding Unidade}" Width="50" />
        <DataGridTextColumn Header="Saldo" Binding="{ReflectionBinding Saldo}" Width="90" />
        <DataGridTextColumn Header="Mínimo" Binding="{ReflectionBinding Minimo}" Width="80" />
        <DataGridTextColumn Header="Custo médio" Binding="{ReflectionBinding CustoMedio}" Width="110" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Preço de venda" Binding="{ReflectionBinding Preco}" Width="110" />
        <DataGridTextColumn Header="" Binding="{ReflectionBinding Alerta}" Width="70" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
