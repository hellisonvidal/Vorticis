<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.ConexaoView"
             x:DataType="vm:ConexaoViewModel">
  <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left" Margin="8">
    <TextBlock Classes="titulo" Text="Conexão com o banco de dados (PostgreSQL)" />
    <TextBlock Classes="erro" Text="{Binding Falha, StringFormat='Falha ao conectar: {0}'}"
               IsVisible="{Binding Falha, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border BorderBrush="#C8D3E6" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding BancoLocalDisponivel}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Banco de dados local do Perseus (recomendado)" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding DescricaoBancoLocal}" />
        <TextBlock FontSize="12" Foreground="#1B6E3A" Text="Em uso neste momento." IsVisible="{Binding UsandoBancoLocal}" />
        <Button Content="Usar o banco local" Command="{Binding UsarBancoLocalCommand}" Classes="accent"
                IsVisible="{Binding !UsandoBancoLocal}" />
      </StackPanel>
    </Border>
    <TextBlock FontWeight="SemiBold" Text="Servidor PostgreSQL" />
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="Servidor" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Servidor}" />
      <TextBlock Grid.Row="1" Text="Porta" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Porta}" Minimum="1" Maximum="65535" FormatString="0" Width="140" HorizontalAlignment="Left" />
      <TextBlock Grid.Row="2" Text="Banco de dados" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Banco}" />
      <TextBlock Grid.Row="3" Text="Usuário" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Usuario}" />
      <TextBlock Grid.Row="4" Text="Senha" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Senha}" PasswordChar="●" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Testar conexão" Command="{Binding TestarCommand}" />
      <Button Content="Salvar e conectar ao servidor" Command="{Binding SalvarEConectarCommand}" />
    </StackPanel>
    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
               Text="{Binding Arquivo, StringFormat='A configuração é gravada em {0}. No Windows, a senha fica cifrada (DPAPI) e só pode ser lida pelo seu usuário do Windows. Salvar encerra a sessão atual.'}" />
    <v:MensagensView />
  </StackPanel>
</UserControl>
