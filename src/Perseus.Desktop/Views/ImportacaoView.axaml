<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             xmlns:app="using:Perseus.Application.Contabil"
             x:Class="Perseus.Desktop.Views.ImportacaoView"
             x:DataType="vm:ImportacaoViewModel">
  <UserControl.Styles>
    <Style Selector="TabControl#AbasImportacao > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.secao">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1F3A5F" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="TextBlock.dica">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="Gray" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <TabControl Name="AbasImportacao" SelectedIndex="{Binding AbaSelecionada}" Padding="0">

    <!-- ============================== Planilhas (layouts do usuário) -->
    <TabItem Header="Planilhas">
      <Grid DataContext="{Binding Planilhas}" x:DataType="vm:ImportacaoPlanilhaViewModel" ColumnDefinitions="460,16,*" Margin="8">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,0,12,0">
            <TextBlock Classes="dica" FontSize="12" Foreground="#44506A"
                       Text="Importe lançamentos de qualquer planilha (Excel .xlsx ou CSV). Crie um layout dizendo qual coluna é a data, as contas, o valor e o histórico; salve-o para usar de novo nas próximas importações." />
            <TextBlock Classes="secao" Text="1. Planilha" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding Arquivo}" Watermark="Arquivo .xlsx ou .csv" />
              <Button Grid.Column="1" Content="Procurar..." Click="ProcurarPlanilha" />
            </Grid>
            <TextBlock Classes="dica" Text="{Binding Amostra}" />

            <TextBlock Classes="secao" Text="2. Layout" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding LayoutSelecionado}" PlaceholderText="Layouts salvos" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="app:LayoutSalvo"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="Novo" Command="{Binding NovoLayoutCommand}" />
              <Button Grid.Column="2" Content="Excluir" Command="{Binding ExcluirLayoutCommand}" />
            </Grid>
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Classes="rotulo" Text="Nome do layout" />
              <TextBox Grid.Column="1" Text="{Binding NomeLayout}" Watermark="ex.: Vendas do PDV" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Cada linha é" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <RadioButton GroupName="modelo" Content="um lançamento (débito e crédito)" IsChecked="{Binding PorLancamento}" />
                <RadioButton GroupName="modelo" Content="uma partida (conta e D/C)" IsChecked="{Binding PorPartida}" />
              </StackPanel>
            </Grid>

            <TextBlock Classes="secao" Text="3. Colunas da planilha" />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="rotulo" Text="Data" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaData}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Histórico" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaHistorico}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Classes="rotulo" Text="Documento" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaDocumento}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="rotulo" Text="Centro de custo" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaCentroCusto}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="4" Classes="rotulo" Text="Valor" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaValor}" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsVisible="{Binding PorLancamento}">
              <TextBlock Classes="rotulo" Text="Conta débito" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaContaDebito}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="ou débito fixo" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ContaDebitoPadrao}" Watermark="conta usada quando a coluna está vazia" />
              <TextBlock Grid.Row="2" Classes="rotulo" Text="Conta crédito" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaContaCredito}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="rotulo" Text="ou crédito fixo" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ContaCreditoPadrao}" Watermark="conta usada quando a coluna está vazia" />
            </Grid>
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsVisible="{Binding PorPartida}">
              <TextBlock Classes="rotulo" Text="Nº do lançamento" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaAgrupador}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Conta" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaConta}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Classes="rotulo" Text="D/C" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaDC}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="rotulo" Text="Valor a débito" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaValorDebito}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="4" Classes="rotulo" Text="Valor a crédito" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding OpcoesColunas}" SelectedItem="{Binding ColunaValorCredito}" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Classes="dica" IsVisible="{Binding PorPartida}"
                       Text="Sem a coluna Nº do lançamento, as partidas são agrupadas até débitos = créditos. Use D/C + Valor, ou as colunas Valor a débito e Valor a crédito." />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Classes="rotulo" Text="Histórico fixo" />
              <TextBox Grid.Column="1" Text="{Binding HistoricoPadrao}" Watermark="usado quando a coluna está vazia" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Máscara das contas" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MascaraContas}" Watermark="opcional, ex.: 9.9.99.999 (converte 11010001)" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Salvar layout" Command="{Binding SalvarLayoutCommand}" />
              <Button Content="Pré-visualizar" Command="{Binding PreVisualizarCommand}" />
              <Button Content="Importar" Command="{Binding ImportarCommand}" Classes="accent" />
            </StackPanel>
            <v:MensagensView />
          </StackPanel>
        </ScrollViewer>
        <v:PreviaImportacaoView Grid.Column="2" />
      </Grid>
    </TabItem>

    <!-- ============================== Extratos (OFX) -->
    <TabItem Header="Extratos bancários">
      <DockPanel DataContext="{Binding Extratos}" x:DataType="vm:ImportacaoExtratoViewModel" Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Classes="dica" FontSize="12" Foreground="#44506A"
                     Text="Importe o extrato OFX do internet banking. Cada movimento vira um lançamento: entradas debitam a conta do banco e creditam a contrapartida; saídas, o contrário. Movimentos já importados não são duplicados." />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Text="Arquivo OFX" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Arquivo}" Watermark="extrato.ofx" />
            <Button Grid.Column="2" Content="Procurar..." Click="ProcurarOfx" />
            <Button Grid.Column="3" Content="Ler" Command="{Binding LerExtratoCommand}" />
          </Grid>
          <TextBlock Text="{Binding DadosExtrato}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <WrapPanel>
            <TextBlock Text="Conta do banco" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox Text="{Binding ContaBanco}" Watermark="ex.: 1.1.01.002" Width="140" Margin="0,0,14,6" />
            <TextBlock Text="Contrapartida das entradas" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox Text="{Binding ContrapartidaEntradas}" Watermark="ex.: 1.1.02.001" Width="140" Margin="0,0,14,6" />
            <TextBlock Text="das saídas" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox Text="{Binding ContrapartidaSaidas}" Watermark="ex.: 2.1.01.001" Width="140" Margin="0,0,8,6" />
            <Button Content="Preencher vazias" Command="{Binding AplicarContrapartidasCommand}" Margin="0,0,14,6" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Histórico" VerticalAlignment="Center" Margin="0,0,6,6" />
              <TextBox Text="{Binding PrefixoHistorico}" Watermark="prefixo, ex.: Extrato Itaú:" Width="200" Margin="0,0,6,6" />
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Pré-visualizar" Command="{Binding PreVisualizarCommand}" />
            <Button Content="Importar" Command="{Binding ImportarCommand}" Classes="accent" />
          </StackPanel>
          <v:MensagensView />
        </StackPanel>
        <Grid RowDefinitions="*,8,*" Margin="0,8,0,0">
          <DataGrid ItemsSource="{Binding Transacoes}" AutoGenerateColumns="False" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{ReflectionBinding Importar}" Width="44" />
              <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="112" IsReadOnly="True" />
              <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="Doc" Binding="{ReflectionBinding Documento}" Width="90" IsReadOnly="True" />
              <DataGridTextColumn Header="Entrada" Binding="{ReflectionBinding Entrada}" Width="110" IsReadOnly="True" />
              <DataGridTextColumn Header="Saída" Binding="{ReflectionBinding Saida}" Width="110" IsReadOnly="True" />
              <DataGridTextColumn Header="Contrapartida" Binding="{ReflectionBinding Contrapartida}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>
          <v:PreviaImportacaoView Grid.Row="2" />
        </Grid>
      </DockPanel>
    </TabItem>

    <!-- ============================== Lançamentos contábeis (layout padrão) -->
    <TabItem Header="Lançamentos contábeis">
      <DockPanel DataContext="{Binding LancamentosPadrao}" x:DataType="vm:ImportacaoLancamentosPadraoViewModel" Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6" MaxWidth="1000" HorizontalAlignment="Left">
          <TextBlock Classes="dica" FontSize="12" Foreground="#44506A"
                     Text="Importe lançamentos já prontos (de outro sistema ou digitados numa planilha) no layout padrão do Perseus: uma linha por partida, agrupadas pelo número do lançamento. Aceita Excel (.xlsx) ou CSV separado por ponto e vírgula." />
          <TextBlock FontFamily="Consolas, Menlo, monospace" FontSize="12" Text="{x:Static vm:ImportacaoLancamentosPadraoViewModel.Colunas}" />
          <TextBlock Classes="dica" Text="LANCAMENTO: número que agrupa as partidas · DATA: dd/mm/aaaa · CONTA: código analítico · DC: D ou C · VALOR: 1.500,00 · CENTRO_CUSTO e DOCUMENTO são opcionais." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Gerar planilha modelo (.xlsx)" Command="{Binding GerarModeloCommand}" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="Arquivo" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Arquivo}" Watermark="Arquivo .xlsx ou .csv" />
            <Button Grid.Column="2" Content="Procurar..." Click="ProcurarPadrao" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Pré-visualizar" Command="{Binding PreVisualizarCommand}" />
            <Button Content="Importar" Command="{Binding ImportarCommand}" Classes="accent" />
          </StackPanel>
          <v:MensagensView />
        </StackPanel>
        <v:PreviaImportacaoView Margin="0,8,0,0" />
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
