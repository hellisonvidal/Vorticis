<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.PlanoContasView"
             x:DataType="vm:PlanoContasViewModel">
  <Grid ColumnDefinitions="*,16,360" RowDefinitions="Auto,*" Margin="8">
    <v:BarraCadastroView Grid.ColumnSpan="3" Margin="0,0,0,8" />
    <DockPanel Grid.Row="1" IsEnabled="{Binding !EmEdicao}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <TextBlock Classes="titulo" Text="Plano de contas" VerticalAlignment="Center" />
        <TextBox Text="{Binding Filtro}" Watermark="Filtrar por código ou descrição" Width="300" />
        <Button Content="Importar de planilha / máscara..." Command="{Binding ImportarPlanilhaCommand}" IsVisible="{Binding PodeEditar}" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False"
                FontFamily="Consolas, Menlo, monospace">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="70" />
          <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="170" />
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="95" />
          <DataGridTextColumn Header="Natureza" Binding="{ReflectionBinding Natureza}" Width="140" />
          <DataGridTextColumn Header="Saldo" Binding="{ReflectionBinding Saldo}" Width="130" />
          <DataGridTextColumn Header="" Binding="{ReflectionBinding Situacao}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="6">
        <TextBlock Text="Seu perfil permite apenas consultar o plano." Classes="erro" IsVisible="{Binding !PodeEditar}" />
        <TextBlock Text="Conta" FontWeight="SemiBold" Foreground="#1F3A5F" />
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="rotulo" Text="Código" />
          <TextBox Grid.Column="1" Text="{Binding Codigo}" Watermark="ex.: 1.1.01.004" IsEnabled="{Binding EmInclusao}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DicaPai}" FontSize="11" Foreground="#44506A" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Descrição" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Descricao}" IsEnabled="{Binding EmEdicao}" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Natureza" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:OpcaoNatureza.Todas}" SelectedItem="{Binding Natureza}"
                    HorizontalAlignment="Stretch" IsEnabled="{Binding EmInclusao}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoNatureza"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Saldo" />
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:OpcaoSaldo.Todas}" SelectedItem="{Binding Saldo}"
                    HorizontalAlignment="Stretch" IsEnabled="{Binding EmEdicao}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoSaldo"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Incluída em" IsVisible="{Binding EmInclusao}" />
          <CalendarDatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding DataInclusao}" Width="160" HorizontalAlignment="Left"
                              IsVisible="{Binding EmInclusao}" />
        </Grid>
        <StackPanel Spacing="4" IsEnabled="{Binding EmEdicao}">
          <CheckBox Content="Exige centro de custo" IsChecked="{Binding ExigeCc}" />
          <CheckBox Content="Exige participante" IsChecked="{Binding ExigeParticipante}" />
          <CheckBox Content="Ativa" IsChecked="{Binding Ativa}" IsEnabled="{Binding EmAlteracao}" />
        </StackPanel>
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Código e tipo não se alteram (exigência da ECD). Conta com lançamentos não é excluída: inative-a depois de zerar o saldo." />
        <v:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
