<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.PlanoContasView"
             x:DataType="vm:PlanoContasViewModel">
  <Grid ColumnDefinitions="*,16,360" Margin="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <TextBlock Classes="titulo" Text="Plano de contas" VerticalAlignment="Center" />
        <TextBox Text="{Binding Filtro}" Watermark="Filtrar por código ou descrição" Width="300" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False"
                FontFamily="Consolas, Menlo, monospace">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="170" />
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="95" />
          <DataGridTextColumn Header="Natureza" Binding="{ReflectionBinding Natureza}" Width="140" />
          <DataGridTextColumn Header="Saldo" Binding="{ReflectionBinding Saldo}" Width="130" />
          <DataGridTextColumn Header="" Binding="{ReflectionBinding Situacao}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
        <TextBlock Text="Seu perfil permite apenas consultar o plano." Classes="erro" IsVisible="{Binding !PodeEditar}" />

        <TextBlock Text="Nova conta" FontWeight="SemiBold" Foreground="#1F3A5F" />
        <TextBox Text="{Binding NovoCodigo}" Watermark="Código (ex.: 1.1.01.004)" />
        <TextBlock Text="{Binding DicaPai}" FontSize="11" Foreground="#44506A" TextWrapping="Wrap" />
        <TextBox Text="{Binding NovaDescricao}" Watermark="Descrição" />
        <Grid ColumnDefinitions="*,8,*">
          <ComboBox ItemsSource="{x:Static vm:OpcaoNatureza.Todas}" SelectedItem="{Binding NovaNatureza}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoNatureza"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:OpcaoSaldo.Todas}" SelectedItem="{Binding NovoSaldo}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoSaldo"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Incluída em" VerticalAlignment="Center" FontSize="12" />
          <CalendarDatePicker SelectedDate="{Binding NovaDataInclusao}" Width="140" />
        </StackPanel>
        <CheckBox Content="Exige centro de custo" IsChecked="{Binding NovaExigeCc}" />
        <Button Content="Incluir conta" Command="{Binding IncluirCommand}" Classes="accent" />

        <Border BorderBrush="#D0D5DD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" IsVisible="{Binding TemSelecionada}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Selecionada.Conta.Codigo, StringFormat='Conta selecionada: {0}'}" FontWeight="SemiBold" Foreground="#1F3A5F" />
            <TextBox Text="{Binding DescricaoEdicao}" />
            <ComboBox ItemsSource="{x:Static vm:OpcaoSaldo.Todas}" SelectedItem="{Binding SaldoEdicao}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoSaldo"><TextBlock Text="{Binding Nome, StringFormat='Natureza do saldo: {0}'}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Exige centro de custo" IsChecked="{Binding ExigeCcEdicao}" />
            <CheckBox Content="Exige participante" IsChecked="{Binding ExigeParticipanteEdicao}" />
            <CheckBox Content="Ativa" IsChecked="{Binding AtivaEdicao}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Salvar alterações" Command="{Binding SalvarCommand}" Classes="accent" />
              <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="Código e tipo não se alteram (exigência da ECD). Conta com lançamentos não é excluída: inative-a depois de zerar o saldo." />
          </StackPanel>
        </Border>
        <v:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
