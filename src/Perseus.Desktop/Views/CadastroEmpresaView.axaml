<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             xmlns:cad="using:Perseus.Application.Cadastros"
             xmlns:seg="using:Perseus.Application.Seguranca"
             x:Class="Perseus.Desktop.Views.CadastroEmpresaView"
             x:DataType="vm:CadastroEmpresaViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secao">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1F3A5F" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <Style Selector="TabControl#AbasEmpresa > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.empresa-aba">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#44506A" />
      <Setter Property="Margin" Value="8,6,8,0" />
    </Style>
  </UserControl.Styles>
  <TabControl Name="AbasEmpresa" SelectedIndex="{Binding AbaSelecionada}" Padding="0">
    <TabItem Header="Dados cadastrais">
  <Grid ColumnDefinitions="*,16,300" RowDefinitions="Auto,*" Margin="8,4,8,0">
    <v:BarraCadastroView Grid.ColumnSpan="3" Margin="0,0,0,8" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="6" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,12,8">
        <TextBlock Classes="titulo" Text="{Binding TituloFormulario}" />

        <TextBlock Classes="secao" Text="Identificação" />
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="rotulo" Text="CNPJ" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Cnpj}" Watermark="00.000.000/0000-00 (aceita alfanumérico)" IsEnabled="{Binding EmInclusao}" />
            <Button Grid.Column="1" Content="Buscar dados na Receita" Command="{Binding ConsultarCnpjCommand}" IsEnabled="{Binding EmInclusao}"
                    MinWidth="190" HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Razão social" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RazaoSocial}" IsEnabled="{Binding EmEdicao}" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Nome fantasia" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NomeFantasia}" IsEnabled="{Binding EmEdicao}" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Natureza jurídica / CNAE" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,8,*">
            <TextBox Text="{Binding NaturezaJuridica}" Watermark="Natureza jurídica (CONCLA, ex.: 2062)" IsEnabled="{Binding EmEdicao}" />
            <TextBox Grid.Column="2" Text="{Binding Cnae}" Watermark="CNAE principal (7 dígitos)" IsEnabled="{Binding EmEdicao}" />
          </Grid>
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Inscrição estadual" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding InscricaoEstadual}" Watermark="Somente números, ou ISENTO" IsEnabled="{Binding EmEdicao}" />
            <Button Grid.Column="1" Content="Buscar IE (SINTEGRA)" Command="{Binding BuscarInscricaoEstadualCommand}"
                    MinWidth="190" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Consulta a inscrição estadual do CNPJ na UF da empresa (UF ou código IBGE) e pergunta se deve salvar." />
            <Button Grid.Column="2" Content="Abrir SINTEGRA" Command="{Binding AbrirSintegraCommand}"
                    ToolTip.Tip="Abre o portal do SINTEGRA para conferir no site do estado." />
          </Grid>
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Início das atividades" />
          <CalendarDatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding InicioAtividades}" IsEnabled="{Binding EmEdicao}" Width="180"
                              HorizontalAlignment="Left" />
          <StackPanel Grid.Row="6" Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding OrigemDados}" FontSize="11" Foreground="#1B6E3A" TextWrapping="Wrap"
                       IsVisible="{Binding OrigemDados, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Aviso}" Classes="erro" FontWeight="SemiBold"
                       IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="secao" Text="Endereço e contato" />
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="CEP" />
          <TextBox Grid.Column="1" Text="{Binding Cep}" Width="180" HorizontalAlignment="Left" Watermark="8 dígitos" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Logradouro / número" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,8,110">
            <TextBox Text="{Binding Logradouro}" Watermark="Logradouro" />
            <TextBox Grid.Column="2" Text="{Binding Numero}" Watermark="Nº" />
          </Grid>
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Complemento / bairro" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,*">
            <TextBox Text="{Binding Complemento}" Watermark="Complemento" />
            <TextBox Grid.Column="2" Text="{Binding Bairro}" Watermark="Bairro" />
          </Grid>
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Município / UF / IBGE" />
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,8,70,8,110">
            <TextBox Text="{Binding Municipio}" Watermark="Município" />
            <TextBox Grid.Column="2" Text="{Binding Uf}" MaxLength="2" Watermark="UF" />
            <TextBox Grid.Column="4" Text="{Binding MunicipioIbge}" Watermark="Cód. IBGE" />
          </Grid>
          <TextBlock Grid.Row="4" Classes="rotulo" Text="E-mail / telefone" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,8,*">
            <TextBox Text="{Binding Email}" Watermark="E-mail" />
            <TextBox Grid.Column="2" Text="{Binding Telefone}" Watermark="Telefone" />
          </Grid>
        </Grid>

        <TextBlock Classes="secao" Text="Escrituração" />
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="rotulo" Text="Regime tributário" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CadastroEmpresaViewModel.Regimes}" SelectedItem="{Binding Regime}" Width="260"
                    IsEnabled="{Binding EmInclusao}" ToolTip.Tip="O regime tem histórico por ano; é definido na inclusão.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="cad:RegimeTributario">
                <TextBlock Text="{Binding Converter={x:Static v:Conversores.NomeRegime}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Primeiro exercício" IsVisible="{Binding EmInclusao}" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding AnoExercicio}" Minimum="2000" Maximum="2100" FormatString="0" Width="180"
                         HorizontalAlignment="Left" IsVisible="{Binding EmInclusao}" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="Criar com o plano de contas modelo" IsChecked="{Binding ImportarPlanoModelo}"
                    IsVisible="{Binding EmInclusao}" />
        </Grid>
        <v:MensagensView Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Grid.Column="2" IsEnabled="{Binding !EmEdicao}">
      <TextBlock DockPanel.Dock="Top" Text="Empresas cadastradas" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding Main.EmpresasPermitidas}" SelectedItem="{Binding Main.EmpresaSelecionada}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="seg:EmpresaPermitida">
            <StackPanel>
              <TextBlock Text="{Binding RazaoSocial}" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Cnpj}" FontSize="11" Foreground="Gray" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
    </TabItem>
    <TabItem Header="Sócios" IsEnabled="{Binding TemEmpresaSelecionada}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="empresa-aba" Text="{Binding EmpresaSelecionadaRotulo}" />
        <ContentControl Content="{Binding Main.Socios}" />
      </DockPanel>
    </TabItem>
    <TabItem Header="Contadores" IsEnabled="{Binding TemEmpresaSelecionada}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="empresa-aba" Text="{Binding EmpresaSelecionadaRotulo}" />
        <ContentControl Content="{Binding Main.Contabilidade}" />
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>