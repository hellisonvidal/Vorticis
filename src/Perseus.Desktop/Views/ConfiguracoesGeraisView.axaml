<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.ConfiguracoesGeraisView"
             x:DataType="vm:ConfiguracoesGeraisViewModel">
  <StackPanel Margin="12" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
    <TextBlock Classes="titulo" Text="Configurações gerais" />
    <TextBlock Text="Somente o administrador altera estas configurações." Classes="erro" IsVisible="{Binding !PodeAlterar}" />
    <StackPanel Spacing="8" IsEnabled="{Binding PodeAlterar}">
      <TextBlock Text="Tipo de contabilização (tela de lançamento)" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <RadioButton GroupName="modo" IsChecked="{Binding PartidaDobrada}">
        <StackPanel>
          <TextBlock Text="Partida dobrada — uma linha por lançamento" FontWeight="SemiBold" />
          <TextBlock Text="Data · conta débito · conta crédito · valor · histórico na mesma linha. Ideal para digitar muitos lançamentos simples em sequência."
                     FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <RadioButton GroupName="modo" IsChecked="{Binding PartidaSimples}">
        <StackPanel>
          <TextBlock Text="Partida simples — uma linha por conta (no mínimo 2 linhas)" FontWeight="SemiBold" />
          <TextBlock Text="Cada linha tem uma conta com D ou C; o lançamento é salvo quando débitos = créditos. Permite lançamentos com várias contas (rateios, folha, impostos)."
                     FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <Button Content="Salvar" Command="{Binding SalvarCommand}" Classes="accent" Margin="0,6,0,0" />
    </StackPanel>

    <Border BorderBrush="#E0A3A0" BorderThickness="1" Background="#FDF3F2" CornerRadius="4" Padding="12" Margin="0,16,0,0"
            IsVisible="{Binding PodeAlterar}">
      <StackPanel Spacing="8">
        <TextBlock Text="Limpar banco de dados (NÃO RECOMENDADO)" FontWeight="SemiBold" Foreground="#B3261E" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5A2A27"
                   Text="Apaga definitivamente TODAS as empresas e a escrituração (lançamentos, planos, períodos, imobilizado, clientes, fornecedores), contadores, escritórios, tabelas do plano referencial e layouts. Ficam só os usuários, os perfis e as configurações. Use apenas para recomeçar do zero — um backup é gerado antes." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Digite LIMPAR para confirmar:" VerticalAlignment="Center" />
          <TextBox Text="{Binding ConfirmacaoLimpeza}" Width="120" />
          <Button Content="Limpar banco de dados" Command="{Binding LimparBancoCommand}" Background="#B3261E" Foreground="White" />
        </StackPanel>
      </StackPanel>
    </Border>
    <v:MensagensView />
  </StackPanel>
</UserControl>
