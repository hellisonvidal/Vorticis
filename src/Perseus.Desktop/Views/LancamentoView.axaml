<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.LancamentoView"
             x:DataType="vm:LancamentoViewModel">
  <UserControl.Styles>
    <Style Selector="Border.linha">
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.linha:focus-within">
      <Setter Property="Background" Value="#E8F0FB" />
    </Style>
    <!-- Linhas com aparência de planilha: campos sem moldura, separados por uma linha fina -->
    <Style Selector="Border.linha TextBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.linha TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#3A6EA5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.linha TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F5F8FC" />
    </Style>
    <Style Selector="Border.linha AutoCompleteBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.valor">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.cab">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#5A6478" />
      <Setter Property="Margin" Value="6,0,0,2" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,Auto,*,Auto,Auto,*" Margin="8">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
      <TextBlock Classes="titulo" Text="Lançamento contábil" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PartidaSimples}">
        <TextBlock Text="Data:" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Data}" SelectedDateFormat="Short" Width="140" />
      </StackPanel>
      <TextBlock Text="{Binding DescricaoModo}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" IsVisible="{Binding !EmEdicao}" />
      <Border Background="#FFF4CE" BorderBrush="#E0B000" BorderThickness="1" CornerRadius="3" Padding="8,2" IsVisible="{Binding EmEdicao}">
        <TextBlock Text="{Binding TextoEdicao}" FontSize="11" Foreground="#5A4500" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <!-- Cabeçalhos (mesmas larguras das linhas) -->
    <Grid Grid.Row="1" ColumnDefinitions="92,58,165,58,165,105,90,46,*,80" IsVisible="{Binding PartidaDobrada}">
      <TextBlock Classes="cab" Text="Data" />
      <TextBlock Classes="cab" Grid.Column="1" Text="Red. D" />
      <TextBlock Classes="cab" Grid.Column="2" Text="Conta débito" />
      <TextBlock Classes="cab" Grid.Column="3" Text="Red. C" />
      <TextBlock Classes="cab" Grid.Column="4" Text="Conta crédito" />
      <TextBlock Classes="cab" Grid.Column="5" Text="Valor" HorizontalAlignment="Right" Margin="0,0,8,2" />
      <TextBlock Classes="cab" Grid.Column="6" Text="Documento" />
      <TextBlock Classes="cab" Grid.Column="7" Text="Hist." />
      <TextBlock Classes="cab" Grid.Column="8" Text="Histórico" />
      <TextBlock Classes="cab" Grid.Column="9" Text="C. custo" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="58,190,46,115,90,46,*,80" IsVisible="{Binding PartidaSimples}">
      <TextBlock Classes="cab" Text="Reduz." />
      <TextBlock Classes="cab" Grid.Column="1" Text="Conta" />
      <TextBlock Classes="cab" Grid.Column="2" Text="D/C" />
      <TextBlock Classes="cab" Grid.Column="3" Text="Valor" HorizontalAlignment="Right" Margin="0,0,8,2" />
      <TextBlock Classes="cab" Grid.Column="4" Text="Documento" />
      <TextBlock Classes="cab" Grid.Column="5" Text="Hist." />
      <TextBlock Classes="cab" Grid.Column="6" Text="Histórico" />
      <TextBlock Classes="cab" Grid.Column="7" Text="C. custo" />
    </Grid>

    <ScrollViewer Grid.Row="2" Name="Rolagem">
      <Panel>
        <!-- Partida dobrada: uma linha = um lançamento -->
        <ItemsControl Name="LinhasDobrada" ItemsSource="{Binding Linhas}" IsVisible="{Binding PartidaDobrada}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinhaLancamentoViewModel">
              <Border Classes="linha">
                <Grid ColumnDefinitions="92,58,165,58,165,105,90,46,*,80">
                  <TextBox Tag="data" Text="{Binding Data}" />
                  <TextBox Grid.Column="1" Tag="reduzido" Text="{Binding Reduzido}" />
                  <AutoCompleteBox Grid.Column="2" Tag="conta" Text="{Binding Conta}" ToolTip.Tip="{Binding NomeConta}"
                                   ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                   FilterMode="Custom" ItemFilter="{x:Static v:LancamentoView.FiltroConta}"
                                   ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                  <TextBox Grid.Column="3" Tag="reduzidocredito" Text="{Binding ReduzidoCredito}" />
                  <AutoCompleteBox Grid.Column="4" Tag="contacredito" Text="{Binding ContaCredito}" ToolTip.Tip="{Binding NomeContaCredito}"
                                   ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                   FilterMode="Custom" ItemFilter="{x:Static v:LancamentoView.FiltroConta}"
                                   ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                  <TextBox Grid.Column="5" Tag="valor" Classes="valor" Text="{Binding Valor}" />
                  <TextBox Grid.Column="6" Tag="documento" Text="{Binding Documento}" />
                  <TextBox Grid.Column="7" Tag="codhistorico" Text="{Binding CodigoHistorico}" />
                  <TextBox Grid.Column="8" Tag="historico" Text="{Binding Historico}" />
                  <TextBox Grid.Column="9" Tag="centrocusto" Text="{Binding CentroCusto}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Partida simples: uma linha = uma partida -->
        <ItemsControl Name="LinhasSimples" ItemsSource="{Binding Linhas}" IsVisible="{Binding PartidaSimples}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinhaLancamentoViewModel">
              <Border Classes="linha">
                <Grid ColumnDefinitions="58,190,46,115,90,46,*,80">
                  <TextBox Tag="reduzido" Text="{Binding Reduzido}" />
                  <AutoCompleteBox Grid.Column="1" Tag="conta" Text="{Binding Conta}" ToolTip.Tip="{Binding NomeConta}"
                                   ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                   FilterMode="Custom" ItemFilter="{x:Static v:LancamentoView.FiltroConta}"
                                   ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                  <TextBox Grid.Column="2" Tag="dc" Text="{Binding Dc}" MaxLength="1" HorizontalContentAlignment="Center" />
                  <TextBox Grid.Column="3" Tag="valor" Classes="valor" Text="{Binding Valor}" />
                  <TextBox Grid.Column="4" Tag="documento" Text="{Binding Documento}" />
                  <TextBox Grid.Column="5" Tag="codhistorico" Text="{Binding CodigoHistorico}" />
                  <TextBox Grid.Column="6" Tag="historico" Text="{Binding Historico}" />
                  <TextBox Grid.Column="7" Tag="centrocusto" Text="{Binding CentroCusto}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock FontSize="12" Foreground="#1F3A5F" TextTrimming="CharacterEllipsis" Text="{Binding LinhaSelecionada.ResumoContas}" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Enter/Tab: próximo campo · ↓ na última linha: nova linha · ↑ numa linha nova sem dados: cancela · Ctrl+Delete: exclui a linha · Ctrl+Enter: salvar" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalDebito, StringFormat='Débitos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCredito, StringFormat='Créditos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Diferenca, StringFormat='Diferença: {0}'}" FontWeight="SemiBold" VerticalAlignment="Center"
                   IsVisible="{Binding PartidaSimples}"
                   Foreground="{Binding Balanceado, Converter={x:Static v:Conversores.OkOuErro}}" />
        <Button Content="Limpar" Command="{Binding LimparCommand}" />
        <Button Content="Salvar (Ctrl+Enter)" Command="{Binding SalvarCommand}" HotKey="Ctrl+Enter" Classes="accent" />
      </StackPanel>
    </Grid>

    <v:MensagensView Grid.Row="4" />

    <!-- Lançamentos efetuados (os estornados permanecem, marcados) e o estorno do selecionado -->
    <DockPanel Grid.Row="5" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
        <TextBlock Text="Lançamentos efetuados" FontWeight="SemiBold" Foreground="#1F3A5F" VerticalAlignment="Center" />
        <TextBlock Text="(duplo clique para alterar)" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding ListaInicio}" Width="128" />
        <TextBlock Text="a" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding ListaFim}" Width="128" />
        <Button Content="Atualizar" Command="{Binding CarregarEfetuadosCommand}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding PodeEstornar}">
        <TextBlock Text="Estornar o selecionado em" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding DataEstorno}" Width="128" />
        <TextBox Text="{Binding MotivoEstorno}" Watermark="Motivo do estorno (obrigatório)" Width="300" />
        <Button Content="Estornar" Command="{Binding EstornarCommand}" />
      </StackPanel>
      <DataGrid x:Name="ListaEfetuados" ItemsSource="{Binding Efetuados}" SelectedItem="{Binding EfetuadoSelecionado}" IsReadOnly="True"
                AutoGenerateColumns="False" DoubleTapped="AoDuploCliqueEfetuado">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="58" />
          <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="100" />
          <DataGridTextColumn Header="Débito" Binding="{ReflectionBinding Debito}" Width="*" />
          <DataGridTextColumn Header="Crédito" Binding="{ReflectionBinding Credito}" Width="*" />
          <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="100" />
          <DataGridTextColumn Header="Documento" Binding="{ReflectionBinding Documento}" Width="90" />
          <DataGridTextColumn Header="Histórico" Binding="{ReflectionBinding Historico}" Width="*" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <DockPanel Grid.Column="1" Grid.RowSpan="6" Margin="12,0,0,0">
      <TextBlock DockPanel.Dock="Top" Text="Contas analíticas" FontWeight="SemiBold" />
      <TextBox DockPanel.Dock="Top" Text="{Binding FiltroConta}" Watermark="Filtrar: reduzido, código ou nome" Margin="0,4" />
      <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Clique numa conta para preenchê-la na linha atual." />
      <ListBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionada}" Focusable="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ContaSelecionavel">
            <TextBlock Text="{Binding Rotulo}" FontSize="11.5" FontFamily="Consolas, Menlo, monospace" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
