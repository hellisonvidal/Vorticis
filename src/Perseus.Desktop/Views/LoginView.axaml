<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid Background="#F4F6FA">
    <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
            CornerRadius="8" BorderBrush="#D0D5DD" BorderThickness="1" Padding="32,28" BoxShadow="0 4 18 0 #1A1F3A5F">
      <StackPanel Spacing="10">
        <TextBlock Text="Perseus" FontSize="28" FontWeight="Bold" Foreground="#1F3A5F" HorizontalAlignment="Center" />
        <TextBlock Text="Escrituração Fiscal Contábil" FontSize="13" Foreground="#5B6478" HorizontalAlignment="Center" Margin="0,0,0,10" />

        <!-- Entrar -->
        <StackPanel Spacing="8" IsVisible="{Binding EmEntrar}">
          <TextBlock Text="Usuário" FontSize="12" />
          <TextBox Text="{Binding Usuario}" Name="CampoUsuario" />
          <TextBlock Text="Senha" FontSize="12" />
          <TextBox Text="{Binding Senha}" PasswordChar="●" />
          <Button Content="Entrar" Command="{Binding EntrarCommand}" IsDefault="True" Classes="accent"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Primeiro acesso -->
        <StackPanel Spacing="8" IsVisible="{Binding EmPrimeiroAcesso}">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#44506A"
                     Text="Primeiro acesso: crie o usuário administrador. Ele cadastra empresas e outros usuários." />
          <TextBlock Text="Nome completo" FontSize="12" />
          <TextBox Text="{Binding Nome}" />
          <TextBlock Text="Login" FontSize="12" />
          <TextBox Text="{Binding Usuario}" />
          <TextBlock Text="Senha (mín. 8 caracteres, letras e números)" FontSize="12" />
          <TextBox Text="{Binding Senha}" PasswordChar="●" />
          <TextBlock Text="Confirme a senha" FontSize="12" />
          <TextBox Text="{Binding Confirmacao}" PasswordChar="●" />
          <Button Content="Criar administrador e entrar" Command="{Binding CriarAdministradorCommand}" IsDefault="True"
                  Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Troca obrigatória -->
        <StackPanel Spacing="8" IsVisible="{Binding EmTrocaObrigatoria}">
          <TextBlock Text="Nova senha" FontSize="12" />
          <TextBox Text="{Binding Senha}" PasswordChar="●" />
          <TextBlock Text="Confirme a nova senha" FontSize="12" />
          <TextBox Text="{Binding Confirmacao}" PasswordChar="●" />
          <Button Content="Salvar senha e entrar" Command="{Binding TrocarSenhaCommand}" IsDefault="True"
                  Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <v:MensagensView />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
