<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             x:Class="Perseus.Desktop.Views.SobreView"
             x:DataType="vm:SobreViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left" Margin="8">
      <TextBlock Text="Perseus" FontSize="24" FontWeight="Bold" Foreground="#1F3A5F" />
      <TextBlock Text="{Binding Source={x:Static vm:SobreViewModel.Versao}, StringFormat='Escrituração Fiscal Contábil — versão {0}'}" />
      <TextBlock Text="{Binding Usuario, StringFormat='Usuário: {0}'}" />
      <TextBlock Text="{Binding Conexao, StringFormat='Banco de dados: {0}'}" />

      <TextBlock Classes="titulo" Text="Atalhos de teclado" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
        <TextBlock Text="Ctrl+L" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Lançamento contábil" />
        <TextBlock Grid.Row="1" Text="Ctrl+B" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Balancete de verificação" />
        <TextBlock Grid.Row="2" Text="Ctrl+N" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Nova linha no lançamento" />
        <TextBlock Grid.Row="3" Text="Ctrl+Enter" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Efetivar lançamento" />
        <TextBlock Grid.Row="4" Text="F1" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="Esta tela" />
      </Grid>

      <TextBlock Classes="titulo" Text="Perfis de acesso" Margin="0,12,0,0" />
      <TextBlock TextWrapping="Wrap" Text="Administrador: tudo, inclusive empresas, usuários e conexão. Contador: lança, estorna e fecha períodos nas empresas liberadas. Assistente: lança e estorna, não fecha períodos. Consulta: somente relatórios." />

      <TextBlock Classes="titulo" Text="Consulta de CNPJ" Margin="0,12,0,0" />
      <TextBlock TextWrapping="Wrap" Text="Os dados cadastrais vêm da base pública do CNPJ divulgada pela Receita Federal (dados abertos, atualização mensal), por meio da BrasilAPI e, como reserva, do serviço Minha Receita. Empresas abertas há poucas semanas podem ainda não constar. Sempre revise os dados antes de cadastrar." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
