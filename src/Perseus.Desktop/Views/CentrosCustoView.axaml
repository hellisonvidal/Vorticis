<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.CentrosCustoView"
             x:DataType="vm:CentrosCustoViewModel">
  <Grid ColumnDefinitions="*,16,340" Margin="8">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Centros de custo" Margin="0,0,0,8" />
      <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="150" />
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="Superior" Binding="{ReflectionBinding Superior}" Width="120" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel Grid.Column="2" Spacing="6" IsEnabled="{Binding PodeEditar}">
      <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" />
      <TextBlock Text="Novo centro de custo" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <TextBox Text="{Binding NovoCodigo}" Watermark="Código (ex.: ADM.TI)" />
      <TextBox Text="{Binding NovaDescricao}" Watermark="Descrição" />
      <TextBox Text="{Binding NovoPai}" Watermark="Código do centro superior (opcional)" />
      <Button Content="Incluir" Command="{Binding IncluirCommand}" Classes="accent" />
      <Border BorderBrush="#D0D5DD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" IsVisible="{Binding TemSelecionado}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Selecionado.Codigo, StringFormat='Selecionado: {0}'}" FontWeight="SemiBold" Foreground="#1F3A5F" />
          <TextBox Text="{Binding DescricaoEdicao}" />
          <CheckBox Content="Ativo" IsChecked="{Binding AtivoEdicao}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Salvar alterações" Command="{Binding SalvarCommand}" Classes="accent" />
            <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <v:MensagensView />
    </StackPanel>
  </Grid>
</UserControl>
