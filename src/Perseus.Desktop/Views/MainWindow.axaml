<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Perseus.Desktop.ViewModels"
        xmlns:v="using:Perseus.Desktop.Views"
        xmlns:seg="using:Perseus.Application.Seguranca"
        x:Class="Perseus.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Perseus Contábil"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><v:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ConexaoViewModel"><v:ConexaoView /></DataTemplate>
    <DataTemplate DataType="vm:CadastroEmpresaViewModel"><v:CadastroEmpresaView /></DataTemplate>
    <DataTemplate DataType="vm:LancamentoViewModel"><v:LancamentoView /></DataTemplate>
    <DataTemplate DataType="vm:BalanceteViewModel"><v:BalanceteView /></DataTemplate>
    <DataTemplate DataType="vm:RazaoViewModel"><v:RazaoView /></DataTemplate>
    <DataTemplate DataType="vm:DiarioViewModel"><v:DiarioView /></DataTemplate>
    <DataTemplate DataType="vm:PeriodosViewModel"><v:PeriodosView /></DataTemplate>
    <DataTemplate DataType="vm:UsuariosViewModel"><v:UsuariosView /></DataTemplate>
    <DataTemplate DataType="vm:AlterarSenhaViewModel"><v:AlterarSenhaView /></DataTemplate>
    <DataTemplate DataType="vm:SobreViewModel"><v:SobreView /></DataTemplate>
    <DataTemplate DataType="vm:PerfisViewModel"><v:PerfisView /></DataTemplate>
    <DataTemplate DataType="vm:PlanoContasViewModel"><v:PlanoContasView /></DataTemplate>
    <DataTemplate DataType="vm:CentrosCustoViewModel"><v:CentrosCustoView /></DataTemplate>
    <DataTemplate DataType="vm:SaldosIniciaisViewModel"><v:SaldosIniciaisView /></DataTemplate>
    <DataTemplate DataType="vm:BackupViewModel"><v:BackupView /></DataTemplate>
    <DataTemplate DataType="vm:EncerramentoViewModel"><v:EncerramentoView /></DataTemplate>
    <DataTemplate DataType="vm:DemonstracoesViewModel"><v:DemonstracoesView /></DataTemplate>
    <DataTemplate DataType="vm:LivrosPdfViewModel"><v:LivrosPdfView /></DataTemplate>
    <DataTemplate DataType="vm:ImportacaoReferencialViewModel"><v:ImportacaoReferencialView /></DataTemplate>
    <DataTemplate DataType="vm:MapeamentoReferencialViewModel"><v:MapeamentoReferencialView /></DataTemplate>
    <DataTemplate DataType="vm:ContabilidadeEmpresaViewModel"><v:ContabilidadeEmpresaView /></DataTemplate>
    <DataTemplate DataType="vm:SociosViewModel"><v:SociosView /></DataTemplate>
    <DataTemplate DataType="vm:InicioViewModel"><v:InicioView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Menu#MenuPrincipal > MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Menu#MenuPrincipal MenuItem MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- O nome do programa fica só na barra de título da janela. Menus à esquerda; empresa ativa e usuário à direita -->
    <Border DockPanel.Dock="Top" Background="#2B4C76" Padding="4,0,8,0" IsVisible="{Binding Logado}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <Menu Name="MenuPrincipal">
        <MenuItem Header="_Cadastros">
          <MenuItem Header="Empresas" Command="{Binding AbrirCommand}" CommandParameter="empresas" />
          <MenuItem Header="Contadores" Command="{Binding AbrirCommand}" CommandParameter="contabilidade" />
          <Separator />
          <MenuItem Header="Plano de contas" Command="{Binding AbrirCommand}" CommandParameter="planocontas" />
          <MenuItem Header="Centros de custo" Command="{Binding AbrirCommand}" CommandParameter="centroscusto" />
          <MenuItem Header="Vínculo ao plano referencial (RFB)" Command="{Binding AbrirCommand}" CommandParameter="mapeamentoreferencial" />
        </MenuItem>
        <MenuItem Header="_Lançamentos">
          <MenuItem Header="Lançamento contábil" Command="{Binding AbrirCommand}" CommandParameter="lancamento" InputGesture="Ctrl+L" />
          <MenuItem Header="Estornar lançamento" Command="{Binding AbrirCommand}" CommandParameter="estorno" />
          <MenuItem Header="Saldos iniciais (implantação)" Command="{Binding AbrirCommand}" CommandParameter="saldosiniciais" />
          <Separator />
          <MenuItem Header="Fechamento de períodos" Command="{Binding AbrirCommand}" CommandParameter="periodos" />
          <MenuItem Header="Encerramento do exercício" Command="{Binding AbrirCommand}" CommandParameter="encerramento" />
        </MenuItem>
        <MenuItem Header="_Integrações">
          <MenuItem Header="Importar XML de NF-e / NFC-e / CT-e (em breve)" IsEnabled="False" />
          <MenuItem Header="Importar NFS-e (em breve)" IsEnabled="False" />
          <MenuItem Header="Importar extrato bancário OFX (em breve)" IsEnabled="False" />
          <MenuItem Header="Importar planilha Excel (em breve)" IsEnabled="False" />
          <Separator />
          <MenuItem Header="SPED Contábil — ECD (em breve)" IsEnabled="False" />
          <MenuItem Header="SPED ECF (em breve)" IsEnabled="False" />
          <MenuItem Header="eSocial (em breve)" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Relatórios">
          <MenuItem Header="Balancete de verificação" Command="{Binding AbrirCommand}" CommandParameter="balancete" InputGesture="Ctrl+B" />
          <MenuItem Header="Livro Razão" Command="{Binding AbrirCommand}" CommandParameter="razao" />
          <MenuItem Header="Livro Diário" Command="{Binding AbrirCommand}" CommandParameter="diario" />
          <Separator />
          <MenuItem Header="Balanço Patrimonial e DRE" Command="{Binding AbrirCommand}" CommandParameter="demonstracoes" />
          <MenuItem Header="Livros e relatórios em PDF" Command="{Binding AbrirCommand}" CommandParameter="livrospdf" />
        </MenuItem>
        <MenuItem Header="C_onfigurações">
          <MenuItem Header="Usuários" Command="{Binding AbrirCommand}" CommandParameter="usuarios" />
          <MenuItem Header="Perfis de acesso" Command="{Binding AbrirCommand}" CommandParameter="perfis" />
          <MenuItem Header="Alterar minha senha" Command="{Binding AbrirCommand}" CommandParameter="senha" />
          <MenuItem Header="Conexão com o banco de dados" Command="{Binding AbrirCommand}" CommandParameter="conexao" />
          <MenuItem Header="Backup e restauração" Command="{Binding AbrirCommand}" CommandParameter="backup" />
          <MenuItem Header="Plano referencial da RFB (importar tabela)" Command="{Binding AbrirCommand}" CommandParameter="importacaoreferencial" />
          <Separator />
          <MenuItem Header="Sair (trocar de usuário)" Command="{Binding SairCommand}" />
        </MenuItem>
        <MenuItem Header="_Ajuda">
          <MenuItem Header="Tela inicial" Command="{Binding AbrirCommand}" CommandParameter="inicio" />
          <MenuItem Header="Sobre o Perseus Contábil" Command="{Binding AbrirCommand}" CommandParameter="sobre" InputGesture="F1" />
        </MenuItem>
      </Menu>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Empresa:" Foreground="#C9D6E8" FontSize="12" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding EmpresasPermitidas}" SelectedItem="{Binding EmpresaSelecionada}"
                    MinWidth="280" MaxWidth="400" FontSize="12" MinHeight="24" Padding="8,1"
                    PlaceholderText="Nenhuma empresa">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="seg:EmpresaPermitida">
                <TextBlock Text="{Binding RazaoSocial}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding UsuarioRotulo}" Foreground="#C9D6E8" FontSize="12"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="#EEF1F5" Padding="12,4"
            IsVisible="{Binding TituloTela, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding TituloTela}" FontSize="12" Foreground="#44506A" />
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#EEF1F5" Padding="12,3">
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#44506A" TextWrapping="Wrap" />
    </Border>

    <ContentControl Content="{Binding Conteudo}" Margin="8" />
  </DockPanel>
</Window>
