<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perseus.Desktop.ViewModels"
             xmlns:v="using:Perseus.Desktop.Views"
             x:Class="Perseus.Desktop.Views.LivrosPdfView"
             x:DataType="vm:LivrosPdfViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left" Margin="8">
      <TextBlock Classes="titulo" Text="Livros e relatórios em PDF" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Período" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" />
        <TextBlock Text="a" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" />
      </StackPanel>

      <TextBlock Text="Termos de abertura e encerramento (Livro Diário) e assinaturas" FontWeight="SemiBold" Foreground="#1F3A5F" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="230,*,12,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
        <TextBlock Text="Número de ordem do livro" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding NumeroLivro}" Minimum="1" Maximum="9999" FormatString="0" Width="130" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="1" Text="Representante legal / CPF" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Representante}" Watermark="Nome" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RepresentanteCpf}" Watermark="000.000.000-00" v:Mascara.Tipo="Cpf" />
        <TextBlock Grid.Row="2" Text="Contador / CRC" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Contador}" Watermark="Nome" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Crc}" Watermark="CRC (ex.: SP-123456/O-7)" />
        <TextBlock Grid.Row="3" Text="Arquivamento dos atos (opcional)" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DataArquivamento}" Watermark="dd/mm/aaaa" />
      </Grid>

      <TextBlock Text="Gerar" FontWeight="SemiBold" Foreground="#1F3A5F" Margin="0,8,0,0" />
      <WrapPanel>
        <Button Content="Livro Diário (com termos)" Command="{Binding DiarioCommand}" Classes="accent" IsEnabled="{Binding PodeDiario}" Margin="0,0,8,8" />
        <Button Content="Livro Razão" Command="{Binding RazaoCommand}" IsEnabled="{Binding PodeRazao}" Margin="0,0,8,8" />
        <Button Content="Balancete de verificação" Command="{Binding BalanceteCommand}" IsEnabled="{Binding PodeBalancete}" Margin="0,0,8,8" />
        <Button Content="Balanço Patrimonial e DRE" Command="{Binding DemonstracoesCommand}" IsEnabled="{Binding PodeDemonstracoes}" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Os PDFs são salvos em Documentos\Perseus Contabil\Relatorios e abertos no leitor padrão. O Livro Diário segue a ITG 2000 (folhas numeradas, termos com identificação da entidade e assinaturas). Para quem é obrigado à ECD, o livro oficial é o arquivo digital do SPED." />
      <v:MensagensView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
