<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             xmlns:cad="using:Vorticis.Application.Cadastros"
             xmlns:seg="using:Vorticis.Application.Seguranca"
             x:Class="Vorticis.Desktop.Comum.Views.CadastroEmpresaView"
             x:DataType="vm:CadastroEmpresaViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secao">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TxTitulo}" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <Style Selector="TabControl#AbasEmpresa > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.empresa-aba">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TxSutil}" />
      <Setter Property="Margin" Value="8,6,8,0" />
    </Style>
  </UserControl.Styles>
  <TabControl Name="AbasEmpresa" SelectedIndex="{Binding AbaSelecionada}" Padding="0">
    <TabItem Header="Dados cadastrais">
      <!-- A aba mostra as empresas cadastradas; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
      <DockPanel Margin="8,4,8,0">
        <v:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
          <TextBlock Text="{Binding TituloLista}" Classes="titulo" VerticalAlignment="Center" />
          <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do selecionado (ou dê duplo clique / Enter na lista)" />
        </StackPanel>
        <v:MensagensView DockPanel.Dock="Bottom" />
        <ListBox Name="ListaEmpresas" ItemsSource="{Binding Main.EmpresasPermitidas}" SelectedItem="{Binding Main.EmpresaSelecionada}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="seg:EmpresaPermitida">
              <StackPanel>
                <TextBlock FontSize="12" TextWrapping="Wrap">
                  <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" /><Run Text="  " /><Run Text="{Binding RazaoSocial, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding CnpjFormatado, Mode=OneWay, StringFormat='CNPJ {0}'}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </TabItem>
    <TabItem Header="Sócios" IsEnabled="{Binding TemEmpresaSelecionada}" IsVisible="{Binding MostraAbasEmpresa}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="empresa-aba" Text="{Binding EmpresaSelecionadaRotulo}" />
        <ContentControl Content="{Binding Main.Socios}" />
      </DockPanel>
    </TabItem>
    <TabItem Header="Contadores" IsEnabled="{Binding TemEmpresaSelecionada}" IsVisible="{Binding MostraAbasEmpresa}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="empresa-aba" Text="{Binding EmpresaSelecionadaRotulo}" />
        <ContentControl Content="{Binding Main.Contabilidade}" />
      </DockPanel>
    </TabItem>
    <TabItem Header="Contabilidade" IsEnabled="{Binding PodeAbaContabilidade}" IsVisible="{Binding MostraAbasEmpresa}">
      <Grid RowDefinitions="Auto,*" Margin="8,4,8,0">
        <v:BarraCadastroView Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="6" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,12,8">
            <TextBlock Classes="titulo" Text="Contabilidade da empresa" />
            <TextBlock Text="{Binding EmpresaSelecionadaRotulo}" FontSize="12" Foreground="{DynamicResource TxSutil}" IsVisible="{Binding !EmInclusao}" />

            <TextBlock Classes="secao" Text="Plano de contas" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="rotulo" Text="Modelo do plano" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CadastroEmpresaViewModel.ModelosPlano}" SelectedItem="{Binding ModeloSelecionado}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding EmEdicao}" PlaceholderText="Plano próprio (sem modelo)">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cad:ModeloPlano"><TextBlock Text="{Binding Nome}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding ModeloSelecionado.Descricao}" FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                           IsVisible="{Binding ModeloSelecionado, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding ModeloSelecionado.Base, StringFormat='Base normativa: {0}'}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           IsVisible="{Binding ModeloSelecionado, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding PlanoAtual}" FontSize="11" Foreground="{DynamicResource TxOk}" TextWrapping="Wrap" IsVisible="{Binding !EmInclusao}" />
              </StackPanel>
              <CheckBox Grid.Row="2" Grid.Column="1" Content="Criar o plano de contas ao cadastrar a empresa" IsChecked="{Binding ImportarPlanoModelo}"
                        IsVisible="{Binding EmInclusao}" />
              <TextBlock Grid.Row="3" Classes="rotulo" Text="Máscara dos códigos" />
              <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsEnabled="{Binding EmEdicao}">
                <TextBox Text="{Binding Mascara}" Watermark="ex.: 9.9.99.999 (usada na conversão e importação do plano)" FontFamily="Consolas, Menlo, monospace" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CadastroEmpresaViewModel.Mascaras}" SelectedItem="{Binding MascaraModelo}"
                          PlaceholderText="Modelos" Width="150" />
              </Grid>
              <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                         Text="Em empresa já cadastrada, escolher outro modelo e salvar substitui o plano de contas, o que só é possível enquanto não houver lançamentos. Trocar a máscara de um plano já cadastrado mostra a prévia e converte todos os códigos de uma vez (os lançamentos não mudam)." />
            </Grid>

            <TextBlock Classes="secao" Text="Contas título de clientes e fornecedores" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}" IsVisible="{Binding !EmInclusao}">
              <TextBlock Classes="rotulo" Text="Conta título de Clientes" />
              <TextBox Grid.Column="1" v:Pesquisa.Fonte="ContaTitulo" Text="{Binding ContaTituloClientes}" Width="340" HorizontalAlignment="Left"
                       Watermark="Sintética do último nível (ex.: 1.1.02)" FontFamily="Consolas, Menlo, monospace" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Conta título de Fornecedores" />
              <TextBox Grid.Row="1" Grid.Column="1" v:Pesquisa.Fonte="ContaTitulo" Text="{Binding ContaTituloFornecedores}" Width="340" HorizontalAlignment="Left"
                       Watermark="Sintética do último nível (ex.: 2.1.01)" FontFamily="Consolas, Menlo, monospace" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                         Text="No cadastro de Clientes e Fornecedores (também no Fiscal), a opção &quot;Criar conta no plano de contas&quot; abre a conta analítica da pessoa abaixo desta conta, com o próximo código da máscara e o nome dela. Use a lupa (F4) para escolher; deixe vazio para não usar." />
            </Grid>

            <TextBlock Classes="secao" Text="Participantes e centros de custo" />
            <StackPanel Spacing="2" IsEnabled="{Binding EmEdicao}">
              <CheckBox Content="Usar participantes (clientes/fornecedores nas contas contábeis)" IsChecked="{Binding UsaParticipantes}" />
              <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="24,0,0,4"
                         Text="Clientes e fornecedores ficam alocados dentro das contas contábeis: o lançamento informa o participante e o balancete mostra a soma na conta, com detalhamento opcional por participante. O grupo (conta sintética) onde cada conta aloca seus participantes é indicado no plano de contas." />
              <CheckBox Content="Usar centros de custo" IsChecked="{Binding UsaCentroCusto}" />
            </StackPanel>
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}"
                  IsVisible="{Binding UsaCentroCusto}">
              <TextBlock Classes="rotulo" Text="Máscara dos centros" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding MascaraCentroCusto}" Watermark="ex.: 9.99.999 (vazio = códigos livres)" FontFamily="Consolas, Menlo, monospace" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CadastroEmpresaViewModel.MascarasCentroCusto}" SelectedItem="{Binding MascaraCentroCustoModelo}"
                          PlaceholderText="Modelos" Width="150" />
              </Grid>
              <CheckBox Grid.Row="1" Grid.Column="1" Content="Converter os códigos dos centros existentes para a nova máscara (1.1 → 1.01)"
                        IsChecked="{Binding ConverterCentros}" IsVisible="{Binding !EmInclusao}" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                         Text="Define os níveis do plano de centros de custo (Cadastros › Centros de custo), onde ficam os grupos e centros. Os centros já cadastrados precisam caber na máscara (ou ser convertidos)." />
            </Grid>

            <TextBlock Classes="secao" Text="{Binding TituloEscrituracao}" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
              <TextBlock Classes="rotulo" Text="Início da escrituração" />
              <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding InicioEscrituracao}" Width="180" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Apuração do IRPJ" IsVisible="{Binding EhLucroReal}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:CadastroEmpresaViewModel.FormasApuracao}" SelectedItem="{Binding ApuracaoIrpj}"
                        Width="260" HorizontalAlignment="Left" IsVisible="{Binding EhLucroReal}" PlaceholderText="Não informada">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OpcaoApuracaoIrpj"><TextBlock Text="{Binding Nome}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Grid.Row="2" Grid.Column="1" Content="Regime de caixa (tributos pelo recebimento)" IsChecked="{Binding RegimeCaixa}"
                        IsVisible="{Binding PermiteRegimeCaixa}" />
              <CheckBox Grid.Row="3" Grid.Column="1" Content="Sociedade de grande porte (ECD 0000.IND_GRANDE_PORTE)" IsChecked="{Binding GrandePorte}"
                        ToolTip.Tip="Lei 11.638/07, art. 3º: sociedade ou conjunto de sociedades sob controle comum com ativo total superior a R$ 240 milhões ou receita bruta anual superior a R$ 300 milhões." />
            </Grid>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="O regime tributário é definido na aba Dados cadastrais (na inclusão). A forma de apuração do IRPJ vale para o Lucro Real e o regime de caixa para o Presumido e o Simples Nacional." />

            <TextBlock Classes="secao" Text="Regras dos lançamentos" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
              <CheckBox Grid.Column="1" Content="Exigir o nº do documento em todos os lançamentos" IsChecked="{Binding ExigeDocumento}"
                        ToolTip.Tip="Cada partida precisa informar o documento/arquivo de suporte (ECD I250.NUM_ARQ). Saldos iniciais, encerramento e estornos ficam isentos." />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Bloquear lançamentos até" />
              <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding DataBloqueio}" Width="180" HorizontalAlignment="Left"
                                  ToolTip.Tip="Lançamentos com data igual ou anterior são recusados (escrituração já conferida/entregue). Apague a data para liberar." />
              <CheckBox Grid.Row="2" Grid.Column="1" Content="Usar estorno de lançamentos" IsChecked="{Binding UsaEstorno}"
                        ToolTip.Tip="Ligado: lançamentos gravados são corrigidos por estorno (o histórico fica na lista). Desligado: não há estorno; Editar altera o próprio lançamento e Excluir o remove, sempre com registro na trilha de auditoria." />
              <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                         Text="O histórico já é sempre obrigatório. Saldos iniciais e o lançamento de encerramento do exercício não são afetados pelo bloqueio." />
            </Grid>

            <TextBlock Classes="secao" Text="Contas do encerramento do exercício" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
              <TextBlock Classes="rotulo" Text="Apuração do resultado" />
              <v:CaixaContaPlano Grid.Column="1" Text="{Binding ContaApuracao}" ItemsSource="{Binding OpcoesApuracao}" Width="340" HorizontalAlignment="Left" Watermark="Código, reduzido ou nome (ex.: 5.1.01.001)" />
              <TextBlock Grid.Row="1" Classes="rotulo" Text="Lucros / superávit acumulados" />
              <v:CaixaContaPlano Grid.Row="1" Grid.Column="1" Text="{Binding ContaLucros}" ItemsSource="{Binding OpcoesPatrimonio}" Width="340" HorizontalAlignment="Left" Watermark="Código, reduzido ou nome (ex.: 2.3.03.001)" />
              <TextBlock Grid.Row="2" Classes="rotulo" Text="Prejuízos / déficit acumulados" />
              <v:CaixaContaPlano Grid.Row="2" Grid.Column="1" Text="{Binding ContaPrejuizos}" ItemsSource="{Binding OpcoesPatrimonio}" Width="340" HorizontalAlignment="Left" Watermark="Código, reduzido ou nome (ex.: 2.3.03.002)" />
            </Grid>
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="Use a caixa de pesquisa (código, reduzido ou nome) para escolher contas analíticas do plano da empresa; são os padrões da tela Lançamentos › Encerramento do exercício. Acompanham o modelo escolhido." />
            <v:MensagensView Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>
    <TabItem Header="Síndico" IsEnabled="{Binding TemEmpresaSelecionada}" IsVisible="{Binding MostraAbaSindico}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="empresa-aba" Text="{Binding EmpresaSelecionadaRotulo}" />
        <ScrollViewer DataContext="{Binding Main.Sindico}">
          <StackPanel x:DataType="vm:SindicoViewModel" Margin="8,4" Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
              <TextBlock Text="Nome do síndico" FontSize="12" />
              <TextBox Text="{Binding Nome}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="CPF" FontSize="12" />
                  <TextBox Text="{Binding Cpf}" Width="160" v:Mascara.Tipo="Cpf" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="E-mail" FontSize="12" />
                  <TextBox Text="{Binding Email}" Width="250" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Telefone" FontSize="12" />
                  <TextBox Text="{Binding Telefone}" Width="150" />
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="Início do mandato" FontSize="12" />
                  <CalendarDatePicker SelectedDate="{Binding MandatoInicio}" Width="150" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Fim do mandato" FontSize="12" />
                  <CalendarDatePicker SelectedDate="{Binding MandatoFim}" Width="150" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Assinatura dos livros contábeis e fiscais" FontWeight="SemiBold" Margin="0,8,0,0" />
              <CheckBox Content="Assina os livros contábeis e fiscais (assinatura normal)" IsChecked="{Binding AssinaLivros}" />
              <CheckBox Content="Assinatura digital (certificado ICP-Brasil)" IsChecked="{Binding AssinaturaDigital}" />
              <TextBlock Text="Marcado para assinar, o síndico entra no lugar do sócio/responsável no bloco de assinaturas dos livros e relatórios."
                         FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" />
                <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding Cadastrado}" />
              </StackPanel>
            </StackPanel>
            <v:MensagensView />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>