<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
        xmlns:v="using:Vorticis.Desktop.Comum.Views"
        xmlns:seg="using:Vorticis.Application.Seguranca"
        xmlns:modulos="using:Vorticis.Desktop.Comum.Modulos"
        x:Class="Vorticis.Desktop.Comum.Views.MainWindow"
        x:DataType="vm:MainViewModelBase"
        Title="Vorticis"
        Icon="avares://Vorticis.Desktop.Comum/Assets/VorticisContabil.ico"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">


  <Window.Styles>
    <Style Selector="Border.janela-aberta">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Border.janela-aberta.ativa">
      <Setter Property="Background" Value="{DynamicResource CorDestaqueModulo}" />
    </Style>
    <Style Selector="Border.janela-aberta.ativa Button.chip">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Menu#MenuPrincipal > MenuItem">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Menu#MenuPrincipal MenuItem MenuItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <!-- Módulo sozinho (aparência moderna): barra de menus clara, itens com cantos arredondados e a cor do módulo ao passar o mouse -->
    <Style Selector="Window.moderna Menu#MenuPrincipal > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TxForte}" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Window.moderna Menu#MenuPrincipal > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Window.moderna Border.janela-aberta">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Border.pilula">
      <Setter Property="Background" Value="{DynamicResource FundoSuave}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
  </Window.Styles>

  <Panel>
  <DockPanel>
    <!-- Suite (vários módulos na mesma janela): navegação à esquerda (B, C) e no topo (A, D); vazias nos executáveis de um módulo -->
    <ContentControl Name="SuiteLado" DockPanel.Dock="Left" IsVisible="False" />
    <ContentControl Name="SuiteTopo" DockPanel.Dock="Top" IsVisible="False" />
    <!-- O nome do programa fica só na barra de título da janela. Menus à esquerda; empresa ativa e usuário à direita -->
    <!-- A cor da barra e a faixa de destaque identificam o módulo (IModuloDesktop.CorBarra / CorDestaque); o nome dele fica só no título -->
    <StackPanel Name="BlocoMenus" DockPanel.Dock="Top">
    <!-- Módulo aberto sozinho (fora da Suite): cabeçalho moderno com o selo do módulo, a empresa e o usuário; o menu fica numa barra clara logo abaixo -->
    <Border Name="CabecalhoModulo" Background="{DynamicResource FundoCartao}" Padding="14,8,14,8" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{Binding PincelDestaque}">
            <PathIcon Data="{Binding IconeModulo}" Width="19" Height="19" Foreground="White" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Modulo.Nome}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TxForte}" />
            <TextBlock Text="{Binding Modulo.Subtitulo}" FontSize="11" Foreground="{DynamicResource TxSutil}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="2" Classes="pilula" VerticalAlignment="Center" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding RotuloEmpresaAtiva}" Foreground="{DynamicResource TxSutil}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
            <ComboBox Name="ClienteCabecalho" ItemsSource="{Binding ClientesNoSeletor}" SelectedItem="{Binding ClienteEmFoco}" IsVisible="{Binding UsaSeletorDeClientes}"
                      MinWidth="220" MaxWidth="380" FontSize="12.5" MinHeight="26" Padding="10,1" BorderThickness="0" Background="Transparent" PlaceholderText="Escolha o cliente"
                      ToolTip.Tip="Cliente em foco: as telas do Escritório mostram só o que é dele." />
            <ComboBox Name="EmpresaCabecalho" IsVisible="{Binding UsaSeletorDeEmpresas}" ItemsSource="{Binding EmpresasPermitidas}" SelectedItem="{Binding EmpresaSelecionada}"
                      MinWidth="180" MaxWidth="380" FontSize="12.5" MinHeight="28" Padding="10,2" BorderThickness="0" Background="Transparent"
                      PlaceholderText="Nenhuma empresa">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="seg:EmpresaPermitida">
                  <TextBlock>
                    <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" – " /><Run Text="{Binding RazaoSocial, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="{Binding UsuarioRotulo}">
          <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Realce}">
            <TextBlock Text="{Binding IniciaisUsuario}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding UsuarioRotulo}" FontSize="12" Foreground="{DynamicResource TxForte}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Name="BarraMenuWrap">
    <Border Name="FaixaDestaque" BorderBrush="{Binding PincelDestaque}" BorderThickness="0,0,0,4" IsVisible="{Binding Logado}">
    <Border Name="BarraMenu" Background="{Binding PincelBarra}" Padding="4,0,8,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Os itens vêm do módulo (IModuloDesktop.Menus) e são montados em MainWindow.axaml.cs -->
        <Menu Name="MenuPrincipal" Grid.Column="1" />
        <!-- Na Suite (aparência moderna): empresa num seletor arredondado e o usuário com as iniciais, na própria barra de menus clara -->
        <Border Grid.Column="3" Classes="pilula" VerticalAlignment="Center" Margin="0,3" IsVisible="{Binding #EmpresaNaBarra.IsVisible}">
        <StackPanel Name="EmpresaNaBarra" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding RotuloEmpresaAtiva}" Foreground="{DynamicResource TxSutil}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
<ComboBox Name="ClienteNaBarra" ItemsSource="{Binding ClientesNoSeletor}" SelectedItem="{Binding ClienteEmFoco}" IsVisible="{Binding UsaSeletorDeClientes}"
                    MinWidth="200" MaxWidth="380" FontSize="12.5" MinHeight="26" Padding="10,1" BorderThickness="0" Background="Transparent" PlaceholderText="Escolha o cliente"
                    ToolTip.Tip="Cliente em foco: as telas do Escritório mostram só o que é dele." />
          <ComboBox IsVisible="{Binding UsaSeletorDeEmpresas}" ItemsSource="{Binding EmpresasPermitidas}" SelectedItem="{Binding EmpresaSelecionada}"
                    MinWidth="160" MaxWidth="360" FontSize="12" MinHeight="26" Padding="10,1" BorderThickness="0" Background="Transparent"
                    PlaceholderText="Nenhuma empresa">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="seg:EmpresaPermitida">
                <TextBlock>
                  <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" – " /><Run Text="{Binding RazaoSocial, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        </Border>
        <StackPanel Name="UsuarioNaBarra" Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="12,0,0,0"
                    ToolTip.Tip="{Binding UsuarioRotulo}">
          <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Realce}">
            <TextBlock Text="{Binding IniciaisUsuario}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding UsuarioRotulo}" FontSize="12" Foreground="{DynamicResource TxForte}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    </Border>
    </StackPanel>

    <!-- Faixa fixa logo abaixo dos menus (sempre visível depois de entrar, para as janelas das funções nunca a cobrirem):
         à esquerda, as funções abertas (clicar traz para a frente, ✕ fecha); à direita, na Folha, a competência e a situação dela -->
    <Border Name="BarraFuncoes" Background="{DynamicResource FundoSuave}" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" Padding="8,3"
            MinHeight="34" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <ItemsControl Name="FuncoesAbertas" ItemsSource="{Binding JanelasAbertas}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FuncaoAberta">
              <Border Classes="janela-aberta" Classes.ativa="{Binding Ativa}" CornerRadius="3" Margin="0,1,6,1" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="{Binding Rotulo}" ToolTip.Tip="{Binding Titulo}" Classes="chip" FontSize="12" Padding="8,2"
                          Command="{Binding $parent[Window].((vm:MainViewModelBase)DataContext).AtivarFuncaoCommand}" CommandParameter="{Binding}" />
                  <Button Content="✕" Classes="chip" FontSize="11" Padding="6,2" ToolTip.Tip="Fechar"
                          Command="{Binding $parent[Window].((vm:MainViewModelBase)DataContext).FecharFuncaoCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Período de trabalho do módulo (Folha: competência) e a situação dela; fechado bloqueia inclusões, alterações e exclusões -->
        <StackPanel Name="FaixaPeriodo" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding UsaPeriodo}"
                    Margin="12,0,0,0">
          <TextBlock Text="{Binding RotuloPeriodo}" Foreground="{DynamicResource TxSutil}" FontSize="12" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ListaPeriodos}" SelectedItem="{Binding PeriodoEscolhido}" Width="150"
                    FontSize="12" MinHeight="24" MaxDropDownHeight="360">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OpcaoPeriodo">
                <TextBlock Text="{Binding Texto}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Só fechadas" IsChecked="{Binding SomenteFechados}" Foreground="{DynamicResource TxSutil}" FontSize="12"
                    VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Mostra na lista só as competências já fechadas" />
          <Border Background="{Binding PincelSituacaoPeriodo}" CornerRadius="3" Padding="6,1"
                  VerticalAlignment="Center" ToolTip.Tip="Situação do período: inclusões, alterações e exclusões só com o período aberto">
            <TextBlock Text="{Binding SituacaoPeriodo}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TxForte}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FundoSuave}" Padding="12,3">
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
    </Border>

    <Panel Name="AreaTrabalho">
      <ContentControl Name="AreaPrincipal" Content="{Binding ConteudoPrincipal}" Margin="8" />
      <!-- Suite, layout D: painel inicial com os cartões dos módulos (cobre a área de trabalho) -->
      <ContentControl Name="SuitePainel" IsVisible="False" />
      <!-- Suite, visual 5 (e Ctrl+K nos demais): busca central -->
      <ContentControl Name="SuiteBusca" IsVisible="False" />
    </Panel>
  </DockPanel>

  <!-- Bloqueio por inatividade (Preferências): cobre tudo e pede a senha; as telas abertas continuam como estavam -->
  <Border Name="TelaBloqueio" x:DataType="vm:BloqueioViewModel" IsVisible="{Binding Ativo}" Background="#E60F172A">
    <Border Background="{DynamicResource FundoCartao}" CornerRadius="14" Padding="28,24" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 10 30 0 #66000000">
      <StackPanel Spacing="12">
        <PathIcon Data="{x:Static v:Icones.ShieldAccount}" Width="36" Height="36" Foreground="{DynamicResource TxTitulo}" HorizontalAlignment="Center" />
        <TextBlock Text="Tela bloqueada" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TxForte}" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TxSutil}"
                   Text="{Binding Usuario, StringFormat='O programa ficou sem uso. {0}, digite a sua senha para continuar de onde parou.'}" />
        <TextBox Name="SenhaBloqueio" Text="{Binding Senha}" PasswordChar="●" Watermark="Senha" />
        <TextBlock Text="{Binding Erro}" Classes="erro" IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Name="Desbloquear" Content="Desbloquear" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding DesbloquearCommand}" IsDefault="True" />
        <Button Content="Sair (trocar de usuário)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SairCommand}" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
