<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels" xmlns:v="using:Vorticis.Desktop.Comum.Views" xmlns:seg="using:Vorticis.Application.Seguranca"
             x:Class="Vorticis.Desktop.Comum.Views.SuiteTopoView" x:DataType="vm:SuiteViewModel">
  <!-- Suite, parte de cima: A e E = abas dos módulos (E com a faixa de opções embaixo); D = painel inicial e módulo atual -->
  <StackPanel>
    <!-- A e E: uma aba por módulo -->
    <Border Name="BarraAbas" Background="{DynamicResource FundoSuave}" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" Padding="10,6,10,0" IsVisible="{Binding MostraAbas}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,6">
          <!-- E: empresa ativa, usuário e Exibir no lugar da barra de menus clássica -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding EhFaixa}">
            <TextBlock Text="{Binding Ativo.Vm.RotuloEmpresaAtiva}" Classes="su-sub" FontSize="12" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Ativo.Vm.EmpresasPermitidas}" SelectedItem="{Binding Ativo.Vm.EmpresaSelecionada}" MinWidth="130" MaxWidth="230"
                      MinHeight="26" Padding="8,1" FontSize="12" PlaceholderText="Nenhuma empresa" CornerRadius="8">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="seg:EmpresaPermitida">
                  <TextBlock><Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" – " /><Run Text="{Binding RazaoSocial, Mode=OneWay}" /></TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding UsuarioRotulo}" FontSize="12" Foreground="{DynamicResource TxForte}" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" />
            <Button Name="BotaoExibir" Classes="su" Padding="9,6" Click="AbrirExibir">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static v:Icones.ViewGridOutline}" Width="15" Height="15" Foreground="{DynamicResource TxSutil}" />
                <TextBlock Text="Exibir" FontSize="12" Foreground="{DynamicResource TxSutil}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Name="BotaoFaixa" Classes="su" Padding="9,6" Command="{Binding AlternarFaixaCommand}"
                  ToolTip.Tip="Fixar: a faixa fica sempre à mostra. Ocultar: só os títulos das abas ficam à mostra e a faixa abre por cima ao passar o mouse">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{Binding IconeFixarFaixa}" Width="15" Height="15" Foreground="{DynamicResource TxSutil}" />
              <TextBlock Text="{Binding TextoFixarFaixa}" FontSize="12" Foreground="{DynamicResource TxSutil}" VerticalAlignment="Center" IsVisible="{Binding EhAbas}" />
            </StackPanel>
          </Button>
          <v:SuiteEscolhaLayoutView />
        </StackPanel>
        <Image DockPanel.Dock="Left" Source="avares://Vorticis.Desktop.Comum/Assets/marca-vorticis.png" Width="26" Height="26" Margin="0,0,12,6"
               VerticalAlignment="Center" ToolTip.Tip="{Binding Nome}" />
        <ItemsControl Name="Abas" ItemsSource="{Binding Modulos}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModuloSuite">
              <Button Classes="su aba" ToolTip.Tip="{Binding NomeCompleto}"
                      Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).TrocarCommand}" CommandParameter="{Binding}">
                <Panel>
                  <Border CornerRadius="9,9,0,0" Background="{DynamicResource FundoCartao}" IsVisible="{Binding Ativo}" BoxShadow="0 -1 6 0 #14233B55" />
                  <Border Height="3" VerticalAlignment="Top" CornerRadius="9,9,0,0" Background="{Binding Cor}" IsVisible="{Binding Ativo}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,9,14,9">
                    <PathIcon Data="{Binding Icone}" Width="18" Height="18" Foreground="{Binding Cor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TxForte}"
                               IsVisible="{Binding !$parent[UserControl].((vm:SuiteViewModel)DataContext).AbasCompactas}" />
                    <Border Classes="su-selo" VerticalAlignment="Center" IsVisible="{Binding TemAbertas}" ToolTip.Tip="Funções abertas neste módulo">
                      <TextBlock Text="{Binding Abertas}" />
                    </Border>
                  </StackPanel>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- E: faixa de opções fixa (os botões são montados em SuiteTopoView.axaml.cs a partir dos menus do módulo) -->
    <ContentControl Name="CorpoFixo" IsVisible="{Binding MostraCorpoFaixa}" />
    <Popup Name="CorpoFlutuante" IsOpen="{Binding FaixaFlutuanteAberta, Mode=OneWay}" PlacementTarget="{Binding #BarraAbas}" Placement="Bottom"
           IsLightDismissEnabled="False" Topmost="True">
      <ContentControl Name="CorpoPopup" />
    </Popup>

    <!-- D: marca, painel inicial e módulo atual -->
    <Border Name="BarraPainel" Background="{DynamicResource FundoCartao}" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" Padding="14,8" IsVisible="{Binding EhPainel}">
      <DockPanel>
        <v:SuiteEscolhaLayoutView DockPanel.Dock="Right" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="avares://Vorticis.Desktop.Comum/Assets/marca-vorticis.png" Width="30" Height="30" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="{Binding Nome}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TxTitulo}" />
            <TextBlock Text="Escolha um módulo para começar" Classes="su-sub" FontSize="10.5" />
          </StackPanel>
          <Button Name="BotaoVoltarPainel" Classes="su-marca" IsVisible="{Binding !NoPainel}" Command="{Binding IrParaPainelCommand}" ToolTip.Tip="Voltar ao painel com todos os módulos">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static v:Icones.ArrowLeft}" Width="14" Height="14" Foreground="White" />
              <TextBlock Text="Voltar ao painel" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource FundoSuave}" Margin="6,4" />
          <TextBlock Text="Módulo:" VerticalAlignment="Center" Classes="su-sub" FontSize="12" />
          <ComboBox Name="SeletorModulo" ItemsSource="{Binding Modulos}" SelectedItem="{Binding ModuloNoSeletor}" MinWidth="220" CornerRadius="8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuloSuite">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{Binding Icone}" Width="16" Height="16" Foreground="{Binding Cor}" />
                  <TextBlock Text="{Binding NomeCompleto}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
