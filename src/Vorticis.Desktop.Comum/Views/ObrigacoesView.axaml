<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.ObrigacoesView"
             x:DataType="vm:ObrigacoesViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rotulo"><Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,12,340" Margin="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="titulo" Text="Calendário de obrigações" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{x:Static vm:ObrigacoesViewModel.Visoes}" SelectedIndex="{Binding Visao}" Width="260" />
          <Button Content="◀" Command="{Binding MesAnteriorCommand}" IsVisible="{Binding VisaoMensal}" />
          <TextBlock Text="{Binding TituloMes}" MinWidth="150" TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding VisaoMensal}" />
          <Button Content="▶" Command="{Binding MesSeguinteCommand}" IsVisible="{Binding VisaoMensal}" />
          <Button Content="Mês atual" Command="{Binding MesAtualCommand}" IsVisible="{Binding VisaoMensal}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox IsChecked="{Binding VerContabil}" Content="Contábil" />
          <CheckBox IsChecked="{Binding VerFiscal}" Content="Fiscal" />
          <CheckBox IsChecked="{Binding VerFolha}" Content="Folha" />
          <CheckBox IsChecked="{Binding OcultarCumpridas}" Content="Ocultar cumpridas" />
          <TextBlock Text="{Binding NomeModulo, StringFormat='Módulo atual: {0}'}" Classes="rotulo" Foreground="Gray" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:BarraExportacaoView />
          <Button Name="AbrirPersonalizadas" Content="Obrigações personalizadas" Command="{Binding AbrirPersonalizadasCommand}" IsEnabled="{Binding PodeManter}"
                  ToolTip.Tip="Cadastra obrigações municipais, estaduais ou internas que não vêm prontas no calendário" />
        </StackPanel>
        <v:MensagensView />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
      <DataGrid ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding Vencimento}" Width="130" />
          <DataGridTextColumn Header="Obrigação" Binding="{ReflectionBinding Nome}" Width="*" MinWidth="220" />
          <DataGridTextColumn Header="Competência" Binding="{ReflectionBinding Competencia}" Width="100" />
          <DataGridTextColumn Header="Módulo" Binding="{ReflectionBinding Modulo}" Width="130" />
          <DataGridTemplateColumn Header="Situação" Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:LinhaObrigacao">
                <Border Background="{Binding Fundo}" Padding="6,2" Margin="2">
                  <TextBlock Text="{Binding Situacao}" Foreground="{Binding Texto}" FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="6">
        <TextBlock Text="Obrigação selecionada" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" />
        <StackPanel IsVisible="{Binding Selecionada, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4" DataContext="{Binding}">
          <TextBlock Text="{Binding Selecionada.Nome}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selecionada.Orgao}" FontSize="11" Foreground="Gray" />
          <TextBlock Text="{Binding Selecionada.Regra, StringFormat='Regra: {0}'}" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selecionada.Observacao}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
          <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeManter}" />
          <StackPanel Spacing="4" IsVisible="{Binding PodeManter}">
            <Grid ColumnDefinitions="110,*">
              <TextBlock Classes="rotulo" Text="Cumprida em" />
              <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DataCumprimento}" />
            </Grid>
            <TextBox Text="{Binding ObservacaoBaixa}" Watermark="Observação (ex.: protocolo, recibo)" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Marcar como cumprida" Command="{Binding MarcarCumpridaCommand}" Classes="accent" />
              <Button Content="Desfazer" Command="{Binding DesfazerCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
