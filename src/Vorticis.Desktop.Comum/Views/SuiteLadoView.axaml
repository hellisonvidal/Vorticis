<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels" xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.SuiteLadoView" x:DataType="vm:SuiteViewModel">
  <!--
    Suite, layouts B (barra lateral) e C (árvore com busca). Por padrão fica oculta: só a faixa de ícones (Rail) aparece e a navegação abre
    por cima das telas ao passar o mouse ou clicar. Fixada, a navegação completa fica no lugar da faixa e empurra o conteúdo.
  -->
  <Panel Name="Navegacao" Background="Transparent">
    <v:SuiteNavegacaoView Name="NavFixa" IsVisible="{Binding MostraNavFixa}" />

    <!-- faixa de ícones (navegação oculta) -->
    <Border Name="Rail" Width="60" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" IsVisible="{Binding MostraRail}">
      <DockPanel>
        <Image DockPanel.Dock="Top" Source="avares://Vorticis.Desktop.Comum/Assets/marca-vorticis.png" Width="32" Height="32" Margin="0,14,0,10"
               ToolTip.Tip="{Binding Nome}" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,12" HorizontalAlignment="Center">
          <Button Classes="su" Padding="9" Command="{Binding AlternarFixaCommand}" ToolTip.Tip="Fixar a navegação (ela fica sempre aberta e empurra as telas)">
            <PathIcon Data="{x:Static v:Icones.Pin}" Width="18" Height="18" Foreground="#475569" />
          </Button>
          <v:SuiteEscolhaLayoutView Compacto="True" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="#EDF1F7" Margin="12,0,12,8" />
        <Button DockPanel.Dock="Top" Classes="su" Margin="8,0,8,4" Padding="0,9" IsVisible="{Binding EhArvore}" ToolTip.Tip="Buscar uma função (Ctrl+K)">
          <PathIcon Data="{x:Static v:Icones.Magnify}" Width="20" Height="20" Foreground="#475569" />
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <ItemsControl ItemsSource="{Binding Modulos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuloSuite">
                <Button Classes="su" Classes.sel="{Binding Ativo}" Margin="8,2" Padding="0,8" ToolTip.Tip="{Binding NomeCompleto}"
                        Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).TrocarCommand}" CommandParameter="{Binding}">
                  <Panel>
                    <Border Width="3" Height="20" CornerRadius="0,2,2,0" Background="{Binding Cor}" HorizontalAlignment="Left" Margin="-8,0,0,0" IsVisible="{Binding Ativo}" />
                    <Panel Width="30" Height="30">
                      <Border CornerRadius="8" Background="{Binding Cor}" Opacity="0.14" />
                      <PathIcon Data="{Binding Icone}" Width="19" Height="19" Foreground="{Binding Cor}" />
                    </Panel>
                    <Border Classes="su-selo" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,2,0" IsVisible="{Binding TemAbertas}"
                            ToolTip.Tip="Funções abertas neste módulo">
                      <TextBlock Text="{Binding Abertas}" />
                    </Border>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- a mesma navegação, aberta por cima das telas (janela própria, para ficar acima das funções abertas) -->
    <Popup Name="Flutuante" IsOpen="{Binding NavFlutuanteAberta, Mode=OneWay}" PlacementTarget="{Binding #Rail}" Placement="AnchorAndGravity"
           PlacementAnchor="TopRight" PlacementGravity="BottomRight" IsLightDismissEnabled="False" Topmost="True">
      <v:SuiteNavegacaoView Name="NavFlutuante" Flutuante="True" Height="{Binding #Rail.Bounds.Height}" />
    </Popup>
  </Panel>
</UserControl>
