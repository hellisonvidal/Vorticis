<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.AtualizacoesView"
             x:DataType="vm:AtualizacoesViewModel">
  <!-- Configurações › Atualizações do sistema -->
  <StackPanel Margin="12" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
    <TextBlock Classes="titulo" Text="Atualizações do sistema" />
    <TextBlock Text="{Binding VersaoInstalada, StringFormat='Versão instalada: {0}'}" />
    <TextBlock Text="{Binding Site, StringFormat='Procurando em: {0}'}" FontSize="11" Foreground="{DynamicResource TxSutil}"
               IsVisible="{Binding Site, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Name="SituacaoAtualizacao" Text="{Binding Situacao}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox Text="{Binding Notas}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="260"
             IsVisible="{Binding Notas, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Name="AtualizarAgora" Content="Atualizar agora" Classes="accent" Command="{Binding AtualizarAgoraCommand}" IsVisible="{Binding TemNova}"
              IsEnabled="{Binding PodeAtualizar}" ToolTip.Tip="Baixa o instalador da versão nova e o executa por cima da instalação; o Vorticis fecha e abre de novo." />
      <Button Content="Baixar no navegador" Command="{Binding BaixarCommand}" IsVisible="{Binding TemNova}" />
      <Button Content="Verificar novamente" Command="{Binding VerificarNovamenteCommand}" IsEnabled="{Binding !Baixando}" />
    </StackPanel>
    <ProgressBar Value="{Binding Progresso}" Minimum="0" Maximum="100" Height="8" IsVisible="{Binding Baixando}" ShowProgressText="False" />
    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
               Text="Atualizar agora baixa e executa o instalador: o Vorticis fecha durante a atualização e abre de novo ao terminar. Feche o programa nos outros computadores antes. Os dados são preservados e o banco é atualizado sozinho na primeira abertura." />
    <v:MensagensView />
  </StackPanel>
</UserControl>
