<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.CentrosCustoView"
             x:DataType="vm:CentrosCustoViewModel">
  <!-- A tela mostra os centros de custo; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="Centros de custo" VerticalAlignment="Center" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do centro selecionado (ou dê duplo clique / Enter na lista)" />
        <Button Content="Abrir o cadastro da empresa" Command="{Binding AbrirCadastroEmpresaCommand}" IsVisible="{Binding PodeAbrirEmpresa}" />
      </StackPanel>
      <TextBlock Text="Seu perfil permite apenas consultar." Classes="erro" IsVisible="{Binding !PodeEditar}" />
      <TextBlock Text="{Binding ResumoMascara}" FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
      <TextBlock Text="A máscara e o uso de centros de custo são definidos no cadastro da empresa, aba Contabilidade." FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
      <TextBlock Text="Esta empresa ainda não ativou &quot;Usar centros de custo&quot; (aba Contabilidade): os lançamentos não pedem centro." Classes="erro" FontSize="11"
                 IsVisible="{Binding AvisoNaoUsa}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaCentros" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="70" />
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Estrutura}" Width="190" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="90" />
        <DataGridTextColumn Header="Superior" Binding="{ReflectionBinding Superior}" Width="120" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="200" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
