<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels" xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.SuitePainelView" x:DataType="vm:SuiteViewModel">
  <!-- Suite, layout D: painel inicial (launcher) com um cartão por módulo, funções mais usadas e próximos vencimentos -->
  <UserControl.Styles>
    <Style Selector="Border.cartao-modulo">
      <Setter Property="Transitions">
        <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cartao-modulo:pointerover">
      <Setter Property="BoxShadow" Value="0 8 24 0 #33233B55" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer Background="{DynamicResource FundoPagina}">
    <StackPanel Margin="32,18,32,20" Spacing="4">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{Binding Saudacao}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TxTitulo}" />
          <TextBlock Text="{Binding Hoje}" FontSize="13" Foreground="{DynamicResource TxSutil}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{x:Static v:Icones.Account}" Width="16" Height="16" Foreground="{DynamicResource TxSutil}" />
          <TextBlock Text="{Binding UsuarioRotulo}" Foreground="{DynamicResource TxSutil}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <ItemsControl Name="CartoesModulos" ItemsSource="{Binding Modulos}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuloSuite">
            <Border Classes="su-cartao cartao-modulo" Margin="0,0,16,12" ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Height="4" Background="{Binding Cor}" />
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="18,4,18,12">
                  <Button Classes="su-marca" Background="{Binding Cor}" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).TrocarCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Abrir módulo" VerticalAlignment="Center" />
                      <PathIcon Data="{x:Static v:Icones.ChevronRight}" Width="14" Height="14" Foreground="White" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding Abertas, StringFormat='{}{0} função(ões) aberta(s)'}" IsVisible="{Binding TemAbertas}"
                             Foreground="{DynamicResource TxSutil}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="18,12,18,2" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
                    <Panel Width="46" Height="46">
                      <Border CornerRadius="14" Background="{Binding Cor}" Opacity="0.14" />
                      <PathIcon Data="{Binding Icone}" Width="26" Height="26" Foreground="{Binding Cor}" />
                    </Panel>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Nome}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TxForte}" />
                      <TextBlock Text="{Binding Subtitulo}" Classes="su-sub" FontSize="11.5" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="FUNÇÕES MAIS USADAS" Classes="su-secao" Margin="0,2,0,3" />
                  <ItemsControl ItemsSource="{Binding Atalhos}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NoSuite">
                        <Button Classes="su" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="9" Margin="6,3">
                            <PathIcon Data="{x:Static v:Icones.ChevronRight}" Width="12" Height="12" Foreground="{Binding CorIcone}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TxForte}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,*" Margin="0,0,16,0">
        <Border Classes="su-cartao" Margin="0,0,16,0" Padding="18,12">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static v:Icones.Star}" Width="14" Height="14" Foreground="#E0A100" />
              <TextBlock Text="FAVORITOS E RECENTES" Classes="su-secao" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Favoritos}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoSuite">
                  <Button Classes="su" Margin="0,0,6,6" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                    <Border CornerRadius="14" BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="10,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{Binding CorIcone}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TxForte}" />
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Recentes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoSuite">
                  <Button Classes="su" Margin="0,0,6,6" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                    <Border CornerRadius="14" Background="{DynamicResource FundoSuave}" Padding="10,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{x:Static v:Icones.History}" Width="12" Height="12" Foreground="{DynamicResource TxSutil}" />
                        <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TxForte}" />
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Marque funções com a estrela na árvore (layout C) e as que você abrir aparecem aqui." Classes="su-sub"
                       IsVisible="{Binding !TemRecentes}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="su-cartao" Padding="18,12">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static v:Icones.CalendarCheck}" Width="14" Height="14" Foreground="#1FA67A" />
              <TextBlock Text="PRÓXIMOS VENCIMENTOS" Classes="su-secao" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Vencimentos.Proximas}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProximaObrigacao">
                  <Grid ColumnDefinitions="52,*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Vencimento}" FontWeight="SemiBold" Foreground="{DynamicResource TxForte}" />
                    <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="{DynamicResource TxForte}" TextTrimming="CharacterEllipsis" />
                    <Panel Grid.Column="2">
                      <Border CornerRadius="9" Background="{Binding Cor}" Opacity="0.22" />
                      <TextBlock Text="{Binding Situacao}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TxForte}" Margin="8,1" />
                    </Panel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nada a vencer nos próximos dias para a empresa ativa." Classes="su-sub" IsVisible="{Binding !Vencimentos.TemProximas}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
