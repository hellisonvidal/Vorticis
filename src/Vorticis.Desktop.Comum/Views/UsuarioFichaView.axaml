<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.UsuarioFichaView"
             x:DataType="vm:UsuariosViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:OpcaoPerfil">
      <TextBlock Text="{Binding Nome}" />
    </DataTemplate>
  </UserControl.DataTemplates>
  <!-- Ficha do usuário (janela aberta pela tela Usuários) -->
  <DockPanel>
    <v:RodapeFichaView DockPanel.Dock="Bottom" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="8" Margin="0,0,16,8">
        <TextBlock Text="Usuário" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="rotulo" Text="Login" />
          <TextBox Grid.Column="1" Text="{Binding Login}" IsEnabled="{Binding EmInclusao}" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Nome" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NomeEdicao}" IsEnabled="{Binding EmEdicao}" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Senha inicial" IsVisible="{Binding EmInclusao}" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NovaSenha}" PasswordChar="●" IsVisible="{Binding EmInclusao}"
                   Watermark="O usuário troca no primeiro acesso" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Perfil" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PerfisDisponiveis}" SelectedItem="{Binding PerfilEdicao}"
                    PlaceholderText="Escolha o perfil" HorizontalAlignment="Stretch" IsEnabled="{Binding EmEdicao}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DescricaoPerfil}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
          <CheckBox Grid.Row="5" Grid.Column="1" Content="Ativo" IsChecked="{Binding AtivoEdicao}" IsEnabled="{Binding EmAlteracao}" />
        </Grid>

        <TextBlock Text="Dados pessoais e contato" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" Margin="0,8,0,0" />
        <Grid Name="DadosPessoais" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="CPF" />
          <TextBox Grid.Column="1" Text="{Binding Cpf}" Width="150" HorizontalAlignment="Left" Watermark="000.000.000-00" v:Mascara.Tipo="Cpf" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="E-mail" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email}" MaxLength="150" Watermark="nome@escritorio.com.br" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Telefone / celular" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding Telefone}" Width="140" MaxLength="20" Watermark="Telefone" />
            <TextBox Text="{Binding Celular}" Width="140" MaxLength="20" Watermark="Celular" />
          </StackPanel>
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Admissão" />
          <CalendarDatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding Admissao}" Width="150" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Cargo" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Cargo}" MaxLength="80" Watermark="Ex.: Analista fiscal" />
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Departamento" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Departamento}" MaxLength="80" Watermark="Ex.: Fiscal, Pessoal, Contábil" />
          <TextBlock Grid.Row="6" Classes="rotulo" Text="Observação" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ObservacaoUsuario}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="54" />
        </Grid>

        <StackPanel Name="ModulosDoUsuario" Spacing="4" IsVisible="{Binding MostrarAcessos}">
          <TextBlock Text="Módulos que o usuário pode acessar" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="Desmarque os módulos bloqueados: o usuário entra neles, mas não vê nenhuma empresa nem função (só Ajuda, Alterar senha e Sair). Administradores acessam todos."
                     FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ModulosAcesso}" IsEnabled="{Binding EmEdicao}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuloAcessoLinha">
                <CheckBox IsChecked="{Binding Marcado}" Content="{Binding Nome}" FontSize="12" MinWidth="130" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding MostrarAcessos}">
          <TextBlock Text="Empresas que o usuário pode acessar" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="Marque as empresas liberadas; o usuário só vê e seleciona essas. O perfil ao lado vale em cada empresa. Empresas cadastradas depois só são liberadas automaticamente a quem tem todas marcadas."
                     FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
          <TextBox Text="{Binding FiltroEmpresas}" Watermark="Buscar empresa (nome, código ou CNPJ)" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EmEdicao}">
            <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" />
            <Button Content="Desmarcar todas" Command="{Binding DesmarcarTodasCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ResumoEmpresas}" FontSize="11" Foreground="{DynamicResource TxSutil}" />
          <ScrollViewer MaxHeight="320">
            <ItemsControl ItemsSource="{Binding AcessosFiltrados}" IsEnabled="{Binding EmEdicao}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AcessoLinha">
                  <Grid ColumnDefinitions="*,150" Margin="0,2">
                    <CheckBox IsChecked="{Binding Marcada}" Content="{Binding Rotulo}" FontSize="12" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Perfil}" IsEnabled="{Binding Marcada}"
                              HorizontalAlignment="Stretch" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding TemSelecionado}" Margin="0,8,0,0">
          <TextBlock Text="Redefinir senha" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EmConsulta}">
            <TextBox Text="{Binding SenhaTemporaria}" Watermark="Senha temporária" PasswordChar="●" Width="200" />
            <Button Content="Redefinir" Command="{Binding RedefinirSenhaCommand}" />
          </StackPanel>
          <TextBlock Text="Também desbloqueia o usuário. Ele deverá trocar a senha no próximo acesso." FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
        <v:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
