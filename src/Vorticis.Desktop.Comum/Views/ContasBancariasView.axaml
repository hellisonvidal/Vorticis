<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.ContasBancariasView"
             x:DataType="vm:ContasBancariasViewModel">
  <!-- Cadastros › Contas bancárias (no Contábil: Bancos): a tela mostra os cadastrados; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Bancos (contas bancárias)" VerticalAlignment="Center" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do selecionado (ou dê duplo clique / Enter na lista)" />
      <TextBlock Text="{Binding Lista.Count, StringFormat='{}{0} cadastrado(s)'}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TxSutil}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="Lista" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="0.5*" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="2*" />
        <DataGridTextColumn Header="Banco" Binding="{ReflectionBinding Banco}" Width="0.5*" />
        <DataGridTextColumn Header="Agência" Binding="{ReflectionBinding Agencia}" Width="0.7*" />
        <DataGridTextColumn Header="Conta" Binding="{ReflectionBinding Conta}" Width="0.9*" />
        <DataGridTextColumn Header="Conta contábil" Binding="{ReflectionBinding ContaContabil}" Width="0.9*" />
        <DataGridCheckBoxColumn Header="Ativa" Binding="{ReflectionBinding Ativa}" Width="0.4*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
