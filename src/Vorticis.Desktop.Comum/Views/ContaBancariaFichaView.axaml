<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.ContaBancariaFichaView"
             x:DataType="vm:ContasBancariasViewModel">
  <!-- Ficha da conta bancária (janela aberta pela tela Contas bancárias / Bancos) -->
  <DockPanel>
    <c:RodapeFichaView DockPanel.Dock="Bottom" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="6" Margin="0,0,16,8">
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="Código" />
          <TextBox Grid.Column="1" Text="{Binding Codigo}" Width="100" HorizontalAlignment="Left" IsReadOnly="{Binding !EmInclusao}" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Descrição" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Descricao}" Watermark="ex.: Banco do Brasil – movimento" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Banco" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Banco}" Width="100" HorizontalAlignment="Left" Watermark="001" MaxLength="3" />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Agência" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Agencia}" Width="160" HorizontalAlignment="Left" Watermark="1234-5" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Conta" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Conta}" Width="200" HorizontalAlignment="Left" Watermark="12345-6" />
          <TextBlock Grid.Row="5" Classes="rotulo" Text="Conta contábil" />
          <TextBox Grid.Row="5" Grid.Column="1" c:Pesquisa.Fonte="Conta" Text="{Binding ContaContabil}" Width="200" HorizontalAlignment="Left" Watermark="1.1.02.001 (opcional)" />
          <CheckBox Grid.Row="6" Grid.Column="1" Content="Ativa" IsChecked="{Binding Ativa}" />
        </Grid>
        <TextBlock FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                   Text="Banco é o código de compensação (001 Banco do Brasil, 104 Caixa, 237 Bradesco, 341 Itaú...). A conta contábil, se informada, precisa existir no plano de contas da empresa." />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
