<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.ParticipantesView"
             x:DataType="vm:ParticipantesViewModel">
  <!-- A tela mostra os clientes ou fornecedores cadastrados; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8,4,8,0">
    <v:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="{Binding TituloLista}" Classes="titulo" VerticalAlignment="Center" />
      <TextBox Text="{Binding Filtro}" Watermark="Filtrar por código, nome ou CPF/CNPJ" Width="300" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do selecionado (ou dê duplo clique / Enter na lista)" />
      <TextBlock Text="{Binding Lista.Count, StringFormat='{}{0} cadastrado(s)'}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TxSutil}" />
    </StackPanel>
    <v:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaParticipantes" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="90" />
        <DataGridTextColumn Header="Nome / razão social" Binding="{ReflectionBinding Nome}" Width="2*" />
        <DataGridTextColumn Header="CPF / CNPJ" Binding="{ReflectionBinding Documento}" Width="160" />
        <DataGridTextColumn Header="Município/UF" Binding="{ReflectionBinding Cidade}" Width="*" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="150" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
