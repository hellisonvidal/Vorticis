<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.PerfisView"
             x:DataType="vm:PerfisViewModel">
  <DockPanel>
  <Border DockPanel.Dock="Top" IsVisible="{Binding ConfiguracaoInicial}" Background="{DynamicResource FundoAviso}" BorderBrush="{DynamicResource BordaAviso}"
          BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="8,8,8,0">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="Configuração inicial (obrigatória): perfis de acesso dos usuários" />
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="Antes de usar o sistema, defina o que cada perfil de usuário pode acessar. Os perfis Administrador (todas as funções), Contador, Assistente e Consulta já vêm prontos: revise as funções liberadas, ajuste ou crie novos perfis e clique em Concluir. O cadastro de empresas pode ser feito depois." />
      </StackPanel>
      <Button Grid.Column="1" Content="Concluir configuração dos perfis" Classes="accent" VerticalAlignment="Center"
              Margin="12,0,0,0" Command="{Binding ConcluirConfiguracaoInicialCommand}" />
    </Grid>
  </Border>
  <DockPanel Margin="8">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <v:BarraCadastroView />
      <Button Grid.Column="1" Content="Duplicar perfil" Command="{Binding DuplicarCommand}" VerticalAlignment="Top"
              ToolTip.Tip="Inclui um perfil novo com as mesmas funções do selecionado." />
    </Grid>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Perfis de acesso" VerticalAlignment="Center" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do perfil selecionado (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    <v:MensagensView DockPanel.Dock="Bottom" />
    <ListBox Name="ListaPerfis" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PerfilLinha">
          <StackPanel>
            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Numero}" FontSize="11" Foreground="Gray" />
            <TextBlock Text="{Binding Resumo}" FontSize="11" Foreground="Gray" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
  </DockPanel>
</UserControl>
