<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels" xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.SuiteNavegacaoView" x:DataType="vm:SuiteViewModel">
  <!-- Navegação à esquerda aberta: B = módulos com as funções do módulo ativo agrupadas; C = busca, favoritos, recentes e árvore -->
  <UserControl.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
  </UserControl.Styles>
  <Border Name="Raiz" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Width="248">
    <DockPanel>
      <!-- cabeçalho: marca e Fixar/Ocultar -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="14,12,10,8">
        <Image Source="avares://Vorticis.Desktop.Comum/Assets/marca-vorticis.png" Width="30" Height="30" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Vorticis" FontSize="15" FontWeight="Bold" Foreground="#0F2A47" />
          <TextBlock Text="{Binding Nome}" Classes="su-sub" FontSize="10.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Classes="su" Padding="8,6" VerticalAlignment="Center" Command="{Binding AlternarFixaCommand}"
                ToolTip.Tip="Fixar: a navegação fica sempre aberta e empurra as telas. Ocultar: ela volta a abrir por cima ao passar o mouse">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{Binding IconeFixar}" Width="14" Height="14" Foreground="#475569" />
            <TextBlock Text="{Binding TextoFixar}" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Border DockPanel.Dock="Top" Height="1" Background="#EDF1F7" Margin="12,0" />

      <!-- B: módulos e funções do módulo ativo -->
      <ScrollViewer Name="ListaB" IsVisible="{Binding EhLateral}" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8">
        <ItemsControl ItemsSource="{Binding Modulos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModuloSuite">
              <StackPanel>
                <Button Classes="su" Classes.sel="{Binding Ativo}" Margin="8,2" ToolTip.Tip="{Binding NomeCompleto}"
                        Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).TrocarCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6,10,6">
                    <Border Width="3" Height="20" CornerRadius="2" Background="{Binding Cor}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="-8,0,0,0" IsVisible="{Binding Ativo}" />
                    <Panel Width="30" Height="30" Margin="4,0,0,0">
                      <Border CornerRadius="8" Background="{Binding Cor}" Opacity="0.14" />
                      <PathIcon Data="{Binding Icone}" Width="18" Height="18" Foreground="{Binding Cor}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding NomeCompleto}" Classes="su-titulo" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Classes="su-selo" IsVisible="{Binding TemAbertas}" ToolTip.Tip="Funções abertas neste módulo">
                      <TextBlock Text="{Binding Abertas}" />
                    </Border>
                  </Grid>
                </Button>
                <!-- funções do módulo em uso, agrupadas por categoria -->
                <ItemsControl ItemsSource="{Binding Linhas}" IsVisible="{Binding Ativo}" Margin="0,2,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoSuite">
                      <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding EhGrupo}" Margin="26,8,10,3">
                          <PathIcon Data="{Binding Icone}" Width="14" Height="14" Foreground="#7A8AA0" Margin="{Binding Recuo}" />
                          <TextBlock Text="{Binding Titulo}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" />
                        </StackPanel>
                        <Button Classes="su" IsVisible="{Binding EhFuncao}" Margin="30,0,8,0"
                                Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Titulo}" FontSize="12.5" Foreground="#1E293B" Margin="30,5,6,5" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- C: busca, favoritos, recentes e árvore -->
      <DockPanel Name="ListaC" IsVisible="{Binding EhArvore}" Margin="10,8,8,8">
        <Border DockPanel.Dock="Top" CornerRadius="8" Background="#F1F5F9" Padding="10,0" Margin="2,0,2,10">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{x:Static v:Icones.Magnify}" Width="15" Height="15" Foreground="#64748B" VerticalAlignment="Center" />
            <TextBox Name="CampoBusca" Grid.Column="1" Text="{Binding Busca}" Watermark="Ir para…  (Ctrl+K)" Background="Transparent"
                     BorderThickness="0" Padding="8,7" />
          </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- resultado da busca -->
            <ItemsControl ItemsSource="{Binding Resultados}" IsVisible="{Binding Buscando}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoSuite">
                  <Button Classes="su" Margin="0,1" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                    <StackPanel Margin="10,5" Spacing="1">
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="#0F172A" />
                      <TextBlock Text="{Binding Caminho}" Classes="su-sub" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding !Buscando}">
              <StackPanel IsVisible="{Binding TemFavoritos}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,4">
                  <PathIcon Data="{x:Static v:Icones.Star}" Width="12" Height="12" Foreground="#E0A100" />
                  <TextBlock Text="FAVORITOS" Classes="su-secao" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Favoritos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoSuite">
                      <Button Classes="su" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                          <Ellipse Width="7" Height="7" Fill="{Binding CorIcone}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Titulo}" Foreground="#1E293B" />
                          <TextBlock Text="{Binding Modulo.Nome}" Classes="su-sub" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel IsVisible="{Binding TemRecentes}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,4">
                  <PathIcon Data="{x:Static v:Icones.History}" Width="12" Height="12" Foreground="#7A8AA0" />
                  <TextBlock Text="RECENTES" Classes="su-secao" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Recentes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoSuite">
                      <Button Classes="su" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                          <Ellipse Width="7" Height="7" Fill="{Binding CorIcone}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Titulo}" Foreground="#1E293B" />
                          <TextBlock Text="{Binding Modulo.Nome}" Classes="su-sub" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="MÓDULOS E FUNÇÕES" Classes="su-secao" Margin="4,4,0,4" />
              <TreeView Name="ArvoreModulos" ItemsSource="{Binding Arvore}" Background="Transparent" Padding="0">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:NoSuite" ItemsSource="{Binding Filhos}">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="su" Padding="6,4" Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AbrirFuncaoCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{Binding Icone}" Width="16" Height="16" Foreground="{Binding CorIcone}" IsVisible="{Binding Icone, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" Foreground="#1E293B"
                                     FontWeight="{Binding EhModulo, Converter={x:Static v:Conversores.NegritoSe}}" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="su" Padding="6,4" IsVisible="{Binding EhFuncao}" ToolTip.Tip="Favorito"
                              Command="{Binding $parent[UserControl].((vm:SuiteViewModel)DataContext).AlternarFavoritoCommand}" CommandParameter="{Binding}">
                        <PathIcon Width="13" Height="13" Foreground="#E0A100"
                                  Data="{Binding Favorito, Converter={x:Static v:Conversores.EstrelaSe}}" />
                      </Button>
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Border>
</UserControl>
