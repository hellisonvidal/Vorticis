<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.FormasPagamentoView"
             x:DataType="vm:FormasPagamentoViewModel">
  <!-- Cadastros › Formas de pagamento: a tela mostra os cadastrados; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Formas de pagamento" VerticalAlignment="Center" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do selecionado (ou dê duplo clique / Enter na lista)" />
      <TextBlock Text="{Binding Lista.Count, StringFormat='{}{0} cadastrado(s)'}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TxSutil}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="Lista" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="0.5*" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="2*" />
        <DataGridTextColumn Header="Meio" Binding="{ReflectionBinding Meio}" Width="1.2*" />
        <DataGridTextColumn Header="Parcelas" Binding="{ReflectionBinding Parcelas}" Width="0.6*" />
        <DataGridTextColumn Header="Intervalo" Binding="{ReflectionBinding Intervalo}" Width="0.7*" />
        <DataGridTextColumn Header="Prazos (dias)" Binding="{ReflectionBinding Prazos}" Width="1.1*" />
        <DataGridTextColumn Header="Conta bancária" Binding="{ReflectionBinding Conta}" Width="1.3*" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="0.6*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
