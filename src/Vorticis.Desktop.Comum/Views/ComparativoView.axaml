<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             x:Class="Vorticis.Desktop.Comum.Views.ComparativoView"
             x:DataType="vm:ComparativoViewModel">
  <!-- "Comparar com anos anteriores" de todos os relatórios contábeis: o mesmo período em cada ano anterior, com a variação em R$ e %. -->
  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
    <CheckBox Name="CompararAnos" Content="Comparar com anos anteriores" IsChecked="{Binding Ativo}" FontWeight="SemiBold"
              ToolTip.Tip="O relatório sai com o período escolhido e o mesmo período de cada ano anterior (ex.: jan a jun de 2026 e de 2025), com a variação em R$ e em %." />
    <NumericUpDown Value="{Binding Anos}" Minimum="1" Maximum="5" FormatString="0" Width="100" IsVisible="{Binding Ativo}" />
    <TextBlock Text="ano(s)" VerticalAlignment="Center" IsVisible="{Binding Ativo}" />
  </StackPanel>
</UserControl>
