<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.Comum.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Comum.Views"
             x:Class="Vorticis.Desktop.Comum.Views.UsuariosView"
             x:DataType="vm:UsuariosViewModel">
  <!-- A tela mostra os usuários; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <v:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Usuários" VerticalAlignment="Center" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do usuário selecionado (ou dê duplo clique / Enter na lista)" />
      <TextBlock Text="{Binding Lista.Count, StringFormat='{}{0} usuário(s)'}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TxSutil}" />
    </StackPanel>
    <v:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaUsuarios" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="70" />
        <DataGridTextColumn Header="Login" Binding="{ReflectionBinding Login}" Width="140" />
        <DataGridTextColumn Header="Nome" Binding="{ReflectionBinding Nome}" Width="*" />
        <DataGridTextColumn Header="Cargo" Binding="{ReflectionBinding Cargo}" Width="130" />
        <DataGridTextColumn Header="E-mail" Binding="{ReflectionBinding Email}" Width="180" />
        <DataGridTextColumn Header="Telefone" Binding="{ReflectionBinding Telefone}" Width="120" />
        <DataGridTextColumn Header="Perfil" Binding="{ReflectionBinding Perfil}" Width="150" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="90" />
        <DataGridTextColumn Header="Último acesso" Binding="{ReflectionBinding UltimoAcesso}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
