<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.MutacoesView"
             x:DataType="vm:MutacoesViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="DMPL e DLPA" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" />
      <Button Content="Gerar" Command="{Binding GerarCommand}" Classes="accent" />
      <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
      <v:BarraExportacaoView />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,0">
      <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" />
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Modelos do CFC (NBC TG 26; Lei 6.404, art. 186). As contas do PL são enquadradas nas colunas pela descrição; as mutações vêm dos lançamentos do período, classificadas pela contrapartida. O lucro líquido é o da DRE e o saldo final confere com o Balanço." />
      <v:MensagensView />
    </StackPanel>
    <Grid RowDefinitions="Auto,*,12,Auto,*">
      <TextBlock Text="DEMONSTRAÇÃO DAS MUTAÇÕES DO PATRIMÔNIO LÍQUIDO (DMPL)" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <DataGrid Name="GradeDmpl" Grid.Row="1" ItemsSource="{Binding Dmpl}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,4,0,0" />
      <TextBlock Grid.Row="3" Text="DEMONSTRAÇÃO DE LUCROS OU PREJUÍZOS ACUMULADOS (DLPA)" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <DataGrid Grid.Row="4" ItemsSource="{Binding Dlpa}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,4,0,0" MaxWidth="760"
                HorizontalAlignment="Left">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="R$" Binding="{ReflectionBinding Valor}" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
