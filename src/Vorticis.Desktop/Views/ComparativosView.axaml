<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             x:Class="Vorticis.Desktop.Views.ComparativosView"
             x:DataType="vm:ComparativosViewModel">
  <!-- Relatórios › Comparativos: escolhe o relatório, o período atual e com o que comparar; a tabela sai com uma coluna por período -->
  <DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="10" LineSpacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Relatórios comparativos" VerticalAlignment="Center" />
      <ComboBox Name="RelatorioComparado" ItemsSource="{x:Static vm:ComparativosViewModel.Relatorios}" SelectedItem="{Binding Relatorio}" Width="290" />
      <TextBlock Text="{Binding RotuloData}" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" IsVisible="{Binding MostraInicio}" />
      <TextBlock Text="a" VerticalAlignment="Center" IsVisible="{Binding MostraInicio}" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" />
      <TextBlock Text="Nível" VerticalAlignment="Center" IsVisible="{Binding MostraNivel}" />
      <ComboBox ItemsSource="{x:Static vm:ComparativosViewModel.Niveis}" SelectedItem="{Binding Nivel}" Width="70" IsVisible="{Binding MostraNivel}" />
      <CheckBox Content="Incluir contas zeradas" IsChecked="{Binding IncluirZeradas}" IsVisible="{Binding MostraZeradas}" />
      <Button Content="Gerar" Command="{Binding GerarCommand}" Classes="accent" />
      <c:BarraExportacaoView />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBlock Text="{Binding Resumo}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
      <c:MensagensView />
    </StackPanel>
    <c:ComparativoView DockPanel.Dock="Top" DataContext="{Binding Comparacao}" />
    <c:GradeTabelaView Tabela="{Binding TabelaComparativa}" />
  </DockPanel>
</UserControl>
