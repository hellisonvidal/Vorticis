<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.DemonstracoesView"
             x:DataType="vm:DemonstracoesViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Balanço Patrimonial e DRE" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" />
      <TextBlock Text="Nível" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{x:Static vm:DemonstracoesViewModel.Niveis}" SelectedItem="{Binding Nivel}" Width="70" />
      <Button Content="Gerar" Command="{Binding GerarCommand}" Classes="accent" />
      <Rectangle Width="1" Fill="#D0D5DD" Margin="6,4" />
      <v:BarraExportacaoView />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" />
      <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                 Text="Estrutura conforme o plano de contas da empresa. A DRE desconsidera os lançamentos de encerramento. O enquadramento nas linhas da Lei 6.404 depende do mapeamento ao plano referencial (próxima etapa)." />
      <v:MensagensView />
    </StackPanel>
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*">
      <TextBlock Text="ATIVO" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <TextBlock Grid.Column="2" Text="PASSIVO E PATRIMÔNIO LÍQUIDO" FontWeight="SemiBold" Foreground="#1F3A5F" />
      <DataGrid Grid.Row="1" ItemsSource="{Binding Ativo}" IsReadOnly="True" AutoGenerateColumns="False" FontFamily="Consolas, Menlo, monospace">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
          <DataGridTextColumn Header="R$" Binding="{ReflectionBinding Valor}" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,Auto,*">
        <DataGrid ItemsSource="{Binding PassivoPl}" IsReadOnly="True" AutoGenerateColumns="False" FontFamily="Consolas, Menlo, monospace">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
            <DataGridTextColumn Header="R$" Binding="{ReflectionBinding Valor}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="DEMONSTRAÇÃO DO RESULTADO" FontWeight="SemiBold" Foreground="#1F3A5F" Margin="0,8,0,4" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Dre}" IsReadOnly="True" AutoGenerateColumns="False" FontFamily="Consolas, Menlo, monospace">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
            <DataGridTextColumn Header="R$" Binding="{ReflectionBinding Valor}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
