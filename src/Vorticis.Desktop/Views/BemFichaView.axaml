<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             xmlns:app="using:Vorticis.Application.Imobilizado"
             x:Class="Vorticis.Desktop.Views.BemFichaView"
             x:DataType="vm:BensViewModel">
  <!-- Ficha do bem (janela aberta pela tela Bens do imobilizado) -->
  <DockPanel>
    <c:RodapeFichaView DockPanel.Dock="Bottom" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="6" Margin="0,0,16,8">
        <TextBlock Text="Bem" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" />
        <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="Código" />
          <TextBox Grid.Column="1" Text="{Binding Codigo}" Width="80" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Descrição" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Descricao}" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Grupo" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Grupos}" SelectedItem="{Binding Grupo}" HorizontalAlignment="Stretch" PlaceholderText="Escolha o grupo">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="app:GrupoBem"><TextBlock Text="{Binding Descricao}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RegraFiscal}" FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="4" Classes="rotulo" Text="Plaqueta / local" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,6,*">
            <TextBox Text="{Binding Plaqueta}" Watermark="nº patrimônio" />
            <TextBox Grid.Column="2" Text="{Binding Localizacao}" Watermark="setor / local" />
          </Grid>
          <TextBlock Grid.Row="5" Classes="rotulo" Text="NF / fornecedor" />
          <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,6,*">
            <TextBox Text="{Binding NotaFiscal}" Watermark="nota fiscal" />
            <TextBox c:Pesquisa.Fonte="ParticipanteCodigo" Grid.Column="2" Text="{Binding Fornecedor}" Watermark="código do fornecedor" />
          </Grid>
          <TextBlock Grid.Row="6" Classes="rotulo" Text="Aquisição / uso" />
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <CalendarDatePicker SelectedDate="{Binding DataAquisicao}" Width="128" />
            <TextBlock Text="em uso" VerticalAlignment="Center" />
            <CalendarDatePicker SelectedDate="{Binding InicioUso}" Width="128" />
          </StackPanel>
          <TextBlock Grid.Row="7" Classes="rotulo" Text="Custo / residual" />
          <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,6,*">
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Valor}" Watermark="valor de aquisição" TextAlignment="Right" />
            <TextBox c:Mascara.Tipo="Valor" Grid.Column="2" Text="{Binding Residual}" Watermark="valor residual" TextAlignment="Right" />
          </Grid>
        </Grid>

        <TextBlock Text="Depreciação contábil (CPC 27) e fiscal" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="Vida útil (meses)" />
          <TextBox Grid.Column="1" Text="{Binding VidaUtil}" Width="80" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Método" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:OpcaoMetodo.Todos}" SelectedItem="{Binding Metodo}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OpcaoMetodo"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Turnos de uso" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Static vm:BensViewModel.OpcoesTurnos}" SelectedItem="{Binding Turnos}" Width="70" />
            <TextBlock Text="2 turnos: fiscal × 1,5 · 3 turnos: × 2,0" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
          </StackPanel>
          <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Depreciar a partir da data de aquisição, proporcional aos dias" IsChecked="{Binding ProRataDia}"
                    ToolTip.Tip="O primeiro mês deprecia só os dias desde a aquisição (inclusive); a fração que falta é lançada no mês seguinte ao fim da vida útil. Na baixa, deprecia os dias até a véspera." />
          <TextBlock Grid.Row="3" Classes="rotulo" Text="Já depreciado" />
          <TextBox c:Mascara.Tipo="Valor" Grid.Row="3" Grid.Column="1" Text="{Binding DepreciacaoAnterior}" Width="140" HorizontalAlignment="Left" TextAlignment="Right"
                   ToolTip.Tip="Depreciação acumulada antes de usar o Vorticis (implantação)" />
        </Grid>

        <TextBlock Text="Contas contábeis" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmEdicao}">
          <TextBlock Classes="rotulo" Text="Conta do bem" />
          <TextBox c:Pesquisa.Fonte="Conta" Grid.Column="1" Text="{Binding ContaBem}" Watermark="código ou reduzido" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Deprec. acumulada" />
          <TextBox c:Pesquisa.Fonte="Conta" Grid.Row="1" Grid.Column="1" Text="{Binding ContaAcumulada}" Watermark="código ou reduzido" />
          <TextBlock Grid.Row="2" Classes="rotulo" Text="Despesa" />
          <TextBox c:Pesquisa.Fonte="Conta" Grid.Row="2" Grid.Column="1" Text="{Binding ContaDespesa}" Watermark="código ou reduzido" />
        </Grid>

        <TextBlock Text="Baixa" FontWeight="SemiBold" Foreground="{DynamicResource TxTitulo}" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" RowSpacing="6" IsEnabled="{Binding EmAlteracao}">
          <TextBlock Classes="rotulo" Text="Data da baixa" />
          <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DataBaixa}" Width="135" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="rotulo" Text="Motivo" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MotivoBaixa}" Watermark="venda, perda, doação..." />
        </Grid>
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
