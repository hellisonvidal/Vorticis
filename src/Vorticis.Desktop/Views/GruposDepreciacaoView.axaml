<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.GruposDepreciacaoView"
             x:DataType="vm:GruposDepreciacaoViewModel">
  <!-- A tela mostra as regras de depreciação; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Regras de depreciação (grupos de bens)" VerticalAlignment="Center" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha da regra selecionada (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="Taxas fiscais: IN RFB 1.700/2017, Anexo III, e RIR/2018 arts. 317 a 330 (bens móveis em 2 ou 3 turnos: depreciação fiscal acelerada em 1,5 ou 2,0 — art. 323). Contabilmente (NBC TG 27 / CPC 27) a vida útil, o valor residual e o método de cada bem são estimados pela empresa; a vida útil fiscal é só a sugestão inicial. A diferença entre as duas é controlada no LALUR." />
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaGrupos" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Cód." Binding="{ReflectionBinding Codigo}" Width="56" />
        <DataGridTextColumn Header="Grupo" Binding="{ReflectionBinding Descricao}" Width="*" MinWidth="160" />
        <DataGridTextColumn Header="Taxa RFB" Binding="{ReflectionBinding Taxa}" Width="80" />
        <DataGridTextColumn Header="Vida útil fiscal" Binding="{ReflectionBinding VidaUtil}" Width="110" />
        <DataGridTextColumn Header="Contas (bem / acumulada / despesa)" Binding="{ReflectionBinding Contas}" Width="250" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
