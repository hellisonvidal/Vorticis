<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             xmlns:app="using:Vorticis.Application.Imobilizado"
             x:Class="Vorticis.Desktop.Views.BensView"
             x:DataType="vm:BensViewModel">
  <!-- A tela mostra os bens; Incluir, Alterar ou duplo clique abrem a ficha em janela -->
  <DockPanel Margin="8">
    <c:BarraCadastroView DockPanel.Dock="Top" Margin="0,0,0,8" />
    <Border DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding TemAvisoNota}" Background="{DynamicResource Realce}" BorderBrush="#9DB8E8" BorderThickness="1" CornerRadius="4" Padding="8">
      <TextBlock Text="{Binding AvisoNota}" TextWrapping="Wrap" Foreground="{DynamicResource TxTitulo}" />
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Bens do imobilizado" VerticalAlignment="Center" />
      <TextBox Text="{Binding Filtro}" Watermark="Filtrar: código, descrição ou plaqueta" Width="260" />
      <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do bem selecionado (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <DataGrid Name="ListaBens" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Cód." Binding="{ReflectionBinding Codigo}" Width="56" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="2*" MinWidth="150" />
        <DataGridTextColumn Header="Grupo" Binding="{ReflectionBinding Grupo}" Width="*" MinWidth="100" />
        <DataGridTextColumn Header="Aquisição" Binding="{ReflectionBinding Aquisicao}" Width="90" />
        <DataGridTextColumn Header="Custo" Binding="{ReflectionBinding Valor}" Width="92" />
        <DataGridTextColumn Header="Acumulada" Binding="{ReflectionBinding Acumulada}" Width="92" />
        <DataGridTextColumn Header="Saldo" Binding="{ReflectionBinding ValorContabil}" Width="92" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="*" MinWidth="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
