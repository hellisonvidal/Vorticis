<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.LancamentoDigitacaoView"
             x:DataType="vm:LancamentoViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rot">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TxSutil}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.nome">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TxTitulo}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBox.valor">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Border#Detalhes TextBox, Border#Detalhes AutoCompleteBox">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Border#Detalhes Button">
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </UserControl.Styles>

  <!-- Digitação na vertical: os campos do lançamento um embaixo do outro (com o nome da conta ao lado). "+ Mais partidas" acrescenta
       linhas compactas de débito/crédito logo abaixo da conta a crédito; o rodapé mostra só os totais e a diferença. A lupa (ou F4)
       nos campos de conta, histórico e centro de custo abre a pesquisa. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8,4,8,6">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
      <TextBlock Classes="titulo" Text="{Binding TituloDigitacao}" VerticalAlignment="Center" />
      <Border Background="{DynamicResource FundoAviso}" BorderBrush="{DynamicResource BordaAviso}" BorderThickness="1" CornerRadius="3" Padding="8,1" IsVisible="{Binding EmEdicao}">
        <TextBlock Text="{Binding TextoEdicao}" FontSize="11" Foreground="{DynamicResource TxAviso}" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <!-- Formulário do lançamento (Enter avança de campo; seta para baixo vai à próxima partida) -->
      <Border Name="Detalhes" Background="{DynamicResource FundoSuave}" BorderBrush="{DynamicResource Linha}" BorderThickness="1" CornerRadius="3" Padding="10,6" IsEnabled="{Binding PodeDigitar}" VerticalAlignment="Top">
        <Grid DataContext="{Binding Principal}" x:DataType="vm:LinhaLancamentoViewModel" ColumnDefinitions="130,Auto,*" RowSpacing="4"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="rot" Text="Data" />
          <TextBox Grid.Column="1" Tag="data" Text="{Binding Data}" c:Mascara.Tipo="Data" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="1" Text="Conta a débito (D)" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Tag="reduzido" Text="{Binding Reduzido}" Width="70" Watermark="Red." ToolTip.Tip="Código reduzido da conta" />
            <AutoCompleteBox Tag="conta" Text="{Binding Conta}" Width="220" Watermark="Código ou nome" c:Pesquisa.Fonte="ContaAnalitica"
                             ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                             FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                             ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <TextBlock Classes="nome" Grid.Row="1" Grid.Column="2" Text="{Binding NomeConta}" />

          <TextBlock Classes="rot" Grid.Row="2" Text="Conta a crédito (C)" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Tag="reduzidocredito" Text="{Binding ReduzidoCredito}" Width="70" Watermark="Red." ToolTip.Tip="Código reduzido da conta" />
            <AutoCompleteBox Tag="contacredito" Text="{Binding ContaCredito}" Width="220" Watermark="Código ou nome" c:Pesquisa.Fonte="ContaAnalitica"
                             ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                             FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                             ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <TextBlock Classes="nome" Grid.Row="2" Grid.Column="2" Text="{Binding NomeContaCredito}" />

          <!-- Mais partidas: linhas compactas (débito e/ou crédito, valor e histórico) do mesmo lançamento -->
          <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,2,0,2">
            <Button Content="+ Mais partidas" Command="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).NovaPartidaCommand}"
                    HorizontalAlignment="Left" Padding="10,3"
                    ToolTip.Tip="Acrescenta outra linha de débito e/ou crédito ao mesmo lançamento (lançamento com várias partidas)" />
            <TextBlock Classes="rot" IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TemExtras}"
                       Text="Mais partidas: débito (D) e/ou crédito (C), valor e histórico. Débitos e créditos precisam fechar." />
            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).Extras}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LinhaLancamentoViewModel">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,3">
                    <TextBlock Classes="rot" Text="D" />
                    <TextBox Grid.Column="1" Tag="reduzido" Text="{Binding Reduzido}" Width="56" Watermark="Red." MinHeight="28" />
                    <AutoCompleteBox Grid.Column="2" Tag="conta" Text="{Binding Conta}" Width="170" Watermark="Código ou nome" MinHeight="28" c:Pesquisa.Fonte="ContaAnalitica"
                                     ToolTip.Tip="{Binding NomeConta}"
                                     ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                     FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                                     ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                      <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                      </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <TextBlock Grid.Column="3" Classes="rot" Text="C" />
                    <TextBox Grid.Column="4" Tag="reduzidocredito" Text="{Binding ReduzidoCredito}" Width="56" Watermark="Red." MinHeight="28" />
                    <AutoCompleteBox Grid.Column="5" Tag="contacredito" Text="{Binding ContaCredito}" Width="170" Watermark="Código ou nome" MinHeight="28" c:Pesquisa.Fonte="ContaAnalitica"
                                     ToolTip.Tip="{Binding NomeContaCredito}"
                                     ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                     FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                                     ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                      <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                      </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                      <TextBox c:Mascara.Tipo="Valor" Tag="valor" Classes="valor" Text="{Binding Valor}" Width="110" Watermark="Valor" MinHeight="28" />
                      <TextBox Tag="historico" Text="{Binding Historico}" Width="230" Watermark="Histórico" MinHeight="28" />
                    </StackPanel>
                    <Button Grid.Column="7" Content="✕" Padding="8,2" ToolTip.Tip="Remover esta partida"
                            Command="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).RemoverPartidaCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="rot" Grid.Row="4" Text="Valor" />
          <TextBox c:Mascara.Tipo="Valor" Grid.Row="4" Grid.Column="1" Tag="valor" Classes="valor" Text="{Binding Valor}" Width="150" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="5" Text="Documento" />
          <TextBox Grid.Row="5" Grid.Column="1" Tag="documento" Text="{Binding Documento}" Width="150" HorizontalAlignment="Left" />

          <TextBlock Classes="rot" Grid.Row="6" Text="Histórico padrão" />
          <TextBox c:Pesquisa.Fonte="Historico" Grid.Row="6" Grid.Column="1" Tag="codhistorico" Text="{Binding CodigoHistorico}" Width="70" HorizontalAlignment="Left"
                   ToolTip.Tip="Código do histórico padrão (Cadastros › Históricos)" />

          <TextBlock Classes="rot" Grid.Row="7" Text="Histórico" />
          <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Tag="historico" Text="{Binding Historico}" />

          <TextBlock Classes="rot" Grid.Row="8" Text="Centro de custo" IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaCentroCusto}" />
          <TextBox c:Pesquisa.Fonte="CentroCusto" Grid.Row="8" Grid.Column="1" Tag="centrocusto" Text="{Binding CentroCusto}" Width="100" HorizontalAlignment="Left"
                   IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaCentroCusto}" />

          <TextBlock Classes="rot" Grid.Row="9" Text="Participante" IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}" />
          <TextBox c:Pesquisa.Fonte="ParticipanteCodigo" Grid.Row="9" Grid.Column="1" Tag="participante" Text="{Binding Participante}" Width="100" HorizontalAlignment="Left"
                   IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}"
                   ToolTip.Tip="Participante (cliente/fornecedor) — plano de contas com participantes" />
          <TextBlock Classes="nome" Grid.Row="9" Grid.Column="2" Text="{Binding NomeParticipante}"
                     IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}" />
        </Grid>
      </Border>
    </ScrollViewer>

    <!-- Rodapé: só os totais e a diferença (o lançamento só salva com débitos e créditos iguais) -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,2">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalDebito, StringFormat='Débitos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCredito, StringFormat='Créditos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Diferenca, StringFormat='Diferença: {0}'}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{Binding Balanceado, Converter={x:Static c:Conversores.OkOuErro}}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding MotivoEstorno}" Watermark="Motivo do estorno" Width="200" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoEstornar" Content="Estornar" Command="{Binding EstornarCommand}" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoLimpar" Content="Limpar" Command="{Binding LimparCommand}" IsVisible="{Binding PodeDigitar}" />
        <Button Name="BotaoCancelar" Content="{Binding SomenteLeitura, Converter={x:Static v:LancamentoDigitacaoView.RotuloFechar}}" Command="{Binding CancelarDigitacaoCommand}" IsCancel="True" />
        <Button Name="BotaoSalvar" Content="Salvar (Ctrl+S)" Command="{Binding SalvarCommand}" HotKey="Ctrl+S" Classes="accent" IsVisible="{Binding PodeDigitar}" />
      </StackPanel>
    </Grid>

    <c:MensagensView Grid.Row="3" />
  </Grid>
</UserControl>
