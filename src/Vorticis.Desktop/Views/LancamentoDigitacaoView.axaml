<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Desktop.Views"
             x:Class="Vorticis.Desktop.Views.LancamentoDigitacaoView"
             x:DataType="vm:LancamentoViewModel">
  <UserControl.Styles>
    <Style Selector="Border.linha">
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.linha:focus-within">
      <Setter Property="Background" Value="#E8F0FB" />
    </Style>
    <!-- Linhas com aparência de planilha: campos sem moldura, separados por uma linha fina -->
    <Style Selector="Border.linha TextBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.linha TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#3A6EA5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.linha TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#F5F8FC" />
    </Style>
    <Style Selector="Border.linha AutoCompleteBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.valor">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.cab">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#5A6478" />
      <Setter Property="Margin" Value="6,0,0,2" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,240" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,4,8,6">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,2">
      <TextBlock Classes="titulo" Text="{Binding TituloDigitacao}" VerticalAlignment="Center" />
      <Border Background="#FFF4CE" BorderBrush="#E0B000" BorderThickness="1" CornerRadius="3" Padding="8,1" IsVisible="{Binding EmEdicao}">
        <TextBlock Text="{Binding TextoEdicao}" FontSize="11" Foreground="#5A4500" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <!-- Detalhes do lançamento: cabeçalho e partida atual (contas com nome, centro de custo e participante) -->
    <Border Grid.Row="1" Name="Detalhes" Background="#F3F6FA" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,2,0,4">
      <StackPanel Spacing="2" DataContext="{Binding LinhaSelecionada}" x:DataType="vm:LinhaLancamentoViewModel">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding Data, StringFormat='Data: {0}'}" />
          <TextBlock Text="{Binding Documento, StringFormat='Documento: {0}'}" />
          <TextBlock Text="{Binding CodigoHistorico, StringFormat='Histórico padrão: {0}'}" />
          <TextBlock Text="{Binding Historico, StringFormat='Complemento: {0}'}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding NomeConta, StringFormat='Débito (D): {0}'}" />
          <TextBlock Text="{Binding NomeContaCredito, StringFormat='Crédito (C): {0}'}" />
          <TextBlock Text="{Binding Valor, StringFormat='Valor: {0}'}" />
          <TextBlock Text="{Binding CentroCusto, StringFormat='Centro de custo: {0}'}" />
          <TextBlock Text="{Binding NomeParticipante, StringFormat='Participante: {0}'}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Cabeçalhos (mesmas larguras das linhas) -->
    <Grid Grid.Row="2" ColumnDefinitions="84,46,130,46,130,92,76,40,*,58,Auto">
      <TextBlock Classes="cab" Text="Data" />
      <TextBlock Classes="cab" Grid.Column="1" Text="Red. D" />
      <TextBlock Classes="cab" Grid.Column="2" Text="Conta débito" />
      <TextBlock Classes="cab" Grid.Column="3" Text="Red. C" />
      <TextBlock Classes="cab" Grid.Column="4" Text="Conta crédito" />
      <TextBlock Classes="cab" Grid.Column="5" Text="Valor" HorizontalAlignment="Right" Margin="0,0,8,2" />
      <TextBlock Classes="cab" Grid.Column="6" Text="Documento" />
      <TextBlock Classes="cab" Grid.Column="7" Text="Hist." />
      <TextBlock Classes="cab" Grid.Column="8" Text="Histórico" />
      <TextBlock Classes="cab" Grid.Column="9" Text="C. custo" />
      <TextBlock Classes="cab" Grid.Column="10" Text="Part." Width="56" IsVisible="{Binding UsaParticipantes}"
                 ToolTip.Tip="Participante (cliente/fornecedor) — plano de contas com participantes" />
    </Grid>

    <!-- Uma linha com débito e crédito é um lançamento; linhas com uma conta só somam um lançamento único -->
    <ScrollViewer Grid.Row="3" Name="Rolagem" IsEnabled="{Binding PodeDigitar}">
      <ItemsControl Name="LinhasLancamento" ItemsSource="{Binding Linhas}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LinhaLancamentoViewModel">
            <Border Classes="linha">
              <Grid ColumnDefinitions="84,46,130,46,130,92,76,40,*,58,Auto">
                <TextBox Tag="data" Text="{Binding Data}" c:Mascara.Tipo="Data" />
                <TextBox Grid.Column="1" Tag="reduzido" Text="{Binding Reduzido}" />
                  <AutoCompleteBox Grid.Column="2" Tag="conta" Text="{Binding Conta}" ToolTip.Tip="{Binding NomeConta}"
                                   ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                   FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                                   ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                <TextBox Grid.Column="3" Tag="reduzidocredito" Text="{Binding ReduzidoCredito}" />
                  <AutoCompleteBox Grid.Column="4" Tag="contacredito" Text="{Binding ContaCredito}" ToolTip.Tip="{Binding NomeContaCredito}"
                                   ItemsSource="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).TodasContas}"
                                   FilterMode="Custom" ItemFilter="{x:Static v:LancamentoDigitacaoView.FiltroConta}"
                                   ValueMemberBinding="{ReflectionBinding Codigo}" MinimumPrefixLength="2" MaxDropDownHeight="260">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContaSelecionavel"><TextBlock Text="{Binding Rotulo}" FontFamily="Consolas, Menlo, monospace" /></DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                <TextBox Grid.Column="5" Tag="valor" Classes="valor" Text="{Binding Valor}" />
                <TextBox Grid.Column="6" Tag="documento" Text="{Binding Documento}" />
                <TextBox Grid.Column="7" Tag="codhistorico" Text="{Binding CodigoHistorico}" />
                <TextBox Grid.Column="8" Tag="historico" Text="{Binding Historico}" />
                <TextBox Grid.Column="9" Tag="centrocusto" Text="{Binding CentroCusto}" />
                <TextBox Grid.Column="10" Tag="participante" Text="{Binding Participante}" Width="56"
                         IsVisible="{Binding $parent[UserControl].((vm:LancamentoViewModel)DataContext).UsaParticipantes}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,4">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalDebito, StringFormat='Débitos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCredito, StringFormat='Créditos: {0}'}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Diferenca, StringFormat='Diferença: {0}'}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{Binding Balanceado, Converter={x:Static c:Conversores.OkOuErro}}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Margin="16,0" FontSize="12" Foreground="#1F3A5F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Text="{Binding LinhaSelecionada.ResumoContas}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding MotivoEstorno}" Watermark="Motivo do estorno" Width="200" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoEstornar" Content="Estornar" Command="{Binding EstornarCommand}" IsVisible="{Binding SomenteLeitura}" />
        <Button Name="BotaoLimpar" Content="Limpar" Command="{Binding LimparCommand}" IsVisible="{Binding PodeDigitar}" />
        <Button Name="BotaoCancelar" Content="{Binding SomenteLeitura, Converter={x:Static v:LancamentoDigitacaoView.RotuloFechar}}" Command="{Binding CancelarDigitacaoCommand}" IsCancel="True" />
        <Button Name="BotaoSalvar" Content="Salvar (Ctrl+S)" Command="{Binding SalvarCommand}" HotKey="Ctrl+S" Classes="accent" IsVisible="{Binding PodeDigitar}" />
      </StackPanel>
    </Grid>

    <c:MensagensView Grid.Row="5" />

    <DockPanel Grid.Column="1" Grid.RowSpan="6" Margin="10,0,0,0" IsEnabled="{Binding PodeDigitar}">
      <TextBlock DockPanel.Dock="Top" Text="Contas analíticas" FontWeight="SemiBold"
                 ToolTip.Tip="Clique numa conta para preenchê-la na linha atual" />
      <TextBox DockPanel.Dock="Top" Text="{Binding FiltroConta}" Watermark="Filtrar: reduzido, código ou nome" Margin="0,4" />
      <ListBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionada}" Focusable="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ContaSelecionavel">
            <TextBlock Text="{Binding Rotulo}" FontSize="11.5" FontFamily="Consolas, Menlo, monospace" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
