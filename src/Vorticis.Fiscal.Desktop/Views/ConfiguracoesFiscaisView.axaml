<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.ConfiguracoesFiscaisView"
             x:DataType="vm:ConfiguracoesFiscaisViewModel">
  <!-- Cadastros › Configurações fiscais da empresa -->
  <StackPanel Margin="8" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
    <TextBlock Classes="titulo" Text="Configurações fiscais da empresa" />
    <CheckBox Content="Usar centros de custo no fiscal" IsChecked="{Binding UsaCentroCusto}" IsEnabled="{Binding PodeManter}" />
    <TextBlock FontSize="12" Foreground="#44506A" TextWrapping="Wrap"
               Text="Com esta opção, as notas digitadas aceitam centro de custo no documento e nos itens, e a contabilização leva o centro de custo para as partidas (débito nas entradas, crédito nas saídas). Exige que a empresa use centros de custo (Cadastros › Empresas, aba Contabilidade)." />
    <TextBlock Text="Esta empresa ainda não usa centros de custo no cadastro da empresa." Foreground="#B42318" IsVisible="{Binding !EmpresaUsaCentroCusto}" />
    <Button Content="Salvar" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeManter}" Classes="accent" HorizontalAlignment="Left" />
    <c:MensagensView />
  </StackPanel>
</UserControl>
