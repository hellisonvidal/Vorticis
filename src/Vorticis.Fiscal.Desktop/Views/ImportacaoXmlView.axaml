<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.ImportacaoXmlView"
             x:DataType="vm:ImportacaoXmlViewModel">
  <!-- Documentos fiscais › Importação de XML -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="{Binding Titulo}" />
      <TextBlock FontSize="12" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" Text="{Binding Descricao}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Importar arquivos..." Click="EscolherArquivos" IsEnabled="{Binding PodeIniciar}" Classes="accent" />
        <TextBlock Text="ou pasta:" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox Text="{Binding Pasta}" Width="380" Watermark="C:\XML\NotasFiscais" />
        <Button Content="Procurar..." Click="EscolherPasta" IsEnabled="{Binding !Importando}" />
        <CheckBox Content="Incluir subpastas" IsChecked="{Binding IncluirSubpastas}" />
        <Button Content="Importar pasta" Command="{Binding ImportarPastaCommand}" IsEnabled="{Binding PodeIniciar}" />
      </StackPanel>
      <c:MensagensView />
    </StackPanel>
    <g:PainelImportacaoView />
  </DockPanel>
</UserControl>
