<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.ImportacaoXmlView"
             x:DataType="vm:ImportacaoXmlViewModel">
  <!-- Documentos fiscais › Importação de XML -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Importação de XML de notas fiscais" />
      <TextBlock FontSize="12" Foreground="#44506A" TextWrapping="Wrap"
                 Text="Importe NF-e e NFC-e (modelos 55 e 65, procNFe) e NFS-e do padrão nacional (ADN), em arquivos .xml ou .zip. Notas emitidas pela empresa são saídas; notas em que ela é destinatária/tomadora são entradas. Notas de outras empresas são recusadas, chaves já importadas são ignoradas, eventos de cancelamento atualizam a nota e clientes/fornecedores novos são cadastrados." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Importar arquivos..." Click="EscolherArquivos" IsEnabled="{Binding PodeImportar}" Classes="accent" />
        <TextBlock Text="ou pasta:" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox Text="{Binding Pasta}" Width="380" Watermark="C:\XML\NotasFiscais" />
        <Button Content="Procurar..." Click="EscolherPasta" />
        <CheckBox Content="Incluir subpastas" IsChecked="{Binding IncluirSubpastas}" />
        <Button Content="Importar pasta" Command="{Binding ImportarPastaCommand}" IsEnabled="{Binding PodeImportar}" />
      </StackPanel>
      <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" />
      <c:MensagensView />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Resultados}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Arquivo" Binding="{ReflectionBinding Arquivo}" Width="220" />
        <DataGridTextColumn Header="Resultado" Binding="{ReflectionBinding Situacao}" Width="110" />
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="80" />
        <DataGridTextColumn Header="Operação" Binding="{ReflectionBinding Operacao}" Width="80" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="110" />
        <DataGridTextColumn Header="Mensagem" Binding="{ReflectionBinding Mensagem}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
