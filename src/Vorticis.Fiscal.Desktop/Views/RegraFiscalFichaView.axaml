<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.RegraFiscalFichaView"
             x:DataType="vm:RegrasFiscaisViewModel">
  <!-- Ficha da regra fiscal, aberta em janela pela tela Regras fiscais -->
  <DockPanel>
    <c:RodapeFichaSimplesView DockPanel.Dock="Bottom" SalvarCommand="{Binding SalvarCommand}" SalvarTexto="Salvar" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="8" Margin="0,0,16,8">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6" IsEnabled="{Binding PodeManter}">
          <TextBlock Text="Tipo" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:RegrasFiscaisViewModel.Operacoes}" SelectedIndex="{Binding Operacao}" Width="230" />
          <TextBlock Grid.Column="2" Text="Descrição" VerticalAlignment="Center" />
          <TextBox Grid.Column="3" Text="{Binding Descricao}" Width="260" />
          <TextBlock Grid.Column="4" Text="Ordem" VerticalAlignment="Center" />
          <TextBox Grid.Column="5" Text="{Binding Ordem}" Width="70" />
          <TextBlock Grid.Row="1" Text="Quando" VerticalAlignment="Center" />
          <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
            <TextBox c:Pesquisa.Fonte="Cfop" Text="{Binding CfopOrigem}" Watermark="CFOP do emitente" Width="130" Margin="0,0,6,0" />
            <TextBox c:Pesquisa.Fonte="Participante" Text="{Binding Participante}" Watermark="Fornecedor/cliente (nome ou CNPJ)" Width="240" Margin="0,0,6,0" />
            <TextBox c:Pesquisa.Fonte="Ncm" Text="{Binding Ncm}" Watermark="NCM ou início" Width="120" Margin="0,0,6,0" />
            <TextBox c:Pesquisa.Fonte="Produto" Text="{Binding Produto}" Watermark="Produto (código ou descrição)" Width="220" Margin="0,0,6,0" />
            <TextBox Text="{Binding CstOrigem}" Watermark="CST/CSOSN do XML" Width="130" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{x:Static vm:RegrasFiscaisViewModel.Destinos}" SelectedIndex="{Binding Destino}" Width="150" ToolTip.Tip="Só para regras de saída" />
          </WrapPanel>
          <TextBlock Grid.Row="2" Text="Então" VerticalAlignment="Center" />
          <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5">
            <TextBox c:Pesquisa.Fonte="Cfop" Text="{Binding CfopDestino}" Watermark="CFOP a usar" Width="110" Margin="0,0,6,0" />
            <TextBox Text="{Binding CstDestino}" Watermark="CST/CSOSN a usar" Width="130" Margin="0,0,14,0" />
            <CheckBox Content="Credita ICMS" IsChecked="{Binding CreditaIcms}" />
            <CheckBox Content="Credita IPI" IsChecked="{Binding CreditaIpi}" />
            <CheckBox Content="Credita PIS" IsChecked="{Binding CreditaPis}" />
            <CheckBox Content="Credita COFINS" IsChecked="{Binding CreditaCofins}" />
            <CheckBox Content="Credita IBS/CBS" IsChecked="{Binding CreditaIbsCbs}" Margin="0,0,14,0"
                      ToolTip.Tip="Reforma tributária: o IBS e a CBS do item entram como crédito (desmarque para uso e consumo pessoal)." />
            <TextBox Text="{Binding CstIbsCbs}" Watermark="CST IBS/CBS" Width="110" MaxLength="3" Margin="0,0,6,0" />
            <TextBox Text="{Binding ClassTrib}" Watermark="Classificação (cClassTrib)" Width="180" MaxLength="6" />
          </WrapPanel>
          <TextBlock Grid.Row="3" Text="Contabilização" VerticalAlignment="Center" />
          <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5">
            <TextBox c:Pesquisa.Fonte="Conta" Text="{Binding ContaDebito}" Watermark="Conta de débito (código)" Width="190" Margin="0,0,6,0" />
            <TextBox c:Pesquisa.Fonte="Conta" Text="{Binding ContaCredito}" Watermark="Conta de crédito (código)" Width="190" Margin="0,0,14,0" />
            <CheckBox Content="Regra ativa" IsChecked="{Binding Ativa}" />
          </WrapPanel>
        </Grid>
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
