<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.NotaDigitacaoView"
             x:DataType="vm:DigitacaoDocumentoViewModel"
             c:Teclado.EnterAvanca="True">
  <UserControl.Styles>
    <Style Selector="TextBlock.rot"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="{DynamicResource TxSutil}" /><Setter Property="Margin" Value="2,0,0,1" /></Style>
    <Style Selector="TextBlock.grupo"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TxTitulo}" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style Selector="StackPanel.campo"><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <Style Selector="StackPanel.campo TextBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo ComboBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo CalendarDatePicker"><Setter Property="MinHeight" Value="26" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.mini"><Setter Property="Padding" Value="8,3" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="DataGrid"><Setter Property="FontSize" Value="12" /><Setter Property="RowHeight" Value="24" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,5" /></Style>
  </UserControl.Styles>
  <!-- Pop-up da nota: Nota (cabeçalho), Itens, Tributos, Parcelas e Escrituração no mesmo TabControl. Cabe em 1366x768. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,4,8,6">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="titulo" Text="{Binding TituloPopup}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding SituacaoDocumento}" FontWeight="SemiBold" Foreground="{DynamicResource TxAviso}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Avisos e importação para conferência (arquivo XML ou chave de acesso) -->
    <StackPanel Grid.Row="1" Spacing="3" Margin="0,3,0,3">
      <Border IsVisible="{Binding MostraMotivoSomenteLeitura}" Background="{DynamicResource FundoErro}" BorderBrush="{DynamicResource BordaErro}" BorderThickness="1" Padding="8,3" CornerRadius="4">
        <TextBlock Text="{Binding MotivoSomenteLeitura}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TxErroForte}" />
      </Border>
      <Border IsVisible="{Binding Importada}" Background="{DynamicResource FundoAviso}" BorderBrush="{DynamicResource BordaAviso}" BorderThickness="1" Padding="8,3" CornerRadius="4">
        <TextBlock Text="{Binding AvisoImportada}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TxAviso}" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeEditar}">
        <TextBlock Text="Importar por XML:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
        <Button Name="BotaoXml" Classes="mini" Content="Escolher arquivo..." Click="ImportarXml"
                ToolTip.Tip="Lê o XML de uma nota e preenche os campos para você conferir antes de gravar" />
        <TextBlock Text="Por chave de acesso:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="14,0,0,0" />
        <TextBox Name="CampoChave" Text="{Binding ChaveImportacao}" Width="370" MinHeight="26" Padding="5,2" FontSize="12" Watermark="Chave de acesso da NF-e (44 dígitos)" MaxLength="60" />
        <Button Name="BotaoChave" Classes="mini accent" Content="Importar por chave" Command="{Binding ImportarChaveCommand}"
                ToolTip.Tip="Procura a nota entre os XMLs já importados; se não houver, baixa na SEFAZ (Ambiente Nacional) com o certificado digital da empresa" />
        <Button Classes="mini" Content="Manifestar ciência" Command="{Binding ManifestarCienciaCommand}" IsVisible="{Binding PodeManifestar}"
                ToolTip.Tip="Registra a Ciência da operação (manifestação do destinatário), que libera o XML completo" />
      </StackPanel>
      <c:MensagensView />
    </StackPanel>


    <TabControl Name="Abas" Grid.Row="3">
      <!-- ============================== NOTA ============================== -->
      <TabItem Header="Nota">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6" Margin="0,4">
            <Border BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="6,4" CornerRadius="4">
              <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" IsEnabled="{Binding PodeEditar}">
                <StackPanel Grid.Row="0" Grid.Column="0" Classes="campo"><TextBlock Classes="rot" Text="Modelo" />
                  <ComboBox ItemsSource="{x:Static vm:DigitacaoDocumentoViewModel.Modelos}" SelectedIndex="{Binding Modelo}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Classes="campo"><TextBlock Classes="rot" Text="Série" /><TextBox Text="{Binding Serie}" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Classes="campo"><TextBlock Classes="rot" Text="Número" /><TextBox Name="CampoNumero" Text="{Binding Numero}" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Classes="campo"><TextBlock Classes="rot" Text="Emissão" /><CalendarDatePicker SelectedDate="{Binding Emissao}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Classes="campo"><TextBlock Classes="rot" Text="{Binding RotuloData}" /><CalendarDatePicker SelectedDate="{Binding DataLivro}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="campo"><TextBlock Classes="rot" Text="{Binding RotuloParticipante}" />
                  <TextBox Name="CampoParticipante" Text="{Binding Participante}" Watermark="CNPJ/CPF (busca automática), código ou nome" LostFocus="ParticipanteSaiu" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="campo"><TextBlock Classes="rot" Text="Natureza da operação" /><TextBox Text="{Binding Natureza}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Classes="campo"><TextBlock Classes="rot" Text="Chave de acesso (opcional)" /><TextBox Text="{Binding Chave}" /></StackPanel>
                <Button Grid.Row="2" Grid.Column="0" Classes="mini" Content="Buscar participante" Command="{Binding BuscarParticipanteCommand}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding ParticipanteInfo}" FontSize="12" Foreground="{DynamicResource TxTitulo}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <!-- Participante novo (CPF/CNPJ não cadastrado): conferido antes de cadastrar ao gravar a nota -->
            <Border IsVisible="{Binding TemNovoParticipante}" BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="6,4" CornerRadius="4">
              <Grid ColumnDefinitions="3*,0.6*,1.6*,1.4*" IsEnabled="{Binding PodeEditar}">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Nome / razão social (será cadastrado)" /><TextBox Text="{Binding NovoNome}" /></StackPanel>
                <StackPanel Grid.Column="1" Classes="campo"><TextBlock Classes="rot" Text="UF" /><TextBox Text="{Binding NovoUf}" MaxLength="2" /></StackPanel>
                <StackPanel Grid.Column="2" Classes="campo"><TextBlock Classes="rot" Text="Município" /><TextBox Text="{Binding NovoMunicipio}" /></StackPanel>
                <StackPanel Grid.Column="3" Classes="campo"><TextBlock Classes="rot" Text="Inscrição estadual" /><TextBox Text="{Binding NovoIe}" /></StackPanel>
              </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="6,4" CornerRadius="4" IsEnabled="{Binding PodeEditar}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Total informado (confere com os itens)" /><TextBox Text="{Binding TotalInformado}" Width="200" /></StackPanel>
                <TextBlock Text="Deixe em branco para usar a soma dos itens." FontSize="11" Foreground="{DynamicResource TxSutil}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== ITENS ============================== -->
      <TabItem Header="Itens">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,4">
          <Border BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="6,4" CornerRadius="4">
            <StackPanel Spacing="3" IsEnabled="{Binding PodeEditar}">
              <Grid ColumnDefinitions="1.3*,2.6*,0.8*,0.9*,1.1*,Auto">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Produto (código, descrição ou GTIN)" /><TextBox Name="CampoProduto" Text="{Binding Item.Produto}" /></StackPanel>
                <StackPanel Grid.Column="1" Classes="campo"><TextBlock Classes="rot" Text="Descrição" /><TextBox Text="{Binding Item.Descricao}" /></StackPanel>
                <StackPanel Grid.Column="2" Classes="campo"><TextBlock Classes="rot" Text="CFOP" /><TextBox Text="{Binding Item.Cfop}" /></StackPanel>
                <StackPanel Grid.Column="3" Classes="campo"><TextBlock Classes="rot" Text="Quantidade" /><TextBox Text="{Binding Item.Quantidade}" /></StackPanel>
                <StackPanel Grid.Column="4" Classes="campo"><TextBlock Classes="rot" Text="Valor unitário" /><TextBox Text="{Binding Item.Unitario}" /></StackPanel>
                <Button Grid.Column="5" Classes="mini" Content="Buscar produto" Command="{Binding BuscarProdutoCommand}" VerticalAlignment="Bottom" Height="26" />
              </Grid>
              <UniformGrid Columns="9">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="NCM" /><TextBox Text="{Binding Item.Ncm}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CEST" /><TextBox Text="{Binding Item.Cest}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Un." /><TextBox Text="{Binding Item.Unidade}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Orig." /><TextBox Text="{Binding Item.Origem}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Desconto" /><TextBox Text="{Binding Item.Desconto}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Frete" /><TextBox Text="{Binding Item.Frete}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Seguro" /><TextBox Text="{Binding Item.Seguro}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Outras desp." /><TextBox Text="{Binding Item.Outras}" /></StackPanel>
                <StackPanel Classes="campo" IsVisible="{Binding MostraCentro}"><TextBlock Classes="rot" Text="Centro de custo" />
                  <ComboBox ItemsSource="{Binding Centros}" SelectedItem="{Binding CentroItem}" HorizontalAlignment="Stretch" /></StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,4">
            <Button Classes="mini accent" Content="Adicionar item" Command="{Binding AdicionarItemCommand}" IsEnabled="{Binding PodeEditar}" />
            <Button Classes="mini" Content="Atualizar item selecionado" Command="{Binding AtualizarItemCommand}" IsEnabled="{Binding PodeEditar}" />
            <Button Classes="mini" Content="Remover item selecionado" Command="{Binding RemoverItemCommand}" IsEnabled="{Binding PodeEditar}" />
            <TextBlock Text="Os tributos do item ficam na aba Tributos." FontSize="11" Foreground="{DynamicResource TxSutil}" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid Grid.Row="2" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Itens}" SelectedItem="{Binding ItemSelecionado, Mode=OneWay}" SelectionChanged="AoSelecionarItem" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{ReflectionBinding N}" Width="65" />
              <DataGridTextColumn Header="Produto" Binding="{ReflectionBinding Produto}" Width="85" />
              <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" MinWidth="140" />
              <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding Cfop}" Width="70" />
              <DataGridTextColumn Header="CFOP escrit." Binding="{ReflectionBinding CfopEscrituracao}" Width="100" />
              <DataGridTextColumn Header="Produto vinculado" Binding="{ReflectionBinding Vinculo}" Width="170" />
              <DataGridTextColumn Header="Qtde" Binding="{ReflectionBinding Quantidade}" Width="80" />
              <DataGridTextColumn Header="Unitário" Binding="{ReflectionBinding Unitario}" Width="100" />
              <DataGridTextColumn Header="Total" Binding="{ReflectionBinding Total}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ============================== TRIBUTOS ============================== -->
      <TabItem Header="Tributos">
        <Grid RowDefinitions="Auto,*" Margin="0,4">
          <DataGrid Height="120" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Itens}" SelectedItem="{Binding ItemSelecionado, Mode=OneWay}" SelectionChanged="AoSelecionarItem" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{ReflectionBinding N}" Width="65" />
              <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" MinWidth="150" />
              <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding CfopNota}" Width="80" />
              <DataGridTextColumn Header="CST/CSOSN" Binding="{ReflectionBinding CstIcms}" Width="105" />
              <DataGridTextColumn Header="Base" Binding="{ReflectionBinding BcIcms}" Width="90" />
              <DataGridTextColumn Header="Alíq." Binding="{ReflectionBinding AliqIcms}" Width="65" />
              <DataGridTextColumn Header="ICMS" Binding="{ReflectionBinding Icms}" Width="90" />
              <DataGridTextColumn Header="ICMS-ST" Binding="{ReflectionBinding IcmsSt}" Width="100" />
              <DataGridTextColumn Header="IPI" Binding="{ReflectionBinding Ipi}" Width="80" />
              <DataGridTextColumn Header="PIS" Binding="{ReflectionBinding Pis}" Width="80" />
              <DataGridTextColumn Header="COFINS" Binding="{ReflectionBinding Cofins}" Width="95" />
              <DataGridTextColumn Header="ISS" Binding="{ReflectionBinding Iss}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="2" Margin="0,4" IsEnabled="{Binding PodeEditar}">
              <TextBlock Classes="grupo" Text="ICMS e ICMS-ST do item selecionado (base × alíquota recalcula o valor; o valor pode ser corrigido à mão)" />
              <UniformGrid Columns="8">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CFOP" /><TextBox Name="CampoCfopTrib" Text="{Binding Item.Cfop}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CST/CSOSN" /><TextBox Text="{Binding Item.CstIcms}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base ICMS" /><TextBox Name="CampoBcIcms" Text="{Binding Item.BcIcms}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Alíq. ICMS %" /><TextBox Name="CampoAliqIcms" Text="{Binding Item.AliqIcms}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="ICMS" /><TextBox Name="CampoIcms" Text="{Binding Item.Icms}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base ICMS-ST" /><TextBox Text="{Binding Item.BcIcmsSt}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="ICMS-ST" /><TextBox Text="{Binding Item.IcmsSt}" /></StackPanel>
              </UniformGrid>
              <TextBlock Classes="grupo" Text="IPI" />
              <UniformGrid Columns="8">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CST IPI" /><TextBox Text="{Binding Item.CstIpi}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base IPI" /><TextBox Text="{Binding Item.BcIpi}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Alíq. IPI %" /><TextBox Text="{Binding Item.AliqIpi}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="IPI" /><TextBox Text="{Binding Item.Ipi}" /></StackPanel>
              </UniformGrid>
              <TextBlock Classes="grupo" Text="PIS e COFINS" />
              <UniformGrid Columns="8">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CST PIS" /><TextBox Text="{Binding Item.CstPis}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base PIS" /><TextBox Text="{Binding Item.BcPis}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Alíq. PIS %" /><TextBox Text="{Binding Item.AliqPis}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="PIS" /><TextBox Text="{Binding Item.Pis}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CST COFINS" /><TextBox Text="{Binding Item.CstCofins}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base COFINS" /><TextBox Text="{Binding Item.BcCofins}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Alíq. COFINS %" /><TextBox Text="{Binding Item.AliqCofins}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="COFINS" /><TextBox Text="{Binding Item.Cofins}" /></StackPanel>
              </UniformGrid>
              <TextBlock Classes="grupo" Text="ISS (serviço)" />
              <UniformGrid Columns="8">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Base ISS" /><TextBox Text="{Binding Item.BcIss}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Alíq. ISS %" /><TextBox Text="{Binding Item.AliqIss}" /></StackPanel>
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="ISS" /><TextBox Text="{Binding Item.Iss}" /></StackPanel>
              </UniformGrid>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <Button Classes="mini" Content="Calcular tributos" Command="{Binding CalcularTributosCommand}" ToolTip.Tip="Preenche base e valor dos tributos que têm alíquota e valor em branco" />
                <Button Classes="mini accent" Content="Aplicar ao item" Command="{Binding AtualizarItemCommand}" ToolTip.Tip="Grava no item selecionado os tributos digitados e recalcula os totais da nota" />
                <Button Classes="mini" Content="Adicionar como novo item" Command="{Binding AdicionarItemCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============================== PARCELAS ============================== -->
      <TabItem Header="Parcelas">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,4">
            <TextBlock Text="Escolha a forma de pagamento (Cadastros › Formas de pagamento) e as duplicatas são geradas pelos prazos dela, a partir da emissão. Sem forma e sem parcelas, a nota nova gera uma duplicata à vista (Cadastros › Parâmetros). Para parcelar à mão, informe a quantidade, o primeiro vencimento e o intervalo e use Gerar parcelas."
                       FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeEditar}">
              <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Forma de pagamento" />
                <ComboBox ItemsSource="{Binding FormasPagamento}" SelectedItem="{Binding FormaPagamento}" DisplayMemberBinding="{ReflectionBinding Texto}" MinWidth="280" /></StackPanel>
              <Button Classes="mini" Content="Gerar pela forma" Command="{Binding GerarPelaFormaCommand}" VerticalAlignment="Bottom" Height="26" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding PodeEditar}">
              <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Nº de parcelas" /><TextBox Text="{Binding ParcelasQuantidade}" Width="80" /></StackPanel>
              <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Primeiro vencimento" /><CalendarDatePicker SelectedDate="{Binding ParcelasPrimeiroVencimento}" Width="135" /></StackPanel>
              <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Intervalo (dias)" /><TextBox Text="{Binding ParcelasIntervalo}" Width="80" /></StackPanel>
              <Button Classes="mini" Content="Gerar parcelas" Command="{Binding GerarParcelasCommand}" VerticalAlignment="Bottom" Height="26" />
              <Button Classes="mini" Content="Limpar parcelas" Command="{Binding LimparParcelasCommand}" VerticalAlignment="Bottom" Height="26" />
            </StackPanel>
            <DataGrid g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Parcelas}" IsReadOnly="True" AutoGenerateColumns="False" Height="200" HorizontalAlignment="Left" Width="480">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Parcela" Binding="{ReflectionBinding Numero}" Width="100" />
                <DataGridTextColumn Header="Vencimento" Binding="{ReflectionBinding VencimentoTexto}" Width="125" />
                <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding ValorTexto}" Width="115" />
                <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== ESCRITURAÇÃO ============================== -->
      <TabItem Header="Escrituração">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,4" IsEnabled="{Binding PodeEditarEscrituracao}">
            <TextBlock Text="CFOP de entrada, produto vinculado, centro de custo, contas e observações. Nas notas importadas de XML é só aqui que se altera a nota." FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*,*,2*">
              <StackPanel Classes="campo" IsVisible="{Binding MostraCentro}"><TextBlock Classes="rot" Text="Centro de custo (nota)" /><ComboBox ItemsSource="{Binding Centros}" SelectedItem="{Binding CentroDocumento}" HorizontalAlignment="Stretch" /></StackPanel>
              <StackPanel Grid.Column="1" Classes="campo"><TextBlock Classes="rot" Text="Conta de débito (código; vazio = regra)" /><TextBox Text="{Binding ContaDebito}" /></StackPanel>
              <StackPanel Grid.Column="2" Classes="campo"><TextBlock Classes="rot" Text="Conta de crédito (código; vazio = regra)" /><TextBox Text="{Binding ContaCredito}" /></StackPanel>
              <StackPanel Grid.Column="3" Classes="campo"><TextBlock Classes="rot" Text="Observações" /><TextBox Text="{Binding Observacoes}" AcceptsReturn="True" MaxHeight="60" TextWrapping="Wrap" /></StackPanel>
            </Grid>
            <StackPanel IsVisible="{Binding Importada}" Spacing="3">
              <TextBlock Classes="grupo" Text="Item selecionado (escolha na aba Itens)" />
              <WrapPanel IsVisible="{Binding EhEntrada}" Margin="4,0">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CST/CSOSN de escrituração" /><TextBox Text="{Binding Item.CstIcms}" Width="110" /></StackPanel>
                <CheckBox Content="Credita ICMS" IsChecked="{Binding EscCreditaIcms}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <CheckBox Content="Credita IPI" IsChecked="{Binding EscCreditaIpi}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <CheckBox Content="Credita PIS" IsChecked="{Binding EscCreditaPis}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <CheckBox Content="Credita COFINS" IsChecked="{Binding EscCreditaCofins}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
              </WrapPanel>
              <Grid ColumnDefinitions="*,2*,*,Auto">
                <StackPanel Classes="campo"><TextBlock Classes="rot" Text="CFOP de escrituração (ex.: entrada 1.102)" /><TextBox Text="{Binding Item.Cfop}" /></StackPanel>
                <StackPanel Grid.Column="1" Classes="campo"><TextBlock Classes="rot" Text="Produto vinculado (código, descrição ou GTIN do cadastro)" /><TextBox Text="{Binding EscProduto}" /></StackPanel>
                <StackPanel Grid.Column="2" Classes="campo" IsVisible="{Binding MostraCentro}"><TextBlock Classes="rot" Text="Centro de custo (item)" /><ComboBox ItemsSource="{Binding Centros}" SelectedItem="{Binding CentroItem}" HorizontalAlignment="Stretch" /></StackPanel>
                <Button Grid.Column="3" Classes="mini" Content="Aplicar ao item" Command="{Binding AplicarEscrituracaoItemCommand}" VerticalAlignment="Bottom" Height="26" />
              </Grid>
              <DataGrid Height="170" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Itens}" SelectedItem="{Binding ItemSelecionado, Mode=OneWay}" SelectionChanged="AoSelecionarItem" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Item" Binding="{ReflectionBinding N}" Width="65" />
                  <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" MinWidth="150" />
                  <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding Cfop}" Width="70" />
                  <DataGridTextColumn Header="CFOP escrit." Binding="{ReflectionBinding CfopEscrituracao}" Width="100" />
                  <DataGridTextColumn Header="Produto vinculado" Binding="{ReflectionBinding Vinculo}" Width="200" />
                  <DataGridTextColumn Header="Regra fiscal" Binding="{ReflectionBinding Regra}" Width="100" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="4" Text="{Binding Totais}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6">
      <Button Name="BotaoGravar" Classes="mini accent" Content="Gravar nota" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeEditar}" IsVisible="{Binding MostraGravarNota}" />
      <Button Classes="mini accent" Content="Gravar escrituração" Command="{Binding SalvarEscrituracaoCommand}" IsEnabled="{Binding PodeEditarEscrituracao}" IsVisible="{Binding Importada}" />
      <Button Classes="mini" Content="Cadastrar bens do imobilizado" Command="{Binding CadastrarBensImobilizadoCommand}" IsVisible="{Binding TemItensImobilizado}"
              ToolTip.Tip="Itens com CFOP de ativo imobilizado: cadastra os bens no imobilizado do Contábil" />
      <Button Classes="mini" Content="Fechar (Esc)" Click="Fechar" />
    </StackPanel>
  </Grid>
</UserControl>
