<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.RegrasContabilizacaoView"
             x:DataType="vm:RegrasContabilizacaoViewModel">
  <!-- Cadastros › Regras de contabilização: regras das notas, provisões de impostos e duplicatas e baixas -->
  <TabControl Margin="4">
   <TabItem Header="Regras das notas">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Regras de contabilização das notas fiscais" />
      <TextBlock FontSize="12" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                 Text="Cada regra indica as contas de débito e de crédito para um CFOP (código completo, prefixo como 51 ou 6, ou NFSE para serviços), opcionalmente por cliente/fornecedor; as abas Entradas e Saídas separam o sentido. Vale a regra mais específica (cliente/fornecedor, depois CFOP completo, depois prefixo); no empate, a que estiver primeiro na lista (use Subir e Descer). O valor lançado é o valor contábil dos itens (produtos − desconto + frete + IPI + ICMS-ST)." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Nova" Command="{Binding NovaCommand}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha da regra selecionada (ou dê duplo clique / Enter na lista)" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}" />
        <Button Content="Subir" Command="{Binding SubirCommand}" IsEnabled="{Binding PodeManter}" />
        <Button Content="Descer" Command="{Binding DescerCommand}" IsEnabled="{Binding PodeManter}" />
      </StackPanel>
      <c:MensagensView />
    </StackPanel>
    <TabControl SelectedIndex="{Binding Aba}">
      <TabItem Header="Entradas">
        <DataGrid Name="ListaEntradas" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding RegrasEntrada}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding Cfop}" Width="85" />
            <DataGridTextColumn Header="Participante" Binding="{ReflectionBinding Participante}" Width="170" />
            <DataGridTextColumn Header="Débito" Binding="{ReflectionBinding Debito}" Width="110" />
            <DataGridTextColumn Header="Crédito" Binding="{ReflectionBinding Credito}" Width="110" />
            <DataGridTextColumn Header="Histórico" Binding="{ReflectionBinding Historico}" Width="*" />
            <DataGridTextColumn Header="Ativa" Binding="{ReflectionBinding Ativa}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Saídas">
        <DataGrid Name="ListaSaidas" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding RegrasSaida}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="CFOP" Binding="{ReflectionBinding Cfop}" Width="85" />
            <DataGridTextColumn Header="Participante" Binding="{ReflectionBinding Participante}" Width="170" />
            <DataGridTextColumn Header="Débito" Binding="{ReflectionBinding Debito}" Width="110" />
            <DataGridTextColumn Header="Crédito" Binding="{ReflectionBinding Credito}" Width="110" />
            <DataGridTextColumn Header="Histórico" Binding="{ReflectionBinding Historico}" Width="*" />
            <DataGridTextColumn Header="Ativa" Binding="{ReflectionBinding Ativa}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
   </TabItem>
   <TabItem Header="Provisões de impostos">
     <c:ParametrosView DataContext="{Binding Provisoes}" />
   </TabItem>
   <TabItem Header="Duplicatas e baixas">
     <c:ParametrosView DataContext="{Binding Duplicatas}" />
   </TabItem>
  </TabControl>
</UserControl>
