<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:g="using:Vorticis.Fiscal.Desktop.Views" xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.CodigosAjusteView" x:DataType="vm:CodigosAjusteViewModel">
  <!-- Lançamentos › Ajustes › Códigos de ajuste -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Códigos de ajuste da apuração" />
      <TextBlock FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                 Text="Cadastre os códigos da tabela 5.1.1 da sua UF que a empresa usa (8 posições: UF + 0 para ICMS próprio ou 1 para ICMS-ST + tipo + sequência) e os do IPI (3 posições). Eles aparecem para escolha nas telas de ajustes." />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <Button Content="Novo" Command="{Binding NovoCommand}" />
          <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
          <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
        </StackPanel>
      <c:MensagensView />
    </StackPanel>
    <DataGrid Name="ListaCodigos" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Imposto" Binding="{ReflectionBinding Imposto}" Width="90" />
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="110" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
