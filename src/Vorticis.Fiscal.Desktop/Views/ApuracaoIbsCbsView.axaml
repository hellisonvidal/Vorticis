<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.ApuracaoIbsCbsView"
             x:DataType="vm:ApuracaoIbsCbsViewModel">
  <!-- Apuração › IBS e CBS (reforma tributária) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="IBS e CBS (reforma tributária)" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
        <Button Content="Apurar" Command="{Binding ApurarCommand}" Classes="accent" />
        <Button Name="EncerrarReforma" Content="Encerrar" Command="{Binding EncerrarCommand}" IsEnabled="{Binding PodeEncerrar}"
                ToolTip.Tip="De 2027 em diante: grava os saldos do mês (o credor passa ao mês seguinte)." />
        <CheckBox Content="Contabilizar a compensação" IsChecked="{Binding Contabilizar}" VerticalAlignment="Center"
                  ToolTip.Tip="Lança D IBS/CBS a recolher e C IBS/CBS a recuperar pelo valor compensado (contas em Regras de contabilização › Provisões de impostos)." />
        <Button Content="Reabrir" Command="{Binding ReabrirCommand}" IsEnabled="{Binding PodeReabrir}" />
        <Rectangle Width="1" Fill="{DynamicResource Linha}" Margin="6,4" />
        <c:BarraExportacaoView />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                 Text="Soma o IBS, a CBS e o Imposto Seletivo destacados nos itens das notas (importadas ou digitadas): débitos das saídas menos créditos das entradas (só dos itens que creditam) menos o saldo credor do mês anterior. Em 2026 é informativa; de 2027 em diante pode ser encerrada." />
      <c:MensagensView />
      <TextBlock Text="{Binding AvisosTexto}" Classes="erro" TextWrapping="Wrap" IsVisible="{Binding AvisosTexto, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Exibidas}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
