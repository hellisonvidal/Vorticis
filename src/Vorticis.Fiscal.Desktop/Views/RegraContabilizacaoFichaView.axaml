<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.RegraContabilizacaoFichaView"
             x:DataType="vm:RegrasContabilizacaoViewModel">
  <!-- Ficha da regra de contabilização, aberta em janela pela tela Regras de contabilização -->
  <DockPanel>
    <c:RodapeFichaSimplesView DockPanel.Dock="Bottom" SalvarCommand="{Binding SalvarCommand}" SalvarTexto="Salvar" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="8" Margin="0,0,16,8">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Text="CFOP" VerticalAlignment="Center" />
          <TextBox c:Pesquisa.Fonte="Cfop" Grid.Column="1" Text="{Binding Cfop}" Watermark="5102, 51, NFSE ou vazio" Width="170" />
          <TextBlock Grid.Row="1" Text="Conta débito" VerticalAlignment="Center" />
          <TextBox c:Pesquisa.Fonte="Conta" Grid.Row="1" Grid.Column="1" Text="{Binding Debito}" Watermark="ex.: 1.1.02.001" Width="170" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Conta crédito" VerticalAlignment="Center" />
          <TextBox c:Pesquisa.Fonte="Conta" Grid.Row="1" Grid.Column="3" Text="{Binding Credito}" Watermark="ex.: 3.1.01.001" Width="120" />
          <TextBlock Grid.Row="1" Grid.Column="4" Text="Participante" VerticalAlignment="Center" />
          <TextBox c:Pesquisa.Fonte="Participante" Grid.Row="1" Grid.Column="5" Text="{Binding Participante}" Watermark="código, nome ou CNPJ (opcional)" Width="240" />
          <TextBlock Grid.Row="2" Text="Histórico" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Historico}" />
          <CheckBox Grid.Row="2" Grid.Column="5" Content="Regra ativa" IsChecked="{Binding Ativa}" />
        </Grid>
        <TextBlock FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                     Text="Variáveis do histórico: {DOCUMENTO}, {PARTICIPANTE}, {DATA}, {MES}, {ANO}, {COMPETENCIA}, {VALOR}." />
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
