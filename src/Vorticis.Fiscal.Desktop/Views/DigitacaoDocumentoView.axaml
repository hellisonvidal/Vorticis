<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.DigitacaoDocumentoView"
             x:DataType="vm:DigitacaoDocumentoViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.rot"><Setter Property="FontSize" Value="10.5" /><Setter Property="Foreground" Value="#5A6478" /><Setter Property="Margin" Value="2,0,0,1" /></Style>
    <Style Selector="StackPanel.campo"><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <Style Selector="StackPanel.campo TextBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo ComboBox"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="5,2" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="StackPanel.campo CalendarDatePicker"><Setter Property="MinHeight" Value="26" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.mini"><Setter Property="Padding" Value="8,3" /><Setter Property="FontSize" Value="12" /></Style>
  </UserControl.Styles>
  <!-- Lançamentos › Documentos fiscais › Entrada / Saída: consulta das notas lançadas em tela cheia. A digitação abre num pop-up modal (NotaDigitacaoView). -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="8,4">
    <TextBlock Classes="titulo" Text="{Binding Titulo}" VerticalAlignment="Center" Margin="0,0,0,4" />

    <!-- Filtros -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0">
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Período: de" /><CalendarDatePicker SelectedDate="{Binding FiltroInicio}" Width="130" /></StackPanel>
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="até" /><CalendarDatePicker SelectedDate="{Binding FiltroFim}" Width="130" /></StackPanel>
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="{Binding RotuloParticipante}" />
        <TextBox Text="{Binding FiltroParticipante}" Width="210" Watermark="Nome ou CNPJ/CPF" /></StackPanel>
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Número" /><TextBox Text="{Binding FiltroNumero}" Width="90" /></StackPanel>
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Origem" />
        <ComboBox ItemsSource="{x:Static vm:DigitacaoDocumentoViewModel.OpcoesOrigem}" SelectedIndex="{Binding FiltroOrigem}" Width="140" /></StackPanel>
      <StackPanel Classes="campo"><TextBlock Classes="rot" Text="Situação" />
        <ComboBox ItemsSource="{x:Static vm:DigitacaoDocumentoViewModel.OpcoesSituacao}" SelectedIndex="{Binding FiltroSituacao}" Width="160" /></StackPanel>
      <Button Classes="mini accent" Content="Filtrar" Command="{Binding ConsultarCommand}" VerticalAlignment="Bottom" Height="26" Margin="0,0,6,0" />
      <Button Classes="mini" Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" VerticalAlignment="Bottom" Height="26" />
    </StackPanel>

    <!-- Ações -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,4">
      <Button Classes="mini accent" Content="Novo lançamento" Command="{Binding NovoCommand}" IsEnabled="{Binding PodeManter}" />
      <Button Classes="mini" Content="Editar" Command="{Binding EditarCommand}" />
      <Button Classes="mini" Content="Consultar" Command="{Binding VisualizarCommand}" />
      <Button Classes="mini" Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}" />
      <Button Classes="mini accent" Content="Importar XML ▾" IsEnabled="{Binding Importador.PodeIniciar}"
              ToolTip.Tip="Importa NF-e, NFC-e e NFS-e (arquivo, vários arquivos, pasta com subpastas ou .zip); as notas aparecem na grade abaixo">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Arquivo(s) XML ou .zip..." Click="ImportarArquivos" />
            <MenuItem Header="Pasta (inclui as subpastas)..." Click="ImportarPasta" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <TextBlock Text="Dê dois cliques numa nota (ou Enter) para abri-la." FontSize="11" Foreground="#5A6478" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="3" Spacing="2">
      <g:PainelImportacaoView DataContext="{Binding Importador}" />
      <c:MensagensView DataContext="{Binding Importador}" />
    </StackPanel>

    <DataGrid Name="Grade" Grid.Row="4" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True"
              AutoGenerateColumns="False" CanUserSortColumns="True" DoubleTapped="AoDuploClique" KeyDown="AoTeclarGrade">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="95" />
        <DataGridTextColumn Header="Modelo" Binding="{ReflectionBinding Modelo}" Width="75" />
        <DataGridTextColumn Header="Série" Binding="{ReflectionBinding Serie}" Width="60" />
        <DataGridTextColumn Header="Número" Binding="{ReflectionBinding Numero}" Width="90" />
        <DataGridTextColumn Header="Cliente / fornecedor" Binding="{ReflectionBinding Participante}" Width="*" MinWidth="200" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="115" />
        <DataGridTextColumn Header="ICMS" Binding="{ReflectionBinding Icms}" Width="100" />
        <DataGridTextColumn Header="ISS" Binding="{ReflectionBinding Iss}" Width="90" />
        <DataGridTextColumn Header="Origem" Binding="{ReflectionBinding Origem}" Width="80" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="100" />
        <DataGridTextColumn Header="Contab." Binding="{ReflectionBinding Contabilizado}" Width="75" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="5" Text="{Binding TotaisLista}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
    <c:MensagensView Grid.Row="6" />
  </Grid>
</UserControl>
