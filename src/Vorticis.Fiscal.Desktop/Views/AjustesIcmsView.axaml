<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:g="using:Vorticis.Fiscal.Desktop.Views" xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.AjustesIcmsView" x:DataType="vm:AjustesViewModel">
  <!-- Lançamentos › Ajustes › Ajustes de entrada / Ajustes de saída (E111, E112, E113, E220 e E530) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="{Binding Titulo}" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <c:SeletorCompetencia Competencia="{Binding Competencia}" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" Text="{Binding Orientacao}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo" Command="{Binding NovoCommand}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}" />
      </StackPanel>
      <TextBlock Text="{Binding Totais}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <c:MensagensView />
    </StackPanel>
    <DataGrid Name="ListaAjustes" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Imposto" Binding="{ReflectionBinding Imposto}" Width="80" />
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="100" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="180" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Documento / observação" Binding="{ReflectionBinding Documento}" Width="260" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
