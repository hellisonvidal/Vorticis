<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:g="using:Vorticis.Fiscal.Desktop.Views" xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.AjustesIcmsView" x:DataType="vm:AjustesViewModel">
  <!-- Lançamentos › Ajustes › Ajustes de entrada / Ajustes de saída (E111, E112, E113, E220 e E530) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="titulo" Text="{Binding Titulo}" VerticalAlignment="Center" />
        <TextBlock Text="Competência" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding Competencia}" SelectedDateFormat="Custom" CustomDateFormatString="MM/yyyy" Width="120" />
      </StackPanel>
      <TextBlock FontSize="11" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap" Text="{Binding Orientacao}" />
      <WrapPanel IsEnabled="{Binding PodeManter}">
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Imposto" FontSize="12" />
          <ComboBox ItemsSource="{x:Static vm:AjustesViewModel.Impostos}" SelectedIndex="{Binding Imposto}" Width="110" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Código cadastrado" FontSize="12" />
          <ComboBox ItemsSource="{Binding Codigos}" SelectedItem="{Binding CodigoCadastrado}" Width="230" PlaceholderText="(escolha ou digite ao lado)" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Código do ajuste" FontSize="12" />
          <TextBox Text="{Binding Codigo}" Width="110" MaxLength="8" Watermark="SP020099" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Tipo (pelo código)" FontSize="12" />
          <TextBlock Text="{Binding TipoCodigo}" Width="150" Margin="0,6,0,0" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Descrição" FontSize="12" />
          <TextBox Text="{Binding Descricao}" Width="300" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Valor" FontSize="12" />
          <TextBox Text="{Binding Valor}" Width="110" />
        </StackPanel>
        <StackPanel Margin="0,0,10,6" Spacing="2">
          <TextBlock Text="Observação (E112)" FontSize="12" />
          <TextBox Text="{Binding Observacao}" Width="260" MaxLength="255" />
        </StackPanel>
      </WrapPanel>
      <Expander Header="Documento fiscal relacionado (E113, só ICMS)" IsEnabled="{Binding PodeManter}">
        <WrapPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Cliente ou fornecedor" FontSize="12" /><TextBox Text="{Binding DocParticipante}" Width="250" Watermark="código, nome ou CNPJ" /></StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Modelo" FontSize="12" /><TextBox Text="{Binding DocModelo}" Width="60" MaxLength="2" /></StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Série" FontSize="12" /><TextBox Text="{Binding DocSerie}" Width="60" MaxLength="3" /></StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Número" FontSize="12" /><TextBox Text="{Binding DocNumero}" Width="120" /></StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="Data" FontSize="12" /><CalendarDatePicker SelectedDate="{Binding DocData}" Width="140" /></StackPanel>
        </WrapPanel>
      </Expander>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo" Command="{Binding NovoCommand}" />
        <Button Content="Gravar" Classes="accent" Command="{Binding GravarCommand}" IsEnabled="{Binding PodeManter}" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}" />
      </StackPanel>
      <TextBlock Text="{Binding Totais}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <c:MensagensView />
    </StackPanel>
    <DataGrid g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Imposto" Binding="{ReflectionBinding Imposto}" Width="80" />
        <DataGridTextColumn Header="Código" Binding="{ReflectionBinding Codigo}" Width="100" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="180" />
        <DataGridTextColumn Header="Descrição" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Documento / observação" Binding="{ReflectionBinding Documento}" Width="260" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
