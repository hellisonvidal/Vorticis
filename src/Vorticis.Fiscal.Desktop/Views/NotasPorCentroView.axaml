<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.NotasPorCentroView"
             x:DataType="vm:NotasPorCentroViewModel">
  <!-- Relatórios › Notas por centro de custo -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Notas por centro de custo" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Inicio}" Width="140" />
      <TextBlock Text="a" VerticalAlignment="Center" />
      <CalendarDatePicker SelectedDate="{Binding Fim}" Width="140" />
      <Button Content="Gerar" Command="{Binding GerarCommand}" Classes="accent" />
      <Rectangle Width="1" Fill="{DynamicResource Linha}" Margin="6,4" />
      <c:BarraExportacaoView />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" Margin="0,6,0,0" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Exibidas}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
