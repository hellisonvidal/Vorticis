<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.DctfWebView"
             x:DataType="vm:DctfWebViewModel">
  <!-- Obrigações › DCTFWeb (MIT) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <WrapPanel>
        <WrapPanel.Styles><Style Selector="WrapPanel &gt; :is(Control)"><Setter Property="Margin" Value="0,0,10,6" /></Style></WrapPanel.Styles>
        <TextBlock Classes="titulo" Text="DCTFWeb (MIT)" VerticalAlignment="Center" />
        <TextBlock Text="Ano" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Ano}" Minimum="2000" Maximum="2100" FormatString="0" Width="120" />
        <Button Content="Conferir débitos" Command="{Binding PreverCommand}" IsEnabled="{Binding PodeApurar}" />
        <Button Content="Preparar declaração" Command="{Binding PrepararCommand}" IsEnabled="{Binding PodeApurar}" Classes="accent" />
        <Rectangle Width="1" Fill="{DynamicResource Linha}" Margin="6,4" />
        <c:BarraExportacaoView />
      </WrapPanel>
      <WrapPanel>
        <WrapPanel.Styles><Style Selector="WrapPanel &gt; :is(Control)"><Setter Property="Margin" Value="0,0,10,6" /></Style></WrapPanel.Styles>
        <TextBlock Text="Recibo da transmissão" VerticalAlignment="Center" />
        <TextBox Text="{Binding Recibo}" Width="200" MaxLength="40" />
        <TextBlock Text="Transmitida em" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding DataTransmissao}" Width="140" />
        <Button Content="Registrar transmissão" Command="{Binding RegistrarTransmissaoCommand}" IsEnabled="{Binding PodeApurar}" />
        <Button Content="Desfazer transmissão" Command="{Binding DesfazerTransmissaoCommand}" IsEnabled="{Binding PodeApurar}" />
      </WrapPanel>
      <c:MensagensView />
    </StackPanel>
    <Grid ColumnDefinitions="520,12,*">
      <DataGrid g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Meses}" SelectedItem="{Binding Mes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mês" Binding="{ReflectionBinding Competencia, StringFormat='{}{0:MM/yyyy}'}" Width="80" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding SituacaoTexto}" Width="*" />
          <DataGridTextColumn Header="Total do MIT" Binding="{ReflectionBinding Total, StringFormat='{}{0:N2}'}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
      <ScrollViewer Grid.Column="2">
        <ItemsControl ItemsSource="{Binding Exibidas}" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
