<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.RegrasFiscaisView"
             x:DataType="vm:RegrasFiscaisViewModel">
  <!-- Cadastros › Regras fiscais -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Regras fiscais" />
      <TextBlock FontSize="12" Foreground="{DynamicResource TxSutil}" TextWrapping="Wrap"
                 Text="Entrada: troca o CFOP do fornecedor (5.102, 6.102...) pelo CFOP de entrada da empresa (1.102, 2.102...) ao importar o XML, com CST e créditos. Vale a regra mais específica: produto, depois NCM, depois fornecedor, depois só o CFOP; em empate, a menor ordem. Saída: sugere CFOP e CST na digitação, por produto e destino." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Nova" Command="{Binding NovaCommand}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
        <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeManter}" />
        <Button Content="Gerar regras padrão" Command="{Binding GerarPadraoCommand}" IsEnabled="{Binding PodeManter}"
                ToolTip.Tip="Cria o de-para usual (5 para 1, 6 para 2) sem mexer nas regras que você já cadastrou" />
      </StackPanel>
      <c:MensagensView />
    </StackPanel>
    <DataGrid Name="ListaRegras" g:GradesFiscais.Ajustar="True" ItemsSource="{Binding Regras}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Operacao}" Width="75" />
        <DataGridTextColumn Header="CFOP do emitente" Binding="{ReflectionBinding CfopOrigem}" Width="125" />
        <DataGridTextColumn Header="CFOP a usar" Binding="{ReflectionBinding CfopDestino}" Width="100" />
        <DataGridTextColumn Header="CST" Binding="{ReflectionBinding Cst}" Width="60" />
        <DataGridTextColumn Header="Condições" Binding="{ReflectionBinding Condicoes}" Width="*" MinWidth="200" />
        <DataGridTextColumn Header="Créditos" Binding="{ReflectionBinding Creditos}" Width="190" />
        <DataGridTextColumn Header="Ordem" Binding="{ReflectionBinding Ordem}" Width="70" />
        <DataGridTextColumn Header="Ativa" Binding="{ReflectionBinding Ativa}" Width="60" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
