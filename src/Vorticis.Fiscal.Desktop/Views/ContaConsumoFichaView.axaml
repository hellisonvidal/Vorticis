<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:g="using:Vorticis.Fiscal.Desktop.Views"
             xmlns:vm="using:Vorticis.Fiscal.Desktop.ViewModels"
             x:Class="Vorticis.Fiscal.Desktop.Views.ContaConsumoFichaView"
             x:DataType="vm:ContasConsumoViewModel">
  <!-- Ficha da conta de consumo (energia, gás, água, comunicação), aberta em janela pela tela Contas de consumo -->
  <DockPanel>
    <c:RodapeFichaSimplesView DockPanel.Dock="Bottom" SalvarCommand="{Binding GravarCommand}" SalvarTexto="Gravar" />
    <ScrollViewer Padding="16,10">
      <StackPanel Spacing="8" Margin="0,0,16,8">
        <WrapPanel IsEnabled="{Binding PodeManter}">
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Modelo" FontSize="12" />
            <ComboBox ItemsSource="{x:Static vm:ContasConsumoViewModel.Modelos}" SelectedIndex="{Binding Modelo}" Width="330" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Fornecedor (concessionária/operadora)" FontSize="12" />
            <ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding Fornecedor}" Width="300" PlaceholderText="Cadastre em Cadastros › Fornecedores" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Número" FontSize="12" />
            <TextBox Text="{Binding Numero}" Width="110" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Série" FontSize="12" />
            <TextBox Text="{Binding Serie}" Width="60" MaxLength="4" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Emissão" FontSize="12" />
            <CalendarDatePicker SelectedDate="{Binding Emissao}" Width="140" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Entrada" FontSize="12" />
            <CalendarDatePicker SelectedDate="{Binding DataEntrada}" Width="140" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Classe de consumo" FontSize="12" />
            <TextBox Text="{Binding Classe}" Width="70" MaxLength="2" ToolTip.Tip="01 comercial, 04 industrial, 06 residencial... (energia e gás)" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Valor da nota" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Valor}" Width="110" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="CFOP" FontSize="12" />
            <TextBox c:Pesquisa.Fonte="Cfop" Text="{Binding Cfop}" Width="70" MaxLength="4" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="CST ICMS" FontSize="12" />
            <TextBox Text="{Binding Cst}" Width="70" MaxLength="3" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Base do ICMS" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding BaseIcms}" Width="110" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="Alíquota (%)" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Aliquota}" Width="80" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="ICMS" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Icms}" Width="100" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="PIS" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Pis}" Width="90" />
          </StackPanel>
          <StackPanel Margin="0,0,10,6" Spacing="2">
            <TextBlock Text="COFINS" FontSize="12" />
            <TextBox c:Mascara.Tipo="Valor" Text="{Binding Cofins}" Width="90" />
          </StackPanel>
        </WrapPanel>
        <c:MensagensView />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
