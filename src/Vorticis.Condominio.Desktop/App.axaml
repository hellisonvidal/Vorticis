<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vorticis.Condominio.Desktop.App"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             xmlns:v="using:Vorticis.Condominio.Desktop.Views"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <c:TemplatesComuns />
    <DataTemplate DataType="vm:UnidadesViewModel"><v:UnidadesView /></DataTemplate>
    <DataTemplate DataType="vm:TaxasViewModel"><v:TaxasView /></DataTemplate>
    <DataTemplate DataType="vm:CobrancasViewModel"><v:CobrancasView /></DataTemplate>
    <DataTemplate DataType="vm:DespesasViewModel"><v:DespesasView /></DataTemplate>
    <DataTemplate DataType="vm:ReservasViewModel"><v:ReservasView /></DataTemplate>
    <DataTemplate DataType="vm:OcorrenciasViewModel"><v:OcorrenciasView /></DataTemplate>
    <DataTemplate DataType="vm:PrestacaoViewModel"><v:PrestacaoView /></DataTemplate>
    <DataTemplate DataType="vm:RateioViewModel"><v:RateioView /></DataTemplate>
    <DataTemplate DataType="vm:AtasAssembleiaViewModel"><v:AtasAssembleiaView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <StyleInclude Source="avares://Vorticis.Desktop.Comum/Estilos.axaml" />
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridCell.numerica">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </Application.Styles>
</Application>
