<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             x:Class="Vorticis.Condominio.Desktop.Views.AtasAssembleiaView" x:DataType="vm:AtasAssembleiaViewModel">
  <!-- Relatórios › Atas de Assembleia -->
  <!-- A tela mostra a lista; a ficha abre numa janela por cima (botões Nova/Novo, Abrir ficha, duplo clique ou Enter) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Atas de Assembleia" Margin="0,0,0,8" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Nova" Command="{Binding NovaCommand}" />
    <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
      <Button Content="Excluir" Command="{Binding ExcluirCommand}" />
    </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Top" Margin="0,0,0,8">
      <CheckBox Content="Incluir lista de presença (para assinatura dos condôminos)" IsChecked="{Binding ListaPresenca}" />
      <Button Content="Gerar ata (PDF)" Classes="accent" Command="{Binding GerarAtaCommand}" />
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaAtas" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nº" Binding="{ReflectionBinding Numero}" Width="50" />
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="95" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="120" />
        <DataGridTextColumn Header="Local" Binding="{ReflectionBinding Local}" Width="*" />
        <DataGridTextColumn Header="Presentes" Binding="{ReflectionBinding Presentes}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
