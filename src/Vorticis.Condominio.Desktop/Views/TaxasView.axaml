<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             x:Class="Vorticis.Condominio.Desktop.Views.TaxasView" x:DataType="vm:TaxasViewModel">
  <!-- A tela mostra a lista; a ficha abre numa janela por cima (botões Nova/Novo, Abrir ficha, duplo clique ou Enter) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="titulo" Text="Taxas condominiais" Margin="0,0,0,8" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Nova taxa" Command="{Binding NovaCommand}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaTaxas" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Taxa" Binding="{ReflectionBinding Descricao}" Width="*" />
        <DataGridTextColumn Header="Rateio" Binding="{ReflectionBinding Rateio}" Width="170" />
        <DataGridTextColumn Header="Valor" Binding="{ReflectionBinding Valor}" Width="120" />
        <DataGridTextColumn Header="Vigência" Binding="{ReflectionBinding Vigencia}" Width="160" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
