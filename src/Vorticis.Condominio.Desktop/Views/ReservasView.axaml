<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             x:Class="Vorticis.Condominio.Desktop.Views.ReservasView" x:DataType="vm:ReservasViewModel">
  <!-- Áreas comuns à esquerda e reservas à direita; as fichas (área e reserva) abrem numa janela por cima -->
  <Grid ColumnDefinitions="300,12,*" Margin="8">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Áreas comuns" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Button Content="Nova área" Command="{Binding NovaAreaCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirAreaCommand}" ToolTip.Tip="Mostra a ficha da área selecionada (ou dê duplo clique na lista)" />
      </StackPanel>
      <ListBox Name="ListaAreas" ItemsSource="{Binding Areas}" SelectedItem="{Binding AreaSelecionada}">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{ReflectionBinding Nome}" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Reservas (área selecionada à esquerda)" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
        <Button Content="Nova reserva" Command="{Binding NovaReservaCommand}" IsEnabled="{Binding PodeEditar}" />
        <Button Content="Cancelar reserva" Command="{Binding CancelarReservaCommand}" IsEnabled="{Binding PodeEditar}" />
      </StackPanel>
      <c:MensagensView DockPanel.Dock="Bottom" />
      <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding ReservaSelecionada}" IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="140" />
          <DataGridTextColumn Header="Área" Binding="{ReflectionBinding Area}" Width="*" />
          <DataGridTextColumn Header="Unidade" Binding="{ReflectionBinding Unidade}" Width="90" />
          <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="100" />
          <DataGridTextColumn Header="Observação" Binding="{ReflectionBinding Observacao}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
