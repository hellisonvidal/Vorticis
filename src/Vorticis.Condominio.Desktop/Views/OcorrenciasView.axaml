<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views" xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             x:Class="Vorticis.Condominio.Desktop.Views.OcorrenciasView" x:DataType="vm:OcorrenciasViewModel">
  <!-- A tela mostra a lista; a ficha abre numa janela por cima (botões Nova/Novo, Abrir ficha, duplo clique ou Enter) -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <TextBlock Classes="titulo" Text="Ocorrências e assembleias" VerticalAlignment="Center" />
        <CheckBox Content="Só as abertas" IsChecked="{Binding SomenteAbertas}" />
      </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Nova" Command="{Binding NovaCommand}" />
        <Button Name="AbrirFicha" Content="Abrir ficha" Command="{Binding AbrirFichaCommand}" ToolTip.Tip="Mostra a ficha do item selecionado (ou dê duplo clique / Enter na lista)" />
    </StackPanel>
    </StackPanel>
    <c:MensagensView DockPanel.Dock="Bottom" />
    <DataGrid Name="ListaOcorrencias" ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionada}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Data" Binding="{ReflectionBinding Data}" Width="95" />
        <DataGridTextColumn Header="Tipo" Binding="{ReflectionBinding Tipo}" Width="110" />
        <DataGridTextColumn Header="Unidade" Binding="{ReflectionBinding Unidade}" Width="80" />
        <DataGridTextColumn Header="Título" Binding="{ReflectionBinding Titulo}" Width="*" />
        <DataGridTextColumn Header="Situação" Binding="{ReflectionBinding Situacao}" Width="150" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
