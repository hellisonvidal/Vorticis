<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vorticis.Desktop.Comum.Views"
             xmlns:vm="using:Vorticis.Condominio.Desktop.ViewModels"
             x:Class="Vorticis.Condominio.Desktop.Views.OcorrenciaFichaView"
             x:DataType="vm:OcorrenciasViewModel">
  <!-- Ficha da ocorrência, aberta em janela pela tela Ocorrências e assembleias -->
  <DockPanel>
    <c:RodapeFichaSimplesView DockPanel.Dock="Bottom" SalvarCommand="{Binding GravarCommand}" SalvarTexto="Gravar" />
    <ScrollViewer Padding="16,10">
      <Border Margin="0,0,16,8">
        <StackPanel Spacing="6" IsEnabled="{Binding PodeEditar}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CalendarDatePicker SelectedDate="{Binding Data}" Width="150" />
            <ComboBox ItemsSource="{x:Static vm:OcorrenciasViewModel.Tipos}" SelectedItem="{Binding Tipo}" Width="160" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding UnidadesOpcoes}" SelectedItem="{Binding Unidade}" HorizontalAlignment="Stretch" PlaceholderText="Unidade (opcional)" />
          <TextBox Text="{Binding Titulo}" Watermark="Título" />
          <TextBox Text="{Binding Descricao}" Watermark="Descrição, providências, pauta ou ata" AcceptsReturn="True" Height="120" TextWrapping="Wrap" />
          <CheckBox Content="Resolvida / encerrada" IsChecked="{Binding Resolvida}" />
          <c:MensagensView />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
